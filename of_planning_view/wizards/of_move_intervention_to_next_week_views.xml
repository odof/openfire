<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_move_intervention_to_next_week_wizard_form_view" model="ir.ui.view">
        <field name="name">of.move.intervention.to.next.week.wizard.form.view</field>
        <field name="model">of.move.intervention.to.next.week.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <h1>Move interventions to next week</h1>
                </header>
                <group>
                    <field name="intervention_count" readonly="1"/>
                </group>
                <footer>
                    <button string="Validate" name="action_button_validate" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="of_move_intervention_to_next_week_wizard_action" model="ir.actions.act_window">
        <field name="name">Move to next week</field>
        <field name="res_model">of.move.intervention.to.next.week.wizard</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="of_move_intervention_to_next_week_wizard_form_view"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="calendar.model_calendar_event" />
        <field name="binding_view_types">list</field>
    </record>

</odoo>
