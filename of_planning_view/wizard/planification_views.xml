<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_of_planif_wizard" model="ir.ui.view">
        <field name="name">Planifier une intervention</field>
        <field name="model">of.planif.creneau</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Planifier une intervention depuis un créneau">
                <script>
                    $(document).ready(function(){
                        // élargir le pop-up
                        $(".modal-dialog").width('80%');
                    });
                </script><!-- -->
                <group colspan="2" col="8" name="invisblez" style="display: none">
                    <field name="creneau_fini" invisible="1"/>
                    <field name="aucun_res" invisible="1"/>
                    <field name="heure_debut_creneau" widget="float_time" invisible="1"/>
                    <field name="heure_fin_creneau" widget="float_time" invisible="1"/>
                    <field name="creneaux_reels" invisible="1"/>
                    <field name="priorite_max" invisible="1"/>
                    <field name="duree_creneau" widget="float_time" invisible="1"/>
                    <field name="lieu_prec_id" invisible="1"/>
                    <field name="lieu_suiv_id" invisible="1"/>
                    <field name="geo_lat_prec" invisible="1"/>
                    <field name="geo_lat_suiv" invisible="1"/>
                    <field name="warning_horaires" invisible="1"/>
                </group>
                <group col="1" colspan="2" attrs="{'invisible': [('creneau_fini', '=', False)]}">
                    <div>Félicitation! Ce créneau est entièrement planifié! \o/</div>
                </group>
                <group attrs="{'invisible': [('creneau_fini', '=', True)]}" col="6" colspan="2">
                    <group col="2" colspan="2">
                        <separator string="Créneau" colspan="2"/>
                        <field name="employee_id" widget="many2one" options="{'force_link': True}"/>
                        <field name="date_creneau"/>
                        <field name="creneaux_reels_formatted"/>

                        <field name="duree_creneau_readonly" widget="float_time"/>
                        <field name="lieu_prec_readonly_id"/>
                        <field name="lieu_suiv_readonly_id"/>
                        <i attrs="{'invisible': [('warning_horaires', '=', False)]}" class="oe_grey" colspan="2">
                            <i class="fa fa-warning"/>
                            Au moins une intervention de cette journée a ses horaires forcés.<br/>
                            <t/>Par conséquent, les données de ce créneau sont peut-être erronées.
                        </i>
                    </group>
                    <group col="2" colspan="2"><!--  widget="localizable" options="{'geo_lat_field': 'geo_lat_prec'}" widget="localizable" options="{'geo_lat_field': 'geo_lat_suiv'}" -->
                        <separator string="Recherche" colspan="2"/>
                        <group col="2" colspan="2" attrs="{'invisible': [('pre_a_programmer_id', '!=', False)]}">
                            <field name="distance_max"/>
                            <field name="secteur_id" widget="selection"/>
                            <field name="ignorer_duree"/>
                            <field name="pre_tache_categ_ids" widget="many2many_tags"/>
                            <field name="pre_tache_ids" widget="many2many_tags"/>
                        </group>
                        <group col="2" colspan="2">
                            <field name="pre_a_programmer_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group col="2" colspan="2" attrs="{'invisible': [('pre_a_programmer_id', '=', False)]}">
                            <field name="pre_a_programmer_address_id"/>
                            <field name="pre_a_programmer_zip"/>
                            <field name="pre_a_programmer_city"/>
                            <field name="pre_a_programmer_telephones"/>
                        </group>
                    </group>
                    <group col="2" colspan="2">
                        <group col="2" colspan="2">
                            <separator string="Intervention à créer" colspan="2"/>
                            <field name="heure_debut_rdv" widget="float_time"/>
                            <field name="duree_rdv" widget="float_time"/>
                            <field name="employee_other_ids" widget="many2many_tags"/>
                        </group>
                        <group col="2" colspan="2" attrs="{'invisible': ['|', ('aucun_res', '=', False), ('pre_a_programmer_id', '!=', False)]}">
                            <separator string="Aucun résultat" colspan="2"/>
                            <div colspan="2" style="color: red">
                                <i>
                                    Aucun service à programmer correspondant à vos critères de recherche n'a été trouvé...
                                </i>
                            </div>
                        </group>
                    </group>
                    <field name="proposition_ids" mode="tree" nolabel="1" colspan="6"
                           attrs="{'invisible': ['|',('proposition_ids', '=', []),('pre_a_programmer_id', '!=', False)]}">
                        <tree limit="5" colors="blue: selected==True;" create="0">
                            <field name="service_id" invisible="1"/>
                            <field name="dummy_field" invisible="1"/>
                            <field name="priorite" invisible="1"/>
                            <field name="selected" invisible="1"/>
                            <field name="id" invisible="1"/>
                            <field name="tache_name"/>
                            <field name="partner_name"/>
                            <field name="address_city"/>
                            <field name="address_zip"/>
                            <field name="partner_of_telephones"/>
                            <field name="distance_dwazo_prec" invisible="1"/>
                            <field name="distance_dwazo_suiv" invisible="1"/>
                            <field name="distance_reelle_prec" invisible="1"/>
                            <field name="distance_reelle_suiv" invisible="1"/>
                            <field name="distance_reelle_tota"/>
                            <field name="distance_order" invisible="1"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="button_dummy" string="Rechercher" type="object" colspan="4" class="btn-primary"
                            attrs="{'invisible': [('pre_a_programmer_id', '!=', False)]}"/>
                    <button name="button_confirm" string="Confirmer &amp; Fermer" type="object" colspan="4"
                            class="btn-primary" attrs="{'invisible': [('proposition_ids', '=', []), ('pre_a_programmer_id', '=', False)]}"/>
                    <button name="button_confirm_next" string="Confirmer &amp; Suivant" type="object" colspan="4"
                            class="btn-primary" attrs="{'invisible': [('proposition_ids', '=', [])]}"/>
                    <button name="button_close" string="Fermer" type="object" colspan="4" class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_of_planif_intervention_form" model="ir.ui.view">
        <field name="name">Planifier une intervention</field>
        <field name="model">of.planif.intervention</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <script>
                    $(document).ready(function(){
                        // Cacher les boutons "Sauvegarder" et "Annuler"
                        var len = $(".modal-footer").length;
                        $(".modal-footer").eq(len-1).hide();
                    });
                </script>
                <group>
                    <group>
                        <field name="service_id" readonly="1"/>
                        <field name="duree_restante" readonly="1" widget="float_time"/>
                        <field name="date_next" readonly="1"/>
                        <field name="date_fin" readonly="1"/>
                        <field name="distance_reelle_prec" readonly="1"/>
                        <field name="distance_reelle_suiv" readonly="1"/>
                        <field name="distance_reelle_tota" readonly="1"/>
                    </group>
                    <group>
                        <field name="partner_name" readonly="1"/>
                        <field name="address_name" readonly="1"
                               attrs="{'invisible': ['|', ('address_name', '=', '_field_partner_name'), ('address_name', '=', False)]}"/>
                        <field name="partner_of_telephones" readonly="1" attrs="{'invisible': [('partner_of_telephones', '=', False)]}"/>
                        <div class="o_address_format" colspan="2">
                            <field name="address_street" class="o_address_street"/>
                            <field name="address_street2" class="o_address_street"/>
                            <field name="address_city" class="o_address_city"/>
                            <field name="address_state_id" class="o_address_state" options='{"no_open": True}' context="{'country_id': country_id, 'zip': zip}"/>
                            <field name="address_zip" class="o_address_zip"/>
                            <field name="address_country_id" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                        </div>
                    </group>
                    <group attrs="{'invisible':[('selected','!=',True)]}" colspan="2" col="2">
                        <field name="selected" invisible="1" readonly="1"/>
                        <field name="heure_debut_rdv" widget="float_time"/>
                        <field name="duree_rdv" widget="float_time"/>
                    </group>
                    <label for="description_rdv" colspan="2" attrs="{'invisible':[('selected','!=',True)]}"/>
                    <field name="description_rdv" nolabel="1" colspan="2" widget="html" attrs="{'invisible':[('selected','!=',True)]}"/>
                </group>
                <footer>
                    <button name="button_select" string="Sélectionner cette intervention à programmer" type="object" colspan="4" class="btn-primary"
                        attrs="{'invisible': [('selected','!=',False)]}"/>
                    <button name="button_confirm" string="Confirmer le RDV" type="object" colspan="4" class="btn-primary"
                        attrs="{'invisible': [('selected','!=',True)]}"/>
                </footer>
            </form>
        </field>
    </record>

    <act_window
        name="Remplir un créneau"
        res_model="of.planif.creneau"
        src_model="of.planning.intervention"
        view_mode="form"
        view_id="view_of_planif_wizard"
        id="action_view_of_planif_wizard"
        target="new"
        groups="of_planning.of_group_planning_intervention_modification_siens"
    />

    <record id="view_of_planif_creneau_secteur_wizard" model="ir.ui.view">
        <field name="name">Assigner un secteur</field>
        <field name="model">of.planif.creneau.secteur</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Planifier une intervention">
                <group>
                    <group>
                        <field name="date_creneau"/>
                        <field name="employee_id"/>
                        <field name="secteur_id"/>
                    </group>
                </group>
                <footer>
                    <button name="button_confirm" string="Confirmer" type="object" colspan="4" class="btn-primary"/>
                    <button string="Annuler" class="oe_link" colspan="4" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <act_window
        name="Assigner un secteur"
        res_model="of.planif.creneau.secteur"
        src_model="of.planning.intervention"
        view_mode="form"
        view_id="view_of_planif_creneau_secteur_wizard"
        id="action_view_of_planif_creneau_secteur_wizard"
        target="new"
        groups="of_planning.of_group_planning_intervention_modification_siens"
    />

</odoo>