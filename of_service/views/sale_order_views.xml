<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_button_schedule_intervention" string="Service Request" type="object"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_button_view_request" type="object" icon="fa-wrench">
                    <field string="Service Request" name="of_request_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
