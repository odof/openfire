<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_service_request_stage_view_form" model="ir.ui.view">
        <field name="name">of.service.request.stage.view.form</field>
        <field name="model">of.service.request.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="type_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_service_request_stage_view_tree" model="ir.ui.view">
        <field name="name">of.service.request.stage.view.tree</field>
        <field name="model">of.service.request.stage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_of_service_request_stage" model="ir.actions.act_window">
        <field name="name">Service Request Stage</field>
        <field name="res_model">of.service.request.stage</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="of_service_request_stage_view_tree"/>
    </record>

</odoo>
