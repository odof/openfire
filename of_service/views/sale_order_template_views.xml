<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_template_view_form" model="ir.ui.view">
        <field name="name">sale.order.template.view.form</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info']" position="after">
                <group name="service_mgmt">
                    <field name="of_service_mgmt"/>
                    <field name="of_intervention_template_id" attrs="{'invisible': [('of_service_mgmt', '!=', 'sale')], 'required': [('of_service_mgmt', '=', 'sale')]}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
