<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_service_request_create_intervention_wizard_view_form" model="ir.ui.view">
        <field name="name">of.service.request.create.intervention.wizard.view.form</field>
        <field name="model">of.service.request.create.intervention.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="employee_id" required="1" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="start_date" required="1"/>
                    </group>
                </group>
                <field name="show_warning" invisible="1"/>
                <group attrs="{'invisible': [('show_warning', '=', False)]}">
                    <p class="text-warning">Please note that the selected operator is not fully available on the chosen date, the dates of new interventions will be forced.</p>
                </group>
                <notebook>
                    <page string="Service Requests">
                        <field name="line_ids" nolabel="1" mode="tree">
                            <tree create="false" delete="false" editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="request_number" readonly="1"/>
                                <field name="request_title" readonly="1"/>
                                <field name="request_partner_id" readonly="1" options="{'no_open': True}"/>
                                <field name="request_address_zip" readonly="1"/>
                                <field name="request_address_city" readonly="1"/>
                                <field name="request_task_id" readonly="1" options="{'no_open': True}"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Create intervention" name="action_button_create_intervention" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
