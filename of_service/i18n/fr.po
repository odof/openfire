#. module: of_service
#: model:mail.template,body_html:of_service.email_template_of_service_request
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"Hello <t t-out=\"object.partner_id.name or ''\">user</t>,\n"
"<br>\n"
"<br>\n"
"Please find attached the intervention request\n"
"<t t-if=\"object.number\">\n"
"    (with reference: <t t-out=\"object.number or ''\">DI/12345</t> )\n"
"</t>\n"
"to be scheduled between  <span style=\"font-weight:bold;\" t-out=\"format_date(object.next_date) or ''\">06/02/2024</span> and  <span style=\"font-weight:bold;\" t-out=\"format_date(object.end_date) or ''\">06/02/2024</span>.\n"
"<br>\n"
"If you have any questions, please do not hesitate to contact us.\n"
"<br>\n"
"<br>\n"
"Sincerely,\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"Bonjour <t t-out=\"object.partner_id.name or ''\">utilisateur</t>,\n"
"<br>\n"
"<br>\n"
"Veuillez trouver ci-joint la demande d'intervention\n"
"<t t-if=\"object.number\">\n"
"    (avec la référence : <t t-out=\"object.number or ''\">DI/12345</t> )\n"
"</t>\n"
"à programmer entre le  <span style=\"font-weight:bold;\" t-out=\"format_date(object.next_date) or ''\">06/02/2024</span> et le  <span style=\"font-weight:bold;\" t-out=\"format_date(object.end_date) or ''\">06/02/2024</span>.\n"
"<br>\n"
"Si vous avez des questions, n'hésitez pas à nous contacter.\n"
"<br>\n"
"<br>\n"
"Bien cordialement,\n"
"                </p>\n"
"            </div>\n"
"        "

