<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_equipment_view_form" model="ir.ui.view">
        <field name="name">of.equipment.view.form</field>
        <field name="model">of.equipment</field>
        <field name="inherit_id" ref="of_equipment.of_equipment_view_form"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='technical']//group[@name='technical_data']" position="inside">
                <field name="has_technical_attributes" invisible="1"/>
                <field name="industry_id" invisible="1"/>
                <field name="industry_code" invisible="1"/>
                <group name="technical" string="Technical"
                    attrs="{'invisible': [('has_technical_attributes', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
