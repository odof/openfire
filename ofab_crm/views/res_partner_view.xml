<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_res_partner_form_view" model="ir.ui.view">
        <field name="name">ofab.crm.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div class="o_address_format" position="after">
                <field name="company_type" invisible="1"/>
                <field name="of_brand_distributor_ids" widget="many2many_tags" attrs="{'invisible': [('company_type', '=', 'person')]}"/>
            </div>
        </field>
    </record>

    <record id="of_view_res_partner_filter" model="ir.ui.view">
        <field name="name">ofab.crm.res.partner.select</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="company_type" invisible="1"/>
                <field name="of_brand_distributor_ids" widget="many2one" attrs="{'invisible': [('company_type', '=', 'person')]}"/>
            </xpath>
            <group name="group_by" position="inside">
                <filter name="tag" string="Distributed brand" context="{'group_by' : 'of_brand_distributor_ids'}"/>
            </group>
        </field>
    </record>

</odoo>
