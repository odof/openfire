<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_crm_project_template_view_form" model="ir.ui.view">
        <field name="name">of.crm.project.template.form</field>
        <field name="model">of.crm.project.template</field>
        <field name="arch" type="xml">
            <form string="Project template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}" />
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group colspan="2">
                            <field name="attr_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_crm_project_template_view_tree" model="ir.ui.view">
        <field name="name">of.crm.project.template.tree</field>
        <field name="model">of.crm.project.template</field>
        <field name="arch" type="xml">
            <tree string="Project templates" decoration-muted="not active">
                <field name="name"/>
                <field name="attr_ids" widget="many2many_tags"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="of_crm_project_template_view_filter" model="ir.ui.view">
        <field name="name">of.crm.project.template.search</field>
        <field name="model">of.crm.project.template</field>
        <field name="arch" type="xml">
            <search string="Project attribute values">
                <field name="name" string="Project template" filter_domain="[('name','ilike',self)]"/>
                <field name="attr_ids" string="Attributes" filter_domain="[('attr_ids', 'ilike', self)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="of_crm_project_template_action" model="ir.actions.act_window">
        <field name="name">Project templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">of.crm.project.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to define a new project template.
            </p>
        </field>
    </record>

</odoo>
