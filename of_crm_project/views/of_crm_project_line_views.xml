<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_crm_project_line_view_form" model="ir.ui.view">
        <field name="name">of.crm.project.line.form</field>
        <field name="model">of.crm.project.line</field>
        <field name="arch" type="xml">
            <form string="Project entry">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="val_bool" attrs="{'invisible': [('type','!=','bool')]}"/>
                            <field name="val_date" attrs="{'invisible': [('type','!=','date')]}"/>
                            <field name="val_char" attrs="{'invisible': [('type','!=','char')]}"/>
                            <field name="val_text" attrs="{'invisible': [('type','!=','text')]}"/>
                            <field name="val_select_id" widget="selection" attrs="{'invisible': [('type','!=','selection')]}" domain="[('attr_id','=',attr_id)]"/>
                            <field name="answer_date" readonly="1"/>
                            <field name="answer_user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="answer_orig" readonly="1"/>
                            <field name="answer_orig_date" readonly="1"/>
                            <field name="answer_orig_user_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="lead_id" invisible="1"/>
                    <field name="attr_id" invisible="1"/>
                    <field name="sequence" invisible="1"/>
                    <field name="type" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_crm_project_line_view_tree" model="ir.ui.view">
        <field name="name">of.crm.project.line.tree</field>
        <field name="model">of.crm.project.line</field>
        <field name="arch" type="xml">
            <tree string="Project entries" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="attr_id" widget="selection"/>
                <field name="name"/>
                <field name="type" readonly="1"/>
                <field name="val_bool" attrs="{'invisible': [('type','!=','bool')]}"/>
                <field name="val_date" attrs="{'invisible': [('type','!=','date')]}"/>
                <field name="val_char" attrs="{'invisible': [('type','!=','char')]}"/>
                <field name="val_text" attrs="{'invisible': [('type','!=','text')]}"/>
                <field name="val_select_id" widget="selection" attrs="{'invisible': [('type','!=','selection')]}"/>
            </tree>
        </field>
    </record>

    <record id="of_crm_project_line_view_kanban" model="ir.ui.view">
        <field name="name">of.crm.project.line.kanban</field>
        <field name="model">of.crm.project.line</field>
        <field name="arch" type="xml">
            <kanban create="0">
                <field name="sequence"/>
                <field name="attr_id"/>
                <field name="name"/>
                <field name="type"/>
                <field name="val_bool"/>
                <field name="val_date"/>
                <field name="val_char"/>
                <field name="val_text"/>
                <field name="val_select_id"/>
                <field name="is_answered"/>
                <templates>
                    <t t-name="kanban-box">
                        <div style="border: 1px solid lightgrey; border-radius: 4px;">
                            <a t-if="!read_only_mode" type="delete" groups="sales_team.group_sale_manager" class="fa fa-times pull-right"/>
                            <div class="oe_kanban_details">
                                <span style="padding-right: 8px; border-right: 1px solid lightgrey;">
                                    <field name="name"/>
                                </span>
                                <strong style="padding-left: 8px; border-left: 1px solid lightgrey;">
                                    <t t-if="record.type.raw_value == 'bool'">
                                        <field name="val_bool" widget="of_kanban_bool"/>
                                    </t>
                                    <t t-if="record.type.raw_value == 'char'">
                                        <field name="val_char" widget="of_kanban_char"/>
                                    </t>
                                    <t t-if="record.type.raw_value == 'date'">
                                        <field name="val_date" widget="of_kanban_date"/>
                                    </t>
                                    <t t-if="record.type.raw_value == 'selection'">
                                        <field name="val_select_id" widget="of_kanban_selection" domain="[('attr_id','=',attr_id)]"/>
                                    </t>
                                </strong>
                                <strong>
                                    <t t-if="record.type.raw_value == 'text'">
                                        <field name="val_text" widget="of_kanban_text"/>
                                    </t>
                                </strong>
                                <a name="action_button_edit_answer" type="object" class="fa fa-pencil" t-if="record.is_answered.value &amp;&amp; !read_only_mode"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_of_crm_project_line_pivot" model="ir.ui.view">
        <field name="name">of.crm.project.line.pivot</field>
        <field name="model">of.crm.project.line</field>
        <field name="arch" type="xml">
            <pivot string="Project lines" disable_linking="True">
                <field name="answer_user_id" type="row"/>
                <field name="is_answered" type="col"/>
            </pivot>
        </field>
    </record>


    <record id="action_of_crm_project_line_form" model="ir.actions.act_window">
        <field name="name">Project lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">of.crm.project.line</field>
        <field name="view_mode">form</field>
    </record>

    <record id="action_of_crm_project_line_pivot" model="ir.actions.act_window">
        <field name="name">CRM project lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">of.crm.project.line</field>
        <field name="view_mode">pivot,form</field>
    </record>

</odoo>
