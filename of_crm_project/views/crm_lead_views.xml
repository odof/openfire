<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_crm_project_crm_lead_view_form" model="ir.ui.view">
        <field name="name">of.crm.project.crm.lead.form.view</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- "Notebook" part -->
            <xpath expr="//notebook" position="inside">
                <page string="Partner" colspan="2">
                    <group>
                        <group string="Customer" name="customer">
                            <field name="of_interlocutor"/>
                            <field name="of_decision_maker"/>
                        </group>
                        <group string="Externals" name="externals">
                            <field name="of_architect"/>
                            <field name="of_labor_force"/>
                            <field name="of_prime_contractor"/>
                            <field name="of_engineering_office"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="project" string="Project">
                    <field name="of_survey_user_input_line" invisible="1"/>
                    <group>
                        <group>
                            <field name="of_survey_id" domain="[('survey_type','=','lead_opportunity')]"/>
                        </group>
                        <group attrs="{'invisible': [('of_survey_id','=',False)]}">
                            <button class="btn btn-primary" name="action_button_open_survey" type="object" string="Reply"/>
                            <button class="btn btn-secondary" name="action_button_edit_survey" type="object" string="Edit" attrs="{'invisible': [('of_survey_user_input_line','=',[])]}"/>
                        </group>
                    </group>

                    <field name="of_answers_ids">
                        <tree create="false" edit="false" delete="false" decoration-info="is_page">
                            <field name="question_id"/>
                            <field name="answers"/>
                            <field name="is_page" invisible="1"/>
                        </tree>
                        <form>
                            <group>
                                <field name="question_id" readonly="1"/>
                                <field name="answers" readonly="1"/>
                                <field name="question_type" invisible="1"/>
                                <field name="image_ids" mode="kanban" attrs="{'invisible': [('image_ids','=',[])]}"/>
                                <field name="form_filename" invisible="1"/>
                                <field name="form" attrs="{'invisible': [('form','=',False)]}" filename="form_filename"/>
                            </group>
                        </form>
                    </field>

                    <group>
                        <field name="of_survey_user_input" invisible="1"/>
                    </group>
                </page>
            </xpath>
            <!-- /"Notebook" part -->
        </field>
    </record>

    <record id="of_crm_lead_view_form" model="ir.ui.view">
        <field name="name">of.crm.project.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="of_crm.of_crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='opportunity_followup']//label[@for='date_deadline']" position="before">
                <field name="of_date_project"/>
            </xpath>
        </field>
    </record>

    <record id="of_survey_survey_view_search_crm" model="ir.ui.view">
        <field name="name">survey.view.survey.search.crm</field>
        <field name="model">of.survey.survey</field>
        <field name="inherit_id" ref="of_survey.of_survey_survey_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter string="Type Lead/Opportunity" name="opportunity" domain="[('survey_type', '=', 'lead_opportunity')]"/>
            </xpath>
        </field>
    </record>

    <!-- Search view used only from CRM config menu -->
    <record id="of_survey_survey_view_search_crm_project" model="ir.ui.view">
        <field name="name">of.survey.survey.search.crm.project</field>
        <field name="model">of.survey.survey</field>
        <field name="inherit_id" ref="of_survey.of_survey_survey_view_search_base"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//search" position="attributes">
                <attribute name="string">Survey</attribute>
            </xpath>
            <xpath expr="//filter[@name='inactive']" position="after">
                <filter string="Type Lead/Opportunity" name="opportunity" domain="[('survey_type', '=', 'lead_opportunity')]"/>
            </xpath>
        </field>
    </record>

    <record id="of_action_survey_form" model="ir.actions.act_window">
        <field name="name">Surveys</field>
        <field name="res_model">of.survey.survey</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('survey_type','=','lead_opportunity')]</field>
        <field name="context">{'default_survey_type': 'lead_opportunity'}</field>
        <field name="search_view_id" ref="of_survey_survey_view_search_crm_project"/>
        <field name="help" type="html">
            <p>
                No Survey Found
            </p>
        </field>
    </record>

    <menuitem name="Surveys" id="menu_of_survey_survey_form_crm" action="of_crm_project.of_action_survey_form" parent="crm.crm_menu_config" sequence="11"/>

</odoo>
