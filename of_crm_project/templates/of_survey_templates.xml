<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="survey_fill_form_start" inherit_id="of_survey.survey_fill_form_start">
        <xpath expr="//button" position="after">
            <div class="show_start" t-attf-data-show="{{survey.show_start and 'yes' or 'no'}}"/>
        </xpath>
    </template>

    <template id="survey_fill_form_done" inherit_id="of_survey.survey_fill_form_done">
        <xpath expr="//a[hasclass('btn-end')]/.." position="after">
            <div class="show_end" t-attf-crm-lead-id="{{request.env['crm.lead'].search([('of_survey','=',survey.id)],limit=1).id}}" t-attf-data-show="{{survey.show_end and 'yes' or 'no'}}"/>
        </xpath>
    </template>
</odoo>
