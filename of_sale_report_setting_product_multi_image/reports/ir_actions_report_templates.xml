<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document" inherit_id="of_sale_report_setting.report_saleorder_document">

        <xpath expr="//th[@name='th_image']" position="attributes">
            <attribute name="t-if">pdf_print_image_level in ['line', 'line_appendix']</attribute>
        </xpath>

        <xpath expr="//td[@name='td_image']" position="replace">
            <td name="td_image" class="text-center" t-if="pdf_print_image_level in ['line', 'line_appendix']" style="vertical-align: middle;">
                <t t-if="pdf_print_image_level == 'line' and line.product_id.image_128">
                    <img t-att-src="image_data_uri(line.product_id.image_128)" style="max-height: 48px;"/>
                </t>
                <t t-if="pdf_print_image_level == 'line_appendix' and line.of_product_image_ids">
                    <img t-att-src="image_data_uri(line.of_product_image_ids[0].image_128)" style="max-height: 48px;"/>
                </t>
            </td>
        </xpath>

        <xpath expr="//div[@name='signature']" position="before">
            <t t-if="pdf_print_image_level in ['appendix', 'line_appendix']">
                <t t-set="any_image" t-value="(pdf_print_image_level == 'appendix' and any(line.of_product_image_ids for line in doc.order_line)) or
                                              (pdf_print_image_level == 'line_appendix' and any(len(line.of_product_image_ids) > 1 for line in doc.order_line))"/>
                <div class="row" t-if="any_image">
                    <div class="col-12">
                        <h4>Appendix</h4>
                        <t t-foreach="doc.order_line" t-as="line">
                            <div t-if="(pdf_print_image_level == 'appendix' and line.of_product_image_ids) or (pdf_print_image_level == 'line_appendix' and len(line.of_product_image_ids) > 1)" style="page-break-inside: avoid;">
                                <h5><em t-field="line.product_id.name"/></h5>
                                <div class="row mb16">
                                    <t t-set="img_num" t-value="0"/>
                                    <t t-foreach="line.of_product_image_ids" t-as="image">
                                        <div t-if="(pdf_print_image_level != 'line_appendix' or img_num > 0)" class="col-4">
                                            <img class="img-responsive center-block" t-att-src="image_data_uri(image.image_128)" style="max-height: 150px;"/>
                                            <p class="mt8 text-center" t-field="image.name"/>
                                        </div>
                                        <t t-set="img_num" t-value="img_num + 1"/>
                                    </t>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>

    </template>

</odoo>
