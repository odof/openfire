<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="of_sale_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.sale.comment.template.res.config.settings.form.view</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="15"/>
        <field name="inherit_id" ref="of_sale.of_sale_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='group_of_display_tax_inclued_total_in_so_lines']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="of_propagate_comments">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_propagate_comments_settings"/>
                        <div class="text-muted">
                            Propagates comments from sale order to invoice
                        </div>
                        <div class="mt16">
                            <field name="of_propagate_comments_settings" class="o_light_label" widget="radio" style="display: inline;" />
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
