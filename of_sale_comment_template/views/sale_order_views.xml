<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_comment_template.action_sale_order_comment_template"
        model="ir.actions.act_window">
        <field name="context">{}</field>
    </record>

    <record id="sale_order_form_add_comment" model="ir.ui.view">
        <field name="name">comment_template.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_comment_template.sale_order_form_add_comment" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='comment_template_ids']" position="attributes">
                <attribute name="context" operation="update">
                    {
                    "tree_view_ref": "of_sale_comment_template.base_comment_template_view_o2m_tree",
                    }
                </attribute>
            </xpath>
            <xpath expr="//page[@name='comments']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Comments template" name="comment_template">
                    <group string="Top Comments" name="top_comments">
                        <field name="of_top_comment_template_id"/>
                    </group>
                    <field name="of_top_comment" nolabel="1"/>
                    <group string="Bottom Comments" name="bottom_comments">
                        <field name="of_bottom_comment_template_id"/>
                    </group>
                    <field name="of_bottom_comment" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
