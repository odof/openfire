<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template
        id="report_saleorder_document_comments"
        inherit_id="sale_comment_template.report_saleorder_document_comments">
        <xpath expr="//t[@t-as='comment_template_top']" position="replace">
            <div t-out="doc.of_top_comment" />
        </xpath>

        <xpath expr="//t[@t-as='comment_template_bottom']" position="replace">
            <div t-out="doc.of_bottom_comment" />

        </xpath>
    </template>

</odoo>
