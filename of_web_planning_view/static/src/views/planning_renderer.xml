6 12.8496 4.47516Z" />
                                </g>
                                <defs>
                                    <clipPath id="clip0_1746_5630">
                                        <rect width="16" height="16" transform="translate(0.653992 0.722656)"/>
                                    </clipPath>
                                </defs>
                            </svg>
                            <span t-esc="pill._tripDsp" />
                        </div>
                    </div>
                    <div class="o_planning_pill_title text-truncate mx-1" t-esc="pill.displayPrimary" />
                    <div class="o_planning_pill_title text-truncate mx-1 fw-bold" t-esc="pill.displaySecondary"/>
                </div>
                <div t-else="" class="o_planning_pill_title text-truncate mx-1" t-esc="pill.displayName" />
                <div t-if="pill.disableDrag" class="o_planning_lock fa fa-lock ms-auto me-2" />
            </div>
            <t t-if="renderConnectors" t-call="{{ constructor.connectorCreatorTemplate }}">
                <t t-set="alignment" t-value="{ horizontal: 'right', vertical: 'bottom' }" />
            </t>
        </div>
    </t>

    <!-- Total row -->
    <t t-name="of_web_planning_view.PlanningRenderer.TotalRow" owl="1">
        <t t-if="model.metaData.groupedBy.length">
            <div class="o_planning_row_sidebar bg-view d-flex align-items-center justify-content-end position-sticky">
                <h4
                    class="o_planning_row_title pe-3 my-0 fw-bold"
                    t-att-title="totalRow.name"
                    t-esc="totalRow.name"
                />
            </div>
        </t>
        <div class="o_planning_row_total o_planning_grid_columns bg-view">
            <t t-foreach="columns" t-as="column" t-key="column.id">
                <div
                    class="o_planning_cell"
                    t-att-class="{ o_planning_today: column.isToday }"
                    t-att-style="getGridPosition({ column: column.grid.column, row: 1 })"
                />
            </t>
            <t t-foreach="totalRow.pills" t-as="pill" t-key="pill.id">
                <div
                    class="o_planning_pill_wrapper position-relative p-0 h-100 d-flex align-items-end"
                    t-att-style="getGridPosition(pill.grid)"
                >
                    <div class="o_planning_pill o_planning_consolidated_pill w-100 d-flex align-items-end justify-content-center"
                        t-att-title="pill.displayName"
                        t-attf-style="height: {{ totalRow.factor * pill.aggregateValue }}%;"
                    >
                        <span class="o_planning_consolidated_pill_title bg-view text-truncate px-1 mb-1" t-esc="pill.displayName" />
                    </div>
                </div>
            </t>
        </div>
    </t>

    <!-- Planning cell buttons -->
    <t t-name="of_web_planning_view.PlanningCellButtons" owl="1">
        <div
            class="o_planning_cell_buttons position-absolute o_planning_cell_group_buttons_hidden w-100"
            t-on-pointermove.stop=""
            z-index="10"
            t-ref="root"
            style="bottom: 0px;"
        >
            <i
                t-if="props.canCreate"
                title="Create"
                class="o_planning_cell_add fa fa-plus d-flex align-items-center justify-content-center"
                t-att-style="props.scale.id == 'day' ? 'margin: auto; margin-bottom: 0;' : 'margin: auto; margin-bottom: 0; margin-right: 0;'"
                t-on-click.stop="onCreate"
            />
            <i
                t-if="props.scale.id == 'week' and props.canPlan"
                title="Plan existing"
                class="o_planning_cell_plan fa fa-search-plus d-flex align-items-center justify-content-center"
                style="margin: auto; margin-bottom: 0; margin-left: 0;"
                t-on-click.stop="onPlan"
            />
        </div>
    </t>

</templates>
