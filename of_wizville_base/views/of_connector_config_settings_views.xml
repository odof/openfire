<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_connector_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.connector.config.settings.view.form</field>
        <field name="model">of.connector.config.settings</field>
        <field name="inherit_id" ref="of_base.of_connector_config_settings_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group string="Wizville Integration" name="wizville">
                    <group name="general" string="General">
                        <field name="wizville_sftp_host"/>
                        <field name="wizville_sftp_port"/>
                        <field name="wizville_sftp_user"/>
                        <field name="wizville_sftp_password" password="True"/>
                        <separator string="Export" name="export" colspan="2"/>
                        <field name="wizville_sftp_deposit_directory"/>
                        <field name="wizville_export_filename"/>
                        <separator string="Import" name="import" colspan="2"/>
                        <field name="wizville_sftp_pickup_directory"/>
                        <field name="wizville_import_filename"/>
                        <separator string="Questions" name="questions" colspan="2"/>
                        <field name="wizville_satisfaction_question"/>
                        <field name="wizville_nps_score_question"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
