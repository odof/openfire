<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_wizville_history_view_search" model="ir.ui.view">
        <field name="name">of.wizville.history.search</field>
        <field name="model">of.wizville.history</field>
        <field name="arch" type="xml">
            <search string="Import/export history">
                <field name="file_name_wizville"/>
                <field name="date"/>
                <separator/>
                <filter string="Import" name="import" domain="[('type', '=', 'import')]"/>
                <filter string="Export" name="export" domain="[('type', '=', 'export')]"/>
                <filter string="Realized" name="done" domain="[('done', '=', True)]"/>
                <filter string="Not realised" name="not_done" domain="[('done', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="of_wizville_history_view_form" model="ir.ui.view">
        <field name="name">Historique des imports/exports</field>
        <field name="model">of.wizville.history</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="put_file_wizville" type="object" string="Send to wizville" class="oe_highlight"
                            attrs="{'invisible': [('type', '=', 'import')]}"/>
                    <button name="integrate_wizville_file" type="object" string="Integrate the file" class="oe_highlight"
                            attrs="{'invisible': [('type', '=', 'export')]}"/>
                </header>
                <sheet>
                    <div class="of_title">
                        <b>
                            <field name="file_name_wizville" nolabel="1" class="oe_inline"/>
                        </b>
                    </div>
                    <group name="main">
                        <field name="date"/>
                        <field name="type"/>
                        <label for="file_wizville"/>
                        <div name="file_wizville_div">
                            <span>
                                Upload
                                <field name="file_wizville" filename="file_name_wizville"/>
                            </span>
                        </div>
                        <field name="done"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_wizville_history_view_tree" model="ir.ui.view">
        <field name="name">Historique des imports/exports</field>
        <field name="model">of.wizville.history</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="file_name_wizville"/>
                <field name="type"/>
                <field name="done"/>
            </tree>
        </field>
    </record>

    <record id="of_wizville_history_action" model="ir.actions.act_window">
        <field name="name">Import/export history</field>
        <field name="res_model">of.wizville.history</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
