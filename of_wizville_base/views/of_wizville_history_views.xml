<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_wizville_history_view_search" model="ir.ui.view">
        <field name="name">of.wizville.history.search</field>
        <field name="model">of.wizville.history</field>
        <field name="arch" type="xml">
            <search string="Import/export history">
                <field name="name"/>
                <field name="export_date"/>
                <separator/>
                <filter string="Import" name="import" domain="[('type', '=', 'import')]"/>
                <filter string="Export" name="export" domain="[('type', '=', 'export')]"/>
                <filter string="Realized" name="done" domain="[('is_export_done', '=', True)]"/>
                <filter string="Not realized" name="not_done" domain="[('is_export_done', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="of_wizville_history_view_form" model="ir.ui.view">
        <field name="name">of.wizville.history.view.form</field>
        <field name="model">of.wizville.history</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_button_put_file_wizville" type="object" string="Send to wizville" class="oe_highlight" attrs="{'invisible': [('type', '=', 'import')]}"/>
                    <button name="action_button_integrate_wizville_file" type="object" string="Integrate the file" class="oe_highlight" attrs="{'invisible': [('type', '=', 'export')]}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" class="text-break" placeholder="Filename" />
                        </h1>
                    </div>
                    <group name="main">
                        <field name="export_date"/>
                        <field name="type"/>
                        <field name="file" filename="name"/>
                        <field name="is_export_done"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_wizville_history_view_tree" model="ir.ui.view">
        <field name="name">of.wizville.history.view.tree</field>
        <field name="model">of.wizville.history</field>
        <field name="arch" type="xml">
            <tree>
                <field name="export_date"/>
                <field name="name"/>
                <field name="type"/>
                <field name="is_export_done"/>
            </tree>
        </field>
    </record>

    <record id="of_wizville_history_action" model="ir.actions.act_window">
        <field name="name">of.wizville.history.action</field>
        <field name="res_model">of.wizville.history</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
