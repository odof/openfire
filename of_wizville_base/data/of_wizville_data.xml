<?xml version="1.0"?>
<odoo noupdate="1">

    <record id="of_wizville_export_files" model="ir.cron">
        <field name="name">Generation of files for export to Wizville</field>
        <field name="model_id" ref="of_wizville_base.model_of_wizville_history"/>
        <field name="state">code</field>
        <field name="code">model.cron_do_export_wizville()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=2,minute=0,second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">False</field>
    </record>

    <record id="of_wizville_import_files" model="ir.cron">
        <field name="name">Recovery of wizville files</field>
        <field name="model_id" ref="of_wizville_base.model_of_wizville_history"/>
        <field name="code">model.cron_do_import_wizville()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=3,minute=0,second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">False</field>
    </record>

</odoo>
