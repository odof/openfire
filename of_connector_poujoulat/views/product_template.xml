<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group name="connector_poujoulat" string="Informations Poujoulat" attrs="{'invisible': [('of_is_poujoulat_product', '=', False)]}" colspan="2">
                    <field name="of_is_poujoulat_product" invisible="1"/>
                    <field name="of_poujoulat_artas400" readonly="1"/>
                    <field name="of_poujoulat_variant" readonly="1"/>
                    <field name="of_poujoulat_cond_unit" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
