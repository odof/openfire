<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="of_connector_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='connector_base_settings']" position="inside">
                <h2>Poujoulat</h2>
                <div class="row mt16 o_settings_container" id="of_wizville_settings_sftp">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="of_poujoulat_host"/>
                            <field name="of_poujoulat_host"/>
                        </div>
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="of_poujoulat_redirect"/>
                            <field name="of_poujoulat_redirect"/>
                        </div>
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="of_poujoulat_partner_ids"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="of_poujoulat_partner_ids_str" invisible="1"/>
                                    <field name="of_poujoulat_partner_ids"  class="oe_inline" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="of_poujoulat_brand_ids"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="of_poujoulat_brand_ids_str" invisible="1"/>
                                    <field name="of_poujoulat_brand_ids"  class="oe_inline" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
