<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_service_request_stage_view_form" model="ir.ui.view">
        <field name="name">of.service.request.stage.view.form</field>
        <field name="model">of.service.request.stage</field>
        <field name="inherit_id" ref="of_service.of_service_request_stage_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="of_service_request_stage_view_tree" model="ir.ui.view">
        <field name="name">of.service.request.stage.view.tree</field>
        <field name="model">of.service.request.stage</field>
        <field name="inherit_id" ref="of_service.of_service_request_stage_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="state"/>
            </xpath>
        </field>
    </record>

</odoo>
