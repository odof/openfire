<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_tournee_view_form" model="ir.ui.view">
        <field name="name">of.planning.tournee.form</field>
        <field name="model">of.planning.tournee</field>
        <field name="arch" type="xml">
            <form string="Tournées">
                <group colspan="2" col="4">
                    <separator string="Info" colspan="4"/>
                    <field name="date_jour"/>
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="secteur_id"/>
                    <field name="address_depart_id"/>
                    <field name="address_retour_id"/>
                    <field name="distance" attrs="{'required': [('is_bloque', '=', False)]}"/>
                    <group colspan="4" col="8">
                        <field name="is_complet"/>
                        <field name="is_bloque"/>
                        <field name="is_confirme"/>
                    </group>
                    <separator string="Epicentre" colspan="4" col="4"/>
                    <field name="zip_id"/>
                    <separator colspan="4"/>
                    <field name="epi_lat" attrs="{'required': [('is_bloque', '=', False)]}"/>
                    <field name="epi_lon" attrs="{'required': [('is_bloque', '=', False)]}"/>
                    <separator colspan="4" string="Documents"/>
                    <button string="OSRM TEST" name="action_compute_osrm_steps" type="object" class="oe_highlight"/>
                </group>
                <notebook>
                    <page name="tour_lines" string="Lines">
                        <field name="tour_line_ids" mode="tree" nolabel="1" context="{'from_tour':1}">
                            <tree string="Tour lines" editable="top">
                                <field name="intervention_id"/>
                                <field name="date_start"/>
                                <field name="city"/>
                                <field name="employee_ids"/>
                                <field name="duration" widget="float_time"/>
                            </tree>
                        </field>
                    </page>
                    <page name="tour_lines_map" string="Map">
                        <field name="map_tour_line_ids" mode="map" nolabel="1" context="{'from_tour':1, 'active_tour_id': active_id}"/>
                    </page>
                    <page name="intervention_map" string="Map">
                        <field name="intervention_map_ids" mode="map" nolabel="1" context="{'map_view_ref': 'of_planning_tournee.of_planning_intervention_tour_map_view', 'active_tour_id': active_id}"/>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="of_planning_tournee_view_tree" model="ir.ui.view">
        <field name="name">of.planning.tournee.tree</field>
        <field name="model">of.planning.tournee</field>
        <field name="arch" type="xml">
            <tree editable="top" colors="red:(is_complet==True) or (is_bloque==True);grey:(is_confirme==False)">
                <field name="date_jour"/>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="secteur_id"/>
                <field name="zip_id"/>
                <field name="address_depart_id"/>
                <field name="address_retour_id"/>
                <field name="is_complet"/>
                <field name="is_confirme"/>
                <field name="is_bloque" invisible="1"/>
                <field name="intervention_ids" widget="many2many_tags" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="of_planning_tournee_view_filter" model="ir.ui.view">
        <field name="name">of.planning.tournee.filter</field>
        <field name="model">of.planning.tournee</field>
        <field name="arch" type="xml">
            <search string="Recherche">
                <group>
                    <filter name="filter_incomplet" string="Incomplet" icon="terp-accessories-archiver" domain="[('is_complet', '=', False)]"/>
                    <field name="date_min" filter_domain="[('date','&gt;=',self)]"/>
                    <field name="date_max" filter_domain="[('date','&lt;=',self)]"/>
                    <field name="employee_id"/>
                    <field name="secteur_id"/>
                    <field name="zip_id"/>
                </group>
             </search>
        </field>
    </record>

    <record id="of_planning_tour_line_map_view" model="ir.ui.view">
        <field name="name">of.planning.tournee.line.map.view</field>
        <field name="model">of.planning.tournee.line</field>
        <field name="arch" type="xml">
            <map latitude_field="geo_lat" longitude_field="geo_lng" color_field="map_color_tour" number_field="tour_number" is_first_field="first_address_tour" 
                    is_last_field="last_address_tour" draw_routes="0" connect_markers="1" hide_pager="1" force_legend_method="custom_get_color_map" geojson_data="geojson_data">
                <field name="map_color_tour" required="1"/>
                <field name="geo_lat" required="1"/>
                <field name="geo_lng" required="1"/>
                <field name="partner_name"/>
                <field name="tache_name"/>
                <field name="address_zip"/>
                <field name="address_city"/>
                <field name="partner_mobile"/>
                <field name="partner_phone"/>
                <field name="date_start"/>
                <field name="tour_number"/>
                <field name="first_address_tour"/>
                <field name="last_address_tour"/>
                <field name="last_address_tour"/>
                <field name="geojson_data"/>
                <templates>
                    <t t-name="of_map_record_box">
                        <div t-attf-class="#{map_record_color(record.map_color_tour.raw_value)} of_map_record_global_click">
                            <div class="of_map_record_buttons">
                                <i class="of_map_record_close fa fa-lg fa-times"/>
                            </div>
                            <div name="content" class="of_map_record_content">
                                <t t-if="record.tour_number.raw_value">
                                    <i class="of_map_record_main fa fa-hashtag"/><span class="of_ws"/><strong><field name="tour_number"/></strong>
                                    <br/>
                                </t>
                                <t t-if="record.partner_name.raw_value">
                                    <i class="of_map_record_main fa fa-user"/><span class="of_ws"/><strong><field name="partner_name"/></strong>
                                    <br/>
                                </t>
                                <t t-if="record.address_zip.raw_value">
                                    <i class="of_map_record_main fa fa-map-marker"/><span class="of_ws"/><field name="address_zip"/><span class="of_ws"/><field name="address_city"/><br/>
                                </t>
                                <t t-if="record.partner_phone.raw_value">
                                    <i class="of_map_record_main fa fa-phone"/><span class="of_ws"/><field name="partner_phone"/><br/>
                                </t>
                                <t t-if="record.partner_mobile.raw_value">
                                    <i class="of_map_record_main fa fa-phone"/><span class="of_ws"/><field name="partner_mobile"/><br/>
                                </t>
                                <t t-if="record.tache_name.raw_value">
                                    <i class="of_map_record_main fa fa-cogs"/><span class="of_ws"/><field name="tache_name"/><br/>
                                </t>
                                <t t-if="record.date_start.raw_value">
                                    <i class="of_map_record_main fa fa-truck"/><span class="of_ws"/><field name="date_start"/><br/>
                                </t>
                            </div>
                        </div>
                    </t>
                    <t t-name="of_map_marker_tooltip">
                        <div name="marker_tooltip">
                            <t t-if="record.tour_number.raw_value">
                                <i class="of_map_record_main fa fa-hashtag"/><span class="of_ws"/><strong><field name="tour_number"/></strong>
                                <br/>
                            </t>
                            <t t-if="record.partner_name.raw_value">
                                <i class="fa fa-user"/><span class="of_ws"/><field name="partner_name"/><br/>
                            </t>
                            <t t-if="record.address_zip.raw_value or record.address_city.raw_value">
                                <i class="fa fa-map-marker"/><span class="of_ws"/><field name="address_zip"/><span class="of_ws"/><field name="address_city"/><br/>
                            </t>
                            <t t-if="record.partner_phone.raw_value">
                                <i class="fa fa-phone"/><span class="of_ws"/><field name="partner_phone"/><br/>
                            </t>
                            <t t-if="record.partner_mobile.raw_value">
                                <i class="fa fa-phone"/><span class="of_ws"/><field name="partner_mobile"/><br/>
                            </t>
                            <t t-if="record.tache_name.raw_value">
                                <i class="fa fa-cogs"/><span class="of_ws"/><field name="tache_name"/><br/>
                            </t>
                            <t t-if="record.date_start.raw_value">
                                <i class="fa fa-truck"/><span class="of_ws"/><field name="date_start"/><br/>
                            </t>
                        </div>
                    </t>
                </templates>
            </map>
        </field>
    </record>

    <record id="action_of_planning_tournee_tree" model="ir.actions.act_window">
        <field name="name">Préparation des tournées</field>
        <field name="res_model">of.planning.tournee</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="of_planning_tournee.of_planning_tournee_view_tree"/>
        <field name="context">{'search_default_filter_incomplet':1}</field>
    </record>

    <menuitem name="Tournées" id="menu_of_planning_tournee_tree" parent="of_planning.menu_of_planning_intervention" sequence="75"
              action="action_of_planning_tournee_tree"/>

    <!-- vue map des services -->
    <record id="of_planning_tournee_service_map_view" model="ir.ui.view">
        <field name="name">of.planning.tournee.service.view.map</field>
        <field name="model">of.service</field>
        <field name="inherit_id" ref="of_service.of_service_map_view"/>
        <field name="arch" type="xml">
            <!-- ajout champs nécessaires -->
            <xpath expr="//map//field[@name='date_next']" position="after">
                <field name="partner_id"/>
                <field name="address_id"/>
            </xpath>
            <!-- ajout action "planifier une intervention" -->
            <xpath expr="//map//templates//div[@name='content']" position="inside">
                <t t-set="service_id" t-value="record.id.raw_value"/>
                <t t-set="address_id" t-value="record.address_id.raw_value[0]"/> <!-- dans le contexte d'une vue map, address_id n'est jamais undefined -->
                <t t-set="partner_id" t-value="record.partner_id.raw_value[0] || address_id"/>
                <a name="%(of_planning_tournee.action_view_rdv_intervention_wizard_service)d" type="action"
                  t-attf-data-context="{'default_partner_id': {{partner_id}}, 'default_service_id': {{service_id}}, 'default_address_id': {{address_id}},}">
                    <i class="fa fa-calendar-o"/><span class="of_ws"/>
                    <span>Planifier une intervention</span><br/>
                </a>
            </xpath>
        </field>
    </record>

</odoo>
