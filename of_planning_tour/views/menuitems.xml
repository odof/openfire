<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tours -->
    <record id="menu_of_planning_tour_create" model="ir.ui.menu">
        <field name="name">Tours</field>
        <field name="sequence">50</field>
        <field name="parent_id" ref="of_planning.menu_of_planning_intervention"/>
        <field name="action" ref="of_planning_tour.action_of_planning_tour_manual_create"/>
        <field name="groups_id" eval="[Command.set([ref('of_planning_tour.group_of_planning_tour_manual_creation')])]"/>
    </record>

    <record id="menu_of_planning_tour_no_create" model="ir.ui.menu">
        <field name="name">Tours</field>
        <field name="sequence">50</field>
        <field name="parent_id" ref="of_planning.menu_of_planning_intervention"/>
        <field name="action" ref="of_planning_tour.action_of_planning_tour_no_manual_create"/>
        <field name="groups_id" eval="[Command.set([ref('of_planning_tour.group_of_planning_tour_no_manual_creation')])]"/>
    </record>

    <!-- Tour appointments templates -->
    <menuitem id="menu_of_tour_appointment_template" name="Slot search templates" action="of_tour_appointment_template_action" parent="of_planning.menu_of_planning_configuration" sequence="15"/>

    <!-- Available Slots -->
    <menuitem id="menu_of_planning_available_slot" name="Available Slots" action="action_of_planning_available_slot" parent="of_planning.menu_of_planning_configuration" sequence="30"/>

</odoo>
