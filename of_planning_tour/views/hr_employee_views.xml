<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">of.planning.hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']/group" position="inside">
                <group string="Mobility">
                    <field name="of_start_address_id"/>
                    <field name="of_return_address_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
