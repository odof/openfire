<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_action_server_tour_route_mass_update" model="ir.actions.server">
        <field name="name">Mass route update</field>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_of_planning_tour"/>
        <field name="binding_model_id" ref="model_of_planning_tour"/>
        <field name="binding_view_types">list</field>
        <field name="code">
            if records:
                action = records.action_mass_tour_route_update()
        </field>
        <field name="groups_id" eval="[Command.set([ref('of_base.of_group_root_only')])]"/>
    </record>

    <record id="ir_action_server_mass_sector_assignation" model="ir.actions.server">
        <field name="name">Mass sector assignation</field>
        <field name="state">code</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_of_planning_tour"/>
        <field name="binding_model_id" ref="model_of_planning_tour"/>
        <field name="binding_view_types">list</field>
        <field name="code">
            if records:
                action = records.action_mass_sector_assignation()
        </field>
        <field name="groups_id" eval="[Command.set([ref('of_base.of_group_root_only')])]"/>
    </record>

</odoo>
