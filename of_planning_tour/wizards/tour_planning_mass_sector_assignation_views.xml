<?xml version="1.1" encoding="UTF-8"?>
<odoo>

    <record id="of_tour_planning_area_mass_assignation_wizard_view_form" model="ir.ui.view">
        <field name="name">of.planning.tour.mass.sector.assignation.wizard.view.form</field>
        <field name="model">of.planning.tour.mass.sector.assignation.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass sector assignation">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        <b>Warning:</b> This action will assign a sector to all the lines of the selected tours. If a tour has already an intervention with a different sector, it will not be updated.
                    </div>
                    <group>
                        <group col="1">
                            <field name="sector_id" required="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_button_validate" string="Validate" type="object" class="oe_highlight" />
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
