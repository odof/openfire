<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="of_planning_tour.popoverMarker" owl="1">
        <div class="container-fluid">
            <div class="row g-0">
                <div class="col">
                    <ul class="ps-1 mb-0 list-unstyled">
                        <div><i class="fa fa-flag pe-1"/><strong t-esc="record.tour_number"/></div>
                        <li t-if="record.partner_name"><i class="fa fa-user pe-1"/><strong t-esc="record.partner_name"/></li>
                        <li t-if="record.of_address_zip or record.of_address_city"><i class="fa fa-map-marker pe-1"/><span t-if="record.of_address_zip" t-esc="record.of_address_zip"/> <span t-if="record.of_address_city" t-esc="record.of_address_city"/></li>
                        <li t-if="record.partner_phone">
                            <i class="fa fa-phone pe-1"/><span t-esc="record.partner_phone"/><br/>
                        </li>
                        <li t-if="record.partner_mobile">
                            <i class="fa fa-phone pe-1"/><span t-esc="record.partner_mobile"/><br/>
                        </li>
                        <li t-if="record.task_name"><i class="fa fa-cog pe-1"/><span t-esc="record.task_name"/></li>
                        <li t-if="record.date_start">
                            <i class="fa fa-truck pe-1"/>
                            <t t-if="record.date_start.c.day &lt; 10">0</t><span t-esc="record.date_start.c.day"/>/<t t-if="record.date_start.c.month &lt; 10">0</t><span t-esc="record.date_start.c.month"/>/<span t-esc="record.date_start.c.year" class="pe-1"/>
                            <t t-if="record.date_start.c.hour &lt; 10">0</t><span t-esc="record.date_start.c.hour"/>:<t t-if="record.date_start.c.minute &lt; 10">0</t><span t-esc="record.date_start.c.minute"/>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </t>

</templates>
