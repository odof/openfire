<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_account_document_layout_view_form" model="ir.ui.view">
        <field name="name">of.account.payment.schedule.invoice.document.layout</field>
        <field name="model">of.invoice.document.layout</field>
        <field name="inherit_id" ref="of_invoice_report_setting.of_invoice_document_layout_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pdf_invoice_price_taxinc']/../.." position="after">

                <div>
                    <div class="o_setting_left_pane">
                        <field name="pdf_invoice_payment_schedule"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pdf_invoice_payment_schedule"/>
                        <div class="text-muted">
                            Displays the Payment schedule in the report
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
