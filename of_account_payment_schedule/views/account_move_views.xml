<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_account_move_view_order_payment_schedule_form" model="ir.ui.view">
        <field name="name">of.account.payment.schedule.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='narration']" position="before">
                <group name="payment_schedule_group" string="Payment schedule" colspan="2">
                    <field name="of_show_update_payment_schedule" invisible="1"/>
                    <button name="action_button_update_payment_schedule" type="object"
                        string="Update Payment Schedule" colspan="2"
                        help="Recompute the payment schedule based on the current pricelist and the payment terms."
                        class="btn-link g-col-sm-2" icon="fa-refresh"
                        confirm="This will update the payment schedule based on the current pricelist and the payment terms. Do you want to continue ?"
                        attrs="{'invisible': ['|', ('of_show_update_payment_schedule', '=', False), ('state', 'in', ['cancel'])]}"/>
                    <field name="of_payment_schedule_ids" nolabel="1" colspan="2">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="sequence" invisible="1"/>
                            <field name="is_last" invisible="1"/>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="percent" attrs="{'readonly': [('is_last','=',True)]}" sum="Total"/>
                            <field name="amount" attrs="{'readonly': [('is_last','=',True)]}" sum="Total"/>
                            <field name="currency_id" invisible="1"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
