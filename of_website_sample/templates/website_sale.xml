<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- /shop/product product page -->
    <template id="product" inherit_id="website_sale.product" name="Product">
        <xpath expr="//form[@action='/shop/cart/update']" position="after">
            <form t-if="product.sudo().sample_id" action="/shop/cart/sample_update" class="js_add_sample_cart_variants" t-att-data-attribute_value_ids="attribute_value_ids" method="POST" id="form_sample_to_cart">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                <input type="hidden" class="product_id" name="product_id" t-att-value="product.sudo().sample_id and product.sudo().sample_id.product_variant_id.id"/>
                <a id="add_sample_to_cart" class="btn btn-primary btn-lg mt8 a-submit" href="#">Add sample to Cart</a>
            </form>
        </xpath>
    </template>

