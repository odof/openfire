<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_product_brand_view_order_form" model="ir.ui.view">
        <field name="name">of.product.brand.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="attributes">
                <attribute name="help">
                    Note: When searching for a product, typing "m:ABC" will filter products for brand "ABC".
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_sale_stock_qty" model="ir.ui.view">
        <field name="name">sale.order.line.tree.sale.stock.qty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock_qty"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='qty_to_deliver']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_tree" model="ir.ui.view">
        <field name="name">of.sale.stock.view.order.line.tree</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale_order_line_menu.sale_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_qty']" position="after">
                <field name="qty_to_deliver" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
