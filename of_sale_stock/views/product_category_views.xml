<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_sale_stock_product_category_tree_view" model="ir.ui.view">
        <field name="name">product.category.tree.view</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="of_product.product_category_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_count']" position="before">
                <field name="route_ids" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
