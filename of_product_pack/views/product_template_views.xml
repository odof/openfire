<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_view_form_product_pack" model="ir.ui.view">
        <field name="name">of.product.pack.product.template.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']//field[@name='pack_ok']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='options']//group[@name='tags_and_pack_group']//group[@name='tags_group']" position="before">
                <group name="pack_group">
                    <field name="pack_ok" string="Pack" />
                </group>
            </xpath>
            <xpath expr="//field[@name='pack_component_price']" position="attributes">
                <attribute name="attrs">{}</attribute>
            </xpath>
            <xpath expr="//field[@name='pack_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='list_price']" position="attributes">
                <attribute name="nolabel">1</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="attrs">{'readonly':['&amp;',('pack_component_price','=','totalized'),('pack_ok','=',True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="nolabel">1</attribute>
                <attribute name="force_save">1</attribute>
                <attribute name="attrs">{'readonly':['&amp;', ('pack_component_price','=','totalized'),('pack_ok','=',True)]}</attribute>
            </xpath>

            <xpath expr="//label[@for='list_price']" position="attributes">
                <attribute name="string">Kit Price</attribute>
                <attribute name="attrs">{'invisible': ['|',('pack_component_price','=','ignored'),('pack_ok','=',False)]}</attribute>
            </xpath>

            <xpath expr="//label[@for='list_price']" position="after">
                <label for="list_price" string="Sales Price" attrs="{'invisible': ['&amp;',('pack_component_price','=','totalized'),('pack_ok','=',True)]}" />
            </xpath>

            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="string">Kit Cost</attribute>
                <attribute name="attrs">{'invisible': ['|','&amp;',('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False),'|',('pack_component_price','=','ignored'),('pack_ok','=',False)]}</attribute>
            </xpath>
            <xpath expr="//label[@for='standard_price']" position="after">
                <label for="standard_price" string="Cost" attrs="{'invisible': ['|','&amp;',('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False),'&amp;',('pack_component_price','=','totalized'),('pack_ok','=',True)]}" />
            </xpath>
        </field>
    </record>

</odoo>
