<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TRIAL BALANCE -->
    <record id="of_tiers_trial_balance_wizard" model="ir.ui.view">
        <field name="name">of_tiers Trial Balance</field>
        <field name="model">trial.balance.report.wizard</field>
        <field name="inherit_id" ref="account_financial_report_qweb.trial_balance_wizard" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='account_filter']" position="before">
                <group>
                    <group>
                        <field name="of_receivable_accounts_grouped"/>
                        <field name="of_receivable_account_id"
                               attrs="{'invisible':[('of_receivable_accounts_grouped','!=',True)]}"/>
                    </group>
                    <group>
                        <field name="of_payable_accounts_grouped"/>
                        <field name="of_payable_account_id"
                               attrs="{'invisible':[('of_payable_accounts_grouped','!=',True)]}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
