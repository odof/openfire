<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_website_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.website.config.settings.form.inherit</field>
        <field name="model">website.config.settings</field>
        <field name="inherit_id" ref="website_sale.website_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='salesperson_id']/.." position="after">
                <label string="(OF) Liste de prix B2C par défaut" for="of_pricelist_b2c_id" groups="base.group_no_one"/>
                <div groups="base.group_no_one" class="oe_inline">
                    <field name="of_pricelist_b2c_id"/>
                </div>
                <label string="(OF) Position fiscale B2C par défaut" for="of_fiscal_position_b2c_id" groups="base.group_no_one"/>
                <div groups="base.group_no_one" class="oe_inline">
                    <field name="of_fiscal_position_b2c_id"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
