<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_template_view_form" model="ir.ui.view">
        <field name="name">of.sale.order.template.comment.form</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="of_sale_management_template.of_sale_order_template_inherit_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='documents']" position="after">
                <page string="Comments" name="comments">
                    <field name="of_comment_template_ids" context="{'default_models': 'sale.order'}"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
