<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="equipment_answer_template">
        <tr>
            <td>
                <span><strong t-field="answer.question_id.title"/> :</span>
                <div t-if="answer.answers_images_ids">
                    <t t-foreach="answer.answers_images_ids" t-as="answer_image">
                        <span t-field="answer_image.answer" class="d-block"/>
                        <t t-if="answer_image.image">
                            <img t-attf-src="data:image/png;base64,#{answer_image.image}" class="mr8 img-fluid" alt="Image" style="max-width: 100%; max-height: 400px;"/>
                        </t>
                    </t>
                </div>
                <div t-if="answer.image_ids">
                    <t t-foreach="answer.image_ids" t-as="image">
                        <figure class="d-inline-block align-top w-25 overflow-hidden" style="max-width: 24.7%; max-height: 320px;">
                            <span t-field="image.image_256" t-options="{'widget': 'image', 'class': 'mx-auto', 'style': 'max-height: 250px;'}" />
                            <figcaption class="text-muted text-center mt-1" t-if="image.caption" t-esc="image.caption"/>
                        </figure>
                    </t>
                </div>
            </td>
        </tr>
    </template>

    <template id="report_equipment_link_template" inherit_id="of_equipment.report_equipment_link_template">
        <xpath expr="//div[@name='equipment_minutes']" position="after">
            <div t-if="template.report_survey and link.answers_ids and link.answers_ids.filtered(lambda a: a.answers)" name="report_survey" class="row mb-4" style="page-break-inside: avoid;">
                <div class="col">
                    <h6 name="title_survey">
                        <strong>Survey</strong>
                    </h6>
                    <div class="border">
                        <table class="table table-condensed mb-0" style="border-color: transparent;">
                            <tbody>
                                <t t-set="pages_to_display" t-value="link._report_of_get_pages_to_display()"/>
                                <!-- Avec sections -->
                                <t t-foreach="pages_to_display" t-as="page">
                                    <tr class="bg-200">
                                        <td>
                                            <strong t-field="page.question_id.title"/> :
                                        </td>
                                    </tr>
                                    <t t-foreach="link._report_of_get_answers_to_display(page, True)" t-as="answer">
                                        <t t-call="of_equipment_survey.equipment_answer_template"/>
                                    </t>
                                </t>
                                <!-- Sans sections -->
                                <t t-if="not pages_to_display">
                                    <t t-foreach="link._report_of_get_answers_to_display(report=True)" t-as="answer">
                                        <t t-call="of_equipment_survey.equipment_answer_template"/>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="report_intervention_report_document" inherit_id="of_planning_survey.report_intervention_report_document">
        <xpath expr="//h5[@name='title_survey']" position="replace">
            <h5 t-if="event._report_of_has_at_least_one_equipment_link_survey()" name="title_survey">
                <strong>Intervention Survey</strong>
            </h5>
            <h5 t-else="" name="title_survey">
                <strong>Survey</strong>
            </h5>
        </xpath>
    </template>

</odoo>
