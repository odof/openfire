<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="module_category_marketing_of_surveys" model="ir.module.category">
        <field name="description">Helps you manage your OpenFire survey</field>
        <field name="sequence">20</field>
        <field name="name">OpenFire Survey</field>
    </record>

    <!-- Survey users -->
    <record model="res.groups" id="group_of_survey_user">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_marketing_of_surveys"/>
    </record>

    <!-- Survey managers -->
    <record model="res.groups" id="group_of_survey_manager">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_marketing_of_surveys"/>
        <field name="implied_ids" eval="[(4, ref('group_of_survey_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="base.default_user" model="res.users">
        <field name="groups_id" eval="[(4,ref('group_of_survey_manager'))]"/>
    </record>

    <!-- SURVEY: SURVEY, PAGE, STAGE, QUESTION, LABEL -->
    <record id="of_survey_survey_rule_survey_manager" model="ir.rule">
        <field name="name">OpenFire Survey: manager: all</field>
        <field name="model_id" ref="of_survey.model_of_survey_survey"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_of_survey_manager'))]"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
    </record>
    <record id="of_survey_survey_rule_survey_user_read" model="ir.rule">
        <field name="name">OpenFire Survey: officer: read all</field>
        <field name="model_id" ref="of_survey.model_of_survey_survey"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_of_survey_user'))]"/>
        <field name="perm_unlink" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="0"/>
    </record>
    <record id="of_survey_survey_rule_survey_user_cwu" model="ir.rule">
        <field name="name">OpenFire Survey: officer: create/write/unlink own only</field>
        <field name="model_id" ref="of_survey.model_of_survey_survey"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_of_survey_user'))]"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_create" eval="1"/>
    </record>

    <record id="of_survey_question_rule_survey_manager" model="ir.rule">
        <field name="name">OpenFire Survey question: manager: all</field>
        <field name="model_id" ref="of_survey.model_of_survey_question"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_of_survey_manager'))]"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
    </record>
    <record id="of_survey_question_rule_survey_user_read" model="ir.rule">
