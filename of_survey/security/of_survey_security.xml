        <field name="name">OpenFire Survey question answer: officer: create/write/unlink linked to own survey only</field>
        <field name="model_id" ref="of_survey.model_of_survey_question_answer"/>
        <field name="domain_force">[('question_id.survey_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_of_survey_user'))]"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_create" eval="1"/>
    </record>

