    <record id="of_survey_question_rule_survey_user_cw" model="ir.rule">
        <field name="name">OpenFire Survey question: officer: create/write/unlink linked to own survey only</field>
        <field name="model_id" ref="of_survey.model_of_survey_question"/>
        <field name="domain_force">[('survey_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_of_survey_user'))]"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_read" eval="0"/>
        <field name="perm_create" eval="1"/>
    </record>

    <record id="of_survey_question_answer_rule_survey_manager" model="ir.rule">
