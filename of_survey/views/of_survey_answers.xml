<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_survey_answers_form" model="ir.ui.view">
        <field name="name">of.survey.answers.form</field>
        <field name="model">of.survey.answers</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="question_id"/>
                    <field name="answers"/>
                    <field name="question_type" invisible="1"/>
                    <field name="image_ids" mode="kanban" attrs="{'invisible': [('image_ids','=',[])]}"/>
                    <field name="form" attrs="{'invisible': [('form','=',False)]}"/>
                </group>
            </form>
        </field>
    </record>

    <record id="of_survey_answers_tree" model="ir.ui.view">
        <field name="name">of.survey.answers.tree</field>
        <field name="model">of.survey.answers</field>
        <field name="arch" type="xml">
            <tree>
                <field name="question_id"/>
                <field name="answers"/>
            </tree>
        </field>
    </record>

</odoo>
