<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">of.crm.project.crm.lead.form.view</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="of_crm_project.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='project']" position="inside">
                <group>
                    <group>
                        <field name="of_survey"/>
                    </group>
                    <group attrs="{'invisible': [('of_survey','=',False)]}">
                        <button class="btn btn-primary" name="open_survey" type="object" string="Reply"/>
                    </group>
                </group>

                <field name="of_question_ids" attrs="{'invisible': ['|',('of_survey','=',False),('of_survey_user_input_line','!=',[])]}">
                    <tree>
                        <field name="title" string="Question"/>
                    </tree>
                </field>

                <group>
                    <field name="of_survey_user_input" invisible="1"/>
                </group>
                    <field name="of_survey_user_input_line" attrs="{'invisible': ['|',('of_survey','=',False),('of_survey_user_input_line','=',[])]}" >
                        <tree>
                            <field name="question_id"/>
                            <field name="display_name" string="Answer"/>
                        </tree>
                        <form>
                            <group>
                                <field name="question_id"/>
                                <field name="display_name" string="Answer"/>
                            </group>
                        </form>
                    </field>
            </xpath>
        </field>
    </record>

</odoo>
