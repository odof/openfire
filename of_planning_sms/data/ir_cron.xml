<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="of_cron_sms_notif_daily" model="ir.cron">
        <field name="name">SMS daily reminder intervention</field>
        <field name="active" eval="True" />
        <field name="model_id" ref="calendar.model_calendar_event" />
        <field name="state">code</field>
        <field name="code">model.cron_sms_notif_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 18:00:00')"/>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root" />
    </record>

</odoo>
