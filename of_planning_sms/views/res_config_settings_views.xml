<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_sms_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.sms.res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']//div[@id='sms']/.." position="after">
                <div class="row mt16 o_settings_container" name="contacts_setting_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="of_sms_team_alert" title="If this checkbox is ticked, you will be able to send SMS alerts to the teams with summary of the intervention for the next day.">
                        <div class="o_setting_left_pane">
                            <field name="of_team_alert_intervention_sms"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="of_team_alert_intervention_sms"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                            <div class="text-muted">
                                Send SMS alert to the teams with summary of the intervention for the next day.
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box" id="of_sms_team_alert" title="If this checkbox is ticked, you will be able to send SMS alerts to customer with summary of the intervention for the next day.">
                        <div class="o_setting_left_pane">
                            <field name="of_customer_alert_intervention_sms"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="of_customer_alert_intervention_sms"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                            <div class="text-muted">
                                Send SMS alert to the customers with summary of the intervention for the next day.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
