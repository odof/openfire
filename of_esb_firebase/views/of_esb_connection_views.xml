<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_esb_connection_form" model="ir.ui.view">
        <field name="name">of.esb.connection.form</field>
        <field name="model">of.esb.connection</field>
        <field name="inherit_id" ref="of_esb.of_esb_connection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Firebase" attrs="{'invisible': [('ttype','!=','firebase')]}">
                    <field name="firebase_environment"/>
                    <field name="firebase_service_account_file"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
