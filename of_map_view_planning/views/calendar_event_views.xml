<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="calendar_event_view_map" model="ir.ui.view">
        <field name="name">of.map.view.planning.calendar.event</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <map
                tooltip_view="of_map_view_planning.tooltipRenderer"
                width="180"
                latitude="of_partner_latitude"
                longitude="of_partner_longitude"
                color="of_color_map">
                <field name="id"/>
                <field name="display_name"/>
                <field name="of_address_city"/>
                <field name="of_address_zip"/>
                <field name="of_address_phone_number_ids"/>
                <field name="of_task_id"/>
                <field name="start"/>
                <field name="of_precision"/>
                <field name="of_partner_latitude"/>
                <field name="of_partner_longitude"/>
                <field name="of_color_map"/>
                <templates>
                    <div t-name="map-popover" class="container-fluid">
                        <div class="row g-0">
                            <div class="col">
                                <ul class="ps-1 mb-0 list-unstyled">
                                    <li t-if="record.display_name"><i class="fa fa-user pe-1"/><strong t-esc="record.display_name"/></li>
                                    <li t-if="record.of_address_zip or record.of_address_city"><i class="fa fa-map-marker pe-1"/><span t-if="record.of_address_zip" t-esc="record.of_address_zip"/> <span t-if="record.of_address_city" t-esc="record.of_address_city"/></li>
                                    <li t-foreach="record.of_address_phone_number_ids.records" t-as="number" t-key="number_index">
                                        <i class="fa fa-phone pe-1"/><span t-esc="number.data.display_name"/>
                                    </li>
                                    <li t-if="record.of_task_id"><i class="fa fa-cog pe-1"/><span t-esc="record.of_task_id[1]"/></li>
                                    <li t-if="record.start">
                                        <i class="fa fa-truck pe-1"/>
                                        <t t-if="record.start.c.day &lt; 10">0</t><span t-esc="record.start.c.day"/>/<t t-if="record.start.c.month &lt; 10">0</t><span t-esc="record.start.c.month"/>/<span t-esc="record.start.c.year" class="pe-1"/>
                                        <t t-if="record.start.c.hour &lt; 10">0</t><span t-esc="record.start.c.hour"/>:<t t-if="record.start.c.minute &lt; 10">0</t><span t-esc="record.start.c.minute"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </templates>
            </map>
        </field>
    </record>

</odoo>
