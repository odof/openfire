<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sale_view_order_form" model="ir.ui.view">
        <field name="name">of.custom.document.sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="of_sale.of_sale_view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='of_price_printing']" position="before">
                <field name="of_custom_document_ids" widget="many2many_tags" />
            </xpath>
        </field>
    </record>

</odoo>
