<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="email_compose_message_wizard_form" model="ir.ui.view">
        <field name="name">of.mail.compose.message.form</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='res_id']" position="after">
                <field name="of_reply_to" force_save="1" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
