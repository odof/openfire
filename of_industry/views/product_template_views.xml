<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="before">
                <page string="Technical Data" name="technical_data">
                    <group>
                        <field name="of_industry_id" class="oe_inline"/>
                        <field name="of_code" invisible="1"/>
                    </group>
                    <group>
                        <group name="standard" string="Standard &amp; Qualification" invisible="1"/>
                        <group name="performance" string="Performance Indicator" invisible="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_search" model="ir.ui.view">
        <field name="name">product.template.view.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="of_industry_id"/>
            </xpath>
        </field>
    </record>

</odoo>
