<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="view_category_property_form" model="ir.ui.view">
        <field name="name">product.category.property.form.industry</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="account.view_category_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_account_income_categ_id']/.." position="after">
                <group string="Analytic" name="industry-analytic">
                    <field name="of_industry_id" />
                </group>
            </xpath>
        </field>
    </record>

    <record id="product_category_view_tree" model="ir.ui.view">
        <field name="name">product.category.view.tree</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="of_industry_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="product_category_view_search" model="ir.ui.view">
        <field name="name">product.category.view.search</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="of_industry_id"/>
            </xpath>
        </field>
    </record>

</odoo>
