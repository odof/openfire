<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="report_invoice_document_with_payments"
        inherit_id="account.report_invoice_document"
    >
        <xpath expr="//t[@t-foreach='payments_vals']/tr/td" position="replace">
            <td>
                <i class="oe_form_field text-end oe_payment_label"><small t-esc="payment_vals.get('extra_info')"/></i>
            </td>
        </xpath>
    </template>

</odoo>
