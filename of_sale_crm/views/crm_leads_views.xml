<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_crm_case_kanban_view_leads" model="ir.ui.view">
        <field name="name">of.sale.crm.lead.kanban.lead</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">

            <!-- header fields -->
            <xpath expr="//kanban//field[@name='company_currency']" position="after">
                <field name="of_customer_state"/>
            </xpath>

            <!-- Kanban footer-->
            <xpath expr="//div[hasclass('oe_kanban_bottom_left')]" position="after">
                <div t-if="record.of_customer_state.raw_value == 'lead'" class="text-success">Prospect</div>
                <div t-if="record.of_customer_state.raw_value == 'customer'" class="text-success">Customer</div>
            </xpath>

        </field>
    </record>


</odoo>
