<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_crm_case_kanban_view_leads" model="ir.ui.view">
        <field name="name">of.sale.crm.lead.kanban.lead</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">

            <!-- header fields -->
            <xpath expr="//kanban//field[@name='company_currency']" position="after">
                <field name="of_customer_state"/>
            </xpath>

            <!-- Kanban footer-->
            <xpath expr="//kanban//templates//div[@class='o_kanban_footer']//field[@name='activity_ids']" position="after">
                <div class="label label-success" attrs="{'invisible': [('of_customer_state', '!=', 'lead')]}">Prospect</div>
                <div class="label label-info" attrs="{'invisible': [('of_customer_state', '!=', 'customer')]}">Customer</div>
            </xpath>

        </field>
    </record>

    <record id="of_sale_crm_lead_view_form" model="ir.ui.view">
        <field name="name">of.sale.crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="of_crm.of_crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='lead_marketing']" position="after">
                <group string="Geolocation" name="lead_geolocation" invisible="1">
                    <field name="geo_lat"/>
                    <field name="geo_lng"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
