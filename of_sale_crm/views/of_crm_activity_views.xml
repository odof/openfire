<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_crm_of_crm_activity_form_view" model="ir.ui.view">
        <field name="name">of.sale.crm.of.crm.activity.form.view</field>
        <field name="model">of.crm.activity</field>
        <field name="inherit_id" ref="of_crm.of_crm_activity_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="order_id" attrs="{'invisible':[('origin', '!=', 'sale_order')], 'required':[('origin', '=', 'sale_order')]}" />
            </xpath>
            <xpath expr="//field[@name='type_id']" position="after">
                <field name="trigger_type" attrs="{'invisible':[('origin', '!=', 'sale_order')], 'required':[('origin', '=', 'sale_order')]}"/>
            </xpath>

        </field>
    </record>

    <!-- This form view is used for the O2M in the Sale -->
    <record id="of_crm_activity_from_sale_form_view" model="ir.ui.view">
        <field name="name">of.crm.activity.sale.form.view</field>
        <field name="model">of.crm.activity</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form>
                <field name="load_attachment" invisible="1"/>
                <field name="uploaded_attachment_id" invisible="1"/>
                <field name="active" invisible="1"/>
                <header>
                    <button name="action_button_add_attachment" icon="fa-upload" type="object" string="Add attachment"  attrs="{'invisible': ['|', ('load_attachment', '=', False), ('uploaded_attachment_id', '!=', False)]}"/>
                    <button name="action_button_plan" string="Plan" type="object" states="cancelled,done"/>
                    <button name="action_button_complete" string="Realize" type="object" class="oe_highlight" attrs="{'invisible': [('state', '!=', 'planned')]}"/>
                    <button name="action_button_cancel" string="Cancel" type="object" class="btn-link" attrs="{'invisible': [('state', '!=', 'planned')]}"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <button name="action_button_toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                        <div class="o_stat_info o_field_widget" attrs="{'invisible': [('active', '=', False)]}">
                            <span class="text-danger">Archive</span>
                        </div>
                        <div class="o_stat_info o_field_widget" attrs="{'invisible': [('active', '=', True)]}">
                            <span class="text-success">Unarchive</span>
                        </div>
                    </button>
                    <group>
                        <field name="order_id" invisible="1"/>
                        <field name="is_late" invisible="1"/>
                        <group>
                            <field name="type_id" domain="['|', ('of_object', '=', 'sale.order'), ('of_object', '=', False)]"/>
                            <field name="trigger_type" required="1"/>
                            <field name="title"/>
                        </group>
                        <group>
                            <field name="origin" invisible="1"/>
                            <field name="deadline_date"/>
                            <field name="user_id"/>
                            <field name="vendor_id" string="Assigned to"/>
                        </group>
                        <group name="description" string="Description" colspan="4">
                            <field name="description" nolabel="1"/>
                        </group>
                        <group name="report" string="Report" colspan="4">
                            <field name="report" nolabel="1"/>
                        </group>
                        <group name="cancellation_reason" string="Reason for cancellation" colspan="4">
                            <field name="cancel_reason" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view for the CRM activities of Sales Order -->
    <record id="of_sale_crm_of_crm_activity_sale_tree_view" model="ir.ui.view">
        <field name="name">of.sale.crm.of.crm.activity.sale.tree.view</field>
        <field name="model">of.crm.activity</field>
        <field name="inherit_id" ref="of_crm.of_crm_activity_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='uploaded_attachment_id']" position="after">
                <field name="order_id"/>
            </xpath>
        </field>
    </record>

    <record id="of_sale_crm_of_crm_activity_search_view" model="ir.ui.view">
        <field name="name">of.sale.crm.of.crm.activity.search.view</field>
        <field name="model">of.crm.activity</field>
        <field name="inherit_id" ref="of_crm.of_crm_activity_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='opportunity_id']" position="after">
                <field name="order_id"/>
            </xpath>
            <xpath expr="//filter[@name='opportunity']" position="after">
                <field name="order_id"/>
            </xpath>
        </field>
    </record>

    <record id="of_crm_activity_sale_action" model="ir.actions.act_window">
        <field name="name">Activities</field>
        <field name="res_model">of.crm.activity</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="view_id" ref="of_sale_crm_of_crm_activity_sale_tree_view"/>
        <field name="search_view_id" ref="of_sale_crm_of_crm_activity_search_view"/>
        <field name="context">{'default_origin': 'sale_order', 'search_default_sale_activities': 1, 'active_test': False}</field>
    </record>

    <menuitem id="of_crm_activity_sale_menu" name="Activities" action="of_crm_activity_sale_action" parent="sale.sale_menu_root" sequence="15"/>

</odoo>
