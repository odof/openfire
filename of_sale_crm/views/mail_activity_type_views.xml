<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_crm_mail_activity_type_view_form" model="ir.ui.view">
        <field name="name">of.sale.crm.mail.activity.type.view.form</field>
        <field name="model">mail.activity.type</field>
        <field name="inherit_id" ref="of_crm.of_mail_activity_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='of_team_id']" position="after">
                <field name="of_user_assignment" attrs="{'invisible':[('of_object', '!=', 'sale.order')]}"/>
                <field name="of_user_id"  attrs="{
                    'required':[('of_user_assignment', '=', 'specific_user')],
                    'invisible':[('of_object', '=', 'sale.order'),('of_user_assignment', '!=', 'specific_user')]}" />
            </xpath>
        </field>
    </record>

</odoo>
