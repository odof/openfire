<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="of_sale_crm_view_order_form" model="ir.ui.view">
            <field name="name">of.sale.crm.sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="/form/header/button[@name='action_cancel']" position="replace">
                    <button name="action_cancel" type="object" string="Cancel"
                    attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'sent','sale']),
                    ('id', '=', False)]}"
                    data-hotkey="z"/>
                </xpath>
                <xpath expr="/form/header/field[@name='state']" position="attributes">
                    <attribute name="groups">of_sale_crm.group_of_estimate_sale_order_state,!of_sale_crm.group_of_quotation_sale_order_state</attribute>
                </xpath>
                <xpath expr="/form/header/field[@name='state']" position="after">
                    <field name="state" invisible="1"/>  <!--  Keep on field always invisible, to avoid missing fields in {'invisible': [('state', ..., ...)]}  -->
                    <field name="state" widget="statusbar" statusbar_visible="sent,sale" groups="of_sale_crm.group_of_quotation_sale_order_state,!of_sale_crm.group_of_estimate_sale_order_state"/>
                </xpath>
                <xpath expr="//button[1]" position="after">
                    <button name="action_button_confirm_estimate" string="Confirm Estimate" type="object" states="draft" class="btn-primary"/>
                </xpath>
                <xpath expr="//div[hasclass('oe_title')]/h1" position="inside">
                    <field name="of_customer_view" invisible ="1"/>
                    <field name="of_priority" widget="priority" attrs="{'invisible': [('of_customer_view', '=', True)]}"/>
                </xpath>
                <xpath expr="//group[@name='sales_person']//field[@name='user_id']" position="after">
                    <field name="of_canvasser_id"/>
                </xpath>
                <xpath expr="//page[2]" position="after">
                    <page string="Follow-up" name="followup">
                    <group>
                        <group string="Followup">
                            <field name="origin"/>
                            <!--  Display field  opportunity outside developer mode -->
                            <field name='opportunity_id' groups="sales_team.group_sale_salesman"/>
                            <field name="of_sale_followup_tag_ids" widget="many2many_tags"/>
                            <field name="of_info"/>
                        </group>
                        <group string="Marketing">
                            <field name="of_referred_id"/>
                            <field name="campaign_id" options="{'create_name_field': 'title', 'always_reload': True}"/>
                            <field name="medium_id"/>
                            <field name="source_id"/>
                        </group>
                        <group string="Follow-up notes" name="followup_notes">
                            <field name="of_notes" colspan="2" nolabel="1"/>
                        </group>
                        <group  string="Project dates">
                                <field name="of_reference_laying_date" attrs="{'invisible': [('of_force_laying_date', '!=', False)]}"/>
                                <field name="of_manual_laying_date" attrs="{'invisible': [('of_force_laying_date', '=', False)]}"/>
                                <field name="of_force_laying_date"/>
                                <field name="of_laying_week"/>
                        </group>
                        <group string="Customer notes" name="customer_notes" attrs="{'invisible':[('of_customer_notes','=',False)]}">
                            <field name="of_customer_notes" colspan="2" nolabel="1"/>
                            <div class="text-muted" colspan="2">
                                * These notes come from the customer's file. They can only be modified in the customer form.
                            </div>
                        </group>
                    </group>
                    </page>
                </xpath>
                <xpath expr="//group[@name='technical']" position="replace"/>
                <xpath expr="//group[@name='utm_link']" position="replace"/>
            </field>
        </record>

        <record id="of_crm_sale_order_quotation_form_view" model="ir.ui.view">
            <field name="name">of.crm.sale.order.quotation.form.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_crm.sale_view_inherit123"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='opportunity_id']" position="replace"/>
            </field>
        </record>


        <record id="of_crm_sale_order_search_view" model="ir.ui.view">
            <field name="name">of.crm.sale.order.search.view</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='draft']" position="replace">
                    <filter string="Estimates" name="draft" domain="[('state', '=', 'draft')]" groups="!of_sale_crm.group_of_quotation_sale_order_state"/>
                    <filter string="Quotations" name="draft" domain="[('state', '=', 'sent')]" groups="of_sale_crm.group_of_quotation_sale_order_state"/>
                    <filter string="Sent Quotations" name="sent" domain="[('of_sent_quotation', '=', True)]"/>
                    <filter string="Quotations" name="quotation" domain="[('state', '=', 'sent')]" groups="!of_sale_crm.group_of_quotation_sale_order_state"/>
                </xpath>
            </field>
        </record>

        <record id="of_crm_of_sale_order_line_tree" model="ir.ui.view">
            <field name="name">of.crm.of.sale.order.line.tree</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="of_sale.of_sale_order_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price_subtotal']" position="after">
                    <field name="of_amount_to_invoice"/>
                </xpath>
            </field>
        </record>

</odoo>
