<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_crm_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.sale.crm.res.config.settings.view.form.sale</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="of_sale.of_sale_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='of_sale_confirmation_date_mode']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="of_sale_confirmation_date_mode">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_sale_order_start_state"/>
                        <div class="text-muted">
                            <p>Choose the start state for sale order.</p>
                        </div>
                        <div class="mt16">
                            <field name="of_sale_order_start_state" class="o_light_label" widget="radio" style="display: inline;" />
                            <field name="group_of_estimate_sale_order_state" class="oe_inline" invisible="1"/>
                            <field name="group_of_quotation_sale_order_state" class="oe_inline" invisible="1"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
