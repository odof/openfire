<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="compute_date_sale_confirmation" model="of.crm.compute.date">
        <field name="name">Customer Order confirmation date</field>
        <field name="res_model">sale.order</field>
        <field name="sequence">1</field>
        <field name="res_field">confirmation_date</field>
    </record>

    <record id="compute_date_sale_ref_installation_date" model="of.crm.compute.date">
        <field name="name">Reference installation date</field>
        <field name="res_model">sale.order</field>
        <field name="sequence">20</field>
        <field name="res_field">of_reference_laying_date</field>
    </record>

    <record id="compute_date_sale_est_installation_date" model="of.crm.compute.date">
        <field name="name">Estimated installation date</field>
        <field name="res_model">sale.order</field>
        <field name="sequence">30</field>
        <field name="res_field">of_date_pose</field>
    </record>

    <record id="compute_date_sale_tech_visit_date" model="of.crm.compute.date">
        <field name="name">Technical visit date</field>
        <field name="res_model">sale.order</field>
        <field name="sequence">40</field>
        <field name="res_field">of_date_vt</field>
    </record>

</odoo>
