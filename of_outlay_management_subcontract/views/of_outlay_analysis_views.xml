<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_outlay_analysis_form" model="ir.ui.view">
        <field name="name">of.outlay.analysis.form</field>
        <field name="model">of.outlay.analysis</field>
        <field name="inherit_id" ref="of_outlay_management.of_outlay_analysis_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_line_ids']/tree/field[@name='line_type']" position="before">
                <field name="of_subcontracted_service" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='sale_line_cost_ids']/tree/field[@name='line_type']" position="before">
                <field name="of_subcontracted_service" readonly="1"/>
            </xpath>
            <form>
                <header>
                    <button name="action_open" type="object" states="closed" string="Rouvrir"/>
                    <button name="action_close" type="object" states="open" string="Fermer"/>
                    <button name="action_recompute_lines" type="object" states="open" string="Recalculer les lignes"/>
                    <button name="action_recompute_values" type="object" states="open" string="Recalculer les valeurs"/>
                    <field name="state" widget="statusbar" statusbar_visible="open" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(of_outlay_management.of_outlay_analysis_value_action)d"
                            type="action"
                            class="oe_stat_button"
                            icon="fa-line-chart"
                            domain="[('analysis_id', '=', self)]"
                            attrs="{'invisible': [('sale_ids', '=', [])]}">
                            <span>Graphe des valeurs</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="analytic_account_ids" widget="many2many_tags"/>
                        <field name="sales_total"/>
                        <field name="expected_margin_pct"/>
                    </group>
                    <group>
                        <group string="Sources produits" name="sale_shipping">
                            <field name="sale_ids" widget="many2many_tags" invisible="1"/>
                            <field name="sale_init_ids" widget="many2many_tags"/>
                            <field name="sale_compl_ids" widget="many2many_tags"/>
                            <field name="out_invoice_ids" widget="many2many_tags"/>
                            <field name="all_income_move_ids" widget="many2many_tags" invisible="1"/>
                            <field name="income_move_ids" widget="many2many_tags"/>
                            <field name="all_income_journal_ids" widget="many2many_tags" invisible="1"/>
                            <field name="income_journal_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Sources charges">
                            <field name="purchase_ids" widget="many2many_tags"/>
                            <field name="in_invoice_ids" widget="many2many_tags"/>
                            <field name="expense_move_ids" widget="many2many_tags" invisible="1"/>
                            <field name="expense_move_ids" widget="many2many_tags"/>
                            <field name="expense_journal_ids" widget="many2many_tags" invisible="1"/>
                            <field name="expense_journal_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Synthèse">
                            <group string="Synthèse globale">
                                <!-- La zone de Paul -->
                            </group>
                            <group string="Synthèse par section analytique">
                                <field name="line_ids" nolabel="1" colspan="2"/>
                            </group>
                        </page>
                        <page string="Produits">
                            <field name="sale_line_ids" nolabel="1">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="of_outlay_analysis_selected"/>
                                    <field name="order_id" readonly="1"/>
                                    <field name="date_order" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="of_order_project_id" readonly="1"/>
                                    <field name="of_analytic_section_id" readonly="1"/>
                                    <field name="product_uom_qty" readonly="1"/>
                                    <field name="qty_delivered" readonly="1"/>
                                    <field name="qty_invoiced" readonly="1"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="purchase_price" readonly="1"/>
                                    <field name="price_subtotal" readonly="1"/>
                                    <field name="of_purchase_price_subtotal" readonly="1"/>
                                    <field name="of_subcontracted_service" readonly="1"/>
                                    <field name="of_outlay_analysis_type" readonly="1"/>
                                </tree>
                            </field>

                        </page>
                        <page string="Charges">
                            <label for="sale_line_cost_ids"/>
                            <field name="sale_line_cost_ids" nolabel="1">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="of_outlay_analysis_cost_selected"/>
                                    <field name="order_id" readonly="1"/>
                                    <field name="date_order" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="of_order_project_id" readonly="1"/>
                                    <field name="of_analytic_section_id" readonly="1"/>
                                    <field name="product_uom_qty" readonly="1"/>
                                    <field name="purchase_price" readonly="1"/>
                                    <field name="of_purchase_price_subtotal" readonly="1"/>
                                    <field name="of_subcontracted_service" readonly="1"/>
                                    <field name="of_outlay_analysis_type" readonly="1"/>
                                </tree>
                            </field>
                            <separator string="Charges réelles" nolabel="1"/>
                            <field name="purchase_line_ids" nolabel="1" colspan="2">
                                <tree editable="bottom" create="false">
                                    <field name="of_outlay_analysis_selected"/>
                                    <field name="order_id" readonly="1"/>
                                    <field name="date_order" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="account_analytic_id" readonly="1"/>
                                    <field name="of_analytic_section_id"/>
                                    <field name="product_qty" readonly="1"/>
                                    <field name="qty_received" readonly="1"/>
                                    <field name="qty_invoiced" readonly="1"/>
                                    <field name="price_unit" readonly="1"/>
                                    <field name="price_subtotal" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_outlay_analysis_action" model="ir.actions.act_window">
        <field name="name">Analyse des débours</field>
        <field name="res_model">of.outlay.analysis</field>
        <field name="view_type">form</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Analyse des débours" id="of_outlay_analysis_menu" parent="sales_team.menu_sale_report" sequence="15"
              action="of_outlay_analysis_action"/>

</odoo>
