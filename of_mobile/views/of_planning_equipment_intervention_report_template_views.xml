<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_equipment_intervention_report_template_view_form" model="ir.ui.view" >
        <field name="name">of.equipment.intervention.report.template.view.form</field>
        <field name="model">of.equipment.intervention.report.template</field>
        <field name="inherit_id" ref="of_equipment.of_equipment_intervention_report_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <div class="oe_button_box" name="button_box">
                    <button name="action_button_toggle_mobile" type="object" class="oe_stat_button" icon="fa-android">
                        <field name="mobile" invisible="1"/>
                        <div class="o_stat_info o_field_widget">
                            <span class="text-success" attrs="{'invisible': [('mobile', '=', False)]}">Mobile</span>
                            <span class="text-danger" attrs="{'invisible': [('mobile', '=', True)]}">Mobile</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="after">
                <separator string="Additional Products" />
                <field name="additional_line_ids" >
                    <tree editable="bottom">
                        <field name="product_id" context="{'default_of_mobile_available': True}"/>
                        <field name="price_unit"/>
                    </tree>
                </field>
            </xpath>

        </field>
    </record>

</odoo>
