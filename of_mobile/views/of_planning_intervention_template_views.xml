<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_intervention_template_view_form" model="ir.ui.view" >
        <field name="name">of.planning.intervention.template.view.form</field>
        <field name="model">of.planning.intervention.template</field>
        <field name="inherit_id" ref="of_planning.of_planning_intervention_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <div class="oe_button_box" name="button_box">
                    <button name="action_button_toggle_mobile" type="object" class="oe_stat_button" icon="fa-android">
                        <field name="mobile" invisible="1"/>
                        <div class="o_stat_info o_field_widget">
                            <span class="text-success" attrs="{'invisible': [('mobile', '=', False)]}">Mobile</span>
                            <span class="text-danger" attrs="{'invisible': [('mobile', '=', True)]}">Mobile</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <xpath expr="//notebook/page[@name='configuration']/group" position="inside">
                <field name="section_to_display_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
            </xpath>
            <field name="line_ids" position="after">
                <separator string="Additional Products" />
                <field name="additional_line_ids" >
                    <tree editable="bottom">
                        <field name="product_id" context="{'default_of_mobile_available': True}"/>
                        <field name="price_unit"/>
                    </tree>
                </field>
            </field>
        </field>
    </record>

</odoo>
