<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_service_request_view_form" model="ir.ui.view" >
        <field name="name">of.service.request.view.form</field>
        <field name="model">of.service.request</field>
        <field name="inherit_id" ref="of_service.of_service_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_button_toggle_mobile" type="object" class="oe_stat_button" icon="fa-android">
                    <field name="mobile" invisible="1"/>
                    <div class="o_stat_info o_field_widget">
                        <span class="text-success" attrs="{'invisible': [('mobile', '=', False)]}">Mobile</span>
                        <span class="text-danger" attrs="{'invisible': [('mobile', '=', True)]}">Mobile</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="action_mass_toggle_mobile" model="ir.actions.server">
        <field name="name">Activate SR on mobile</field>
        <field name="model_id" ref="of_service.model_of_service_request" />
        <field name="binding_model_id" ref="of_service.model_of_service_request"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_mass_toggle_mobile()</field>
    </record>

</odoo>
