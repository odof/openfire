<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="of_type"/>
                <field name="of_intervention_id" attrs="{'invisible': [('of_intervention_id','=',False)]}"/>
                <field name="of_intervention_invoice_id" attrs="{'invisible': [('of_intervention_id','=',False)]}"/>
                <field name="of_sale_id" attrs="{'invisible': [('of_sale_id','=',False)]}"/>
                <field name="of_sale_invoice_id" attrs="{'invisible': [('of_sale_id','=',False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
