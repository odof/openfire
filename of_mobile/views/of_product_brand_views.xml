<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_product_brand_view_form" model="ir.ui.view" >
        <field name="name">of.product.brand.view.form</field>
        <field name="model">of.product.brand</field>
        <field name="inherit_id" ref="of_product_brand.of_product_brand_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_button_toggle_mobile" type="object" class="oe_stat_button" icon="fa-android">
                    <field name="of_mobile_available" invisible="1"/>
                    <div class="o_stat_info o_field_widget">
                        <span class="text-success" attrs="{'invisible': [('of_mobile_available', '=', False)]}">Mobile</span>
                        <span class="text-danger" attrs="{'invisible': [('of_mobile_available', '=', True)]}">Mobile</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
