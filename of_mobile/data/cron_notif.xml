<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_send_external_notif" model="ir.cron">
        <field name="name">Mobile : Send External Notif</field>
        <field name="active" eval="True" />
        <field name="model_id" ref="of_mobile.model_bus_bus" />
        <field name="state">code</field>
        <field name="code">model.send_external_notif()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(DateTime.today()).strftime('%Y-%m-%d')" />
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root" />
    </record>

</odoo>
