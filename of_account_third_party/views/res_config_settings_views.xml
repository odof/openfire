<?xml version="1.0"?>
<odoo>

        <record id="of_account_third_party_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">of.account.third.party.res.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="of_account.of_account_res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@name='main_currency_setting_container']" position="after">
                    <h2>Accounts</h2>
                    <div class="row mt16 o_settings_container" id="of_account_settings">
                        <div class="col-12 o_searchable_setting o_setting_box" id="of_partners_codes">
                            <div class="o_setting_left_pane" />
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">(OF) Partners code</span>
                                <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img" />
                                <div class="text-muted">
                                    Drafting the code "template" for partners
                                </div>
                                <div class="mt16">
                                    <div class="content-group">
                                        <label for="of_customer_code">Customer code</label>
                                        <div>
                                            <field name="of_customer_code" />
                                        </div>
                                        <label for="of_supplier_code">Supplier code</label>
                                        <div>
                                            <field name="of_supplier_code" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

</odoo>
