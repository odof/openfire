<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_account_payment_form_view" model="ir.ui.view">
        <field name="name">of.account.payment.form.view</field>
        <field name="model">account.payment</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="of_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"/>
                <field name="sale_id" />
                <field name="of_payment_mode_id"/>
                <field name="of_ref_reglement"/>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="of_account_payment_form_inherit_payment" model="ir.ui.view">
        <field name="name">of.account.payment.form.inherit.payment</field>
        <field name="model">account.payment</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="account_payment.view_account_payment_form_inherit_payment"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_transaction_id']" position="after">
                <field name="company_id" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>

</odoo>
