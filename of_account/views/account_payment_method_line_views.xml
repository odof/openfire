<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="account_payment_method_line_view_form" model="ir.ui.view">
        <field name="name">account.payment.method.line.view.form</field>
        <field name="model">account.payment.method.line</field>
        <field name="arch" type="xml">
            <form string="Payment Methods">
                <sheet>
                    <group>
                        <group>
                            <field name="payment_type" invisible="1"/>
                            <field name="available_payment_method_ids" invisible="1"/>
                            <field name="payment_method_id" options="{'no_create': True, 'no_open': True}" string="Payment Method"/>
                            <field name="name" string="Payment Mode Name"/>
                            <field name="payment_account_id"
                                options="{'no_quick_create': True}"
                                groups="account.group_account_readonly"
                                string="Waiting Payment Account"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="journal_id" readonly="1"/>
                            <field name="payment_type" />
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
