<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_account_journal_form_view" model="ir.ui.view">
        <field name="name">account.journal.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='restrict_mode_hash_table']" position="before">
                <field name="of_is_current_user_admin" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='restrict_mode_hash_table']" position="attributes">
                <attribute name="groups"></attribute>
                <attribute name="attrs">{'invisible':[('of_is_current_user_admin','=',False),('type','in',('sale','cash','bank'))]}</attribute>
            </xpath>

            <xpath expr="//field[@name='inbound_payment_method_line_ids']" position="attributes">
                <attribute name="context" operation="update">{
                    "default_journal_id": active_id,
                }</attribute>
            </xpath>
            <xpath expr="//field[@name='inbound_payment_method_line_ids']/tree" position="attributes">
                <attribute name="editable"/>
            </xpath>
            <xpath expr="//field[@name='outbound_payment_method_line_ids']/tree" position="attributes">
                <attribute name="editable"/>
            </xpath>
        </field>
    </record>

</odoo>
