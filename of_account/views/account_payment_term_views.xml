<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_account_payment_term_form" model="ir.ui.view">
        <field name="name">of.account.payment.term.form</field>
        <field name="model">account.payment.term</field>
        <field name="inherit_id" ref="account.view_payment_term_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="of_balance_invoice_payment_term_id"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/tree/field[@name='value']" position="before">
                <field name="of_name" required="1"/>
            </xpath>
        </field>
    </record>

</odoo>
