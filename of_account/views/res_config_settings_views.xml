<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_account_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.account.res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="41"/>  <!-- parent view has priority 40 -->
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']//field[@name='account_use_credit_limit']/../.." position="after">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_default_deposit_payment_term_id"/>
                        <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." role="img"/>
                        <div class="text-muted">
                            Set a default payment term for deposits invoices (e.g. 50% on order, 50% on delivery).
                            This payment terms will replace that of the order when the deposit invoice is created.
                        </div>
                        <div class="content-group mt-2">
                            <div class="row">
                                <field name="of_default_deposit_payment_term_id"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
