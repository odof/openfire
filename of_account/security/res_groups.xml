<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_account_can_modify_account_with_entry_lines" model="res.groups">
        <field name="name">(OF) Can modify account with entry lines</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


    <!--
        For an easier use and a cleaner module dependency, we create this group in this module
            instead of in of_sale_margin to avoid an anormal dependency between of_sale_margin and of_purchase_stock
    -->
    <record model="ir.module.category" id="of_account_sale_margin_category">
        <field name="name">OF Margin</field>
        <field name="description">Defines access rights to margins.</field>
        <field name="sequence">92</field>
        <field name="parent_id" ref="base.module_category_sales"/>
    </record>

    <record id="of_group_sale_margin_manager" model="res.groups">
        <field name="name">Responsible</field>
        <field name="category_id" ref="of_account_sale_margin_category" />
    </record>

</odoo>
