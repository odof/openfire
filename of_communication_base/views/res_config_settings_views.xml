<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">Communication Setting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Communication OpenFire" string="Communication OpenFire" data-key="of_communication_base">
                    <h2>Communication Internal</h2>
                    <div class="row mt16 o_settings_container" name="communication_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="communication_option">
                            <div class="o_setting_left_pane">
                                <field name="group_internal_communication"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="group_internal_communication"/>
                                <div class="text-muted">
                                    Enable or disable the ability for everyone to view messages sent by the company to this employee
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="of_communication_action_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'of_communication_base', 'bin_size': False}</field>
    </record>

</odoo>
