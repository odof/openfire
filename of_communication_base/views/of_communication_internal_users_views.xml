<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_communication_internal_user_message_tree_views" model="ir.ui.view">
        <field name="name">Communication Internal User Message Tree</field>
        <field name="model">of.communication</field>
        <field name="groups_id" eval="[(4, ref('group_of_internal_message'))]"/>
        <field name="arch" type="xml">
            <tree string="Tree Message" create="false" delete="false" export_xlsx="false">
                <field name="date"/>
                <field name="name"/>
                <field name="message_type" optional="show"/>
                <field name="summary" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="of_communication_internal_user_message_form_views" model="ir.ui.view">
        <field name="name">Communication Internal User Message Form</field>
        <field name="model">of.communication</field>
        <field name="groups_id" eval="[(4, ref('group_of_internal_message'))]"/>
        <field name="arch" type="xml">
            <form string="Form Message" create="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date" readonly="1"/>
                            <field name="message_type"/>
                        </group>
                        <group>
                            <field name="end_scheduled_publication"/>
                            <field name="end_message" attrs="{'invisible': [('end_message', '=', False)]}"/>
                        </group>
                        <notebook>
                            <page string="Message">
                                <group>
                                    <field name="summary"/>
                                    <field name="message" attrs="{'invisible': [('message', '=', False)]}"/>
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="of_communication_internal_user_message_search" model="ir.ui.view">
        <field name="name">Communication Internal User Message Search</field>
        <field name="model">of.communication</field>
        <field name="groups_id" eval="[(4, ref('group_of_internal_message'))]"/>
        <field name="arch" type="xml">
            <search string="Search Message">
                <filter name="filter_informative_message" string="Informative Message" domain="[('message_type', '=', 'informative_message')]"/>
                <filter name="filter_patch_note" string="Patch Note" domain="[('message_type', '=', 'patch_note')]"/>
                <filter name="filter_non-critical_alert_message" string="Non-Critical Alert Message" domain="[('message_type', '=', 'non-critical_alert_message')]"/>
                <filter name="filter_critical_alert_message" string="Critical Alert Message" domain="[('message_type', '=', 'critical_alert_message')]"/>
                <group>
                    <filter name="filter_group_message_type" string="Type" context="{'group_by': 'message_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="of_communication_internal_user_action" model="ir.actions.act_window">
        <field name="name">Communication Internal User</field>
        <field name="res_model">of.communication</field>
        <field name="view_mode">tree,form</field>
        <field name="groups_id" eval="[(4, ref('group_of_internal_message'))]"/>
        <field name="search_view_id" ref="of_communication_internal_user_message_search"/>
        <field name="domain">[('is_internal', '=', True), ('state', '=', 'published')]</field>
        <field name="context">{'default_is_internal': True}</field>
    </record>

    <record id="of_communication_internal_user_message_action_tree_views" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="of_communication_internal_user_message_tree_views"/>
        <field name="act_window_id" ref="of_communication_internal_user_action"/>
    </record>

    <record id="of_communication_internal_user_message_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="of_communication_internal_user_message_form_views"/>
        <field name="act_window_id" ref="of_communication_internal_user_action"/>
    </record>


</odoo>
