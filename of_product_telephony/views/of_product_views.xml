<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_product_template_form_view" model="ir.ui.view">
        <field name="name">of.product.telephony.product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="of_product.of_product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='technique']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//page[@name='technique']" position="inside">
                <group name="technique_telephony">
                    <group>
                        <field name="of_is_telecom"/>
                        <field name="of_telecom_type" attrs="{'invisible': [('of_is_telecom', '=', False)], 'required': [('of_is_telecom', '=', True)]}"/>
                        <field name="of_optical_fiber_type" attrs="{'invisible': [('of_telecom_type', '!=', 'internet')]}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
