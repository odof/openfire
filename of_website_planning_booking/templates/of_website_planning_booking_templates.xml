<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="booking" name="Prise de RDV en ligne">
        <t t-call="of_website_planning_booking.booking_survey_layout">
            <div id="wrap">
                <div class="oe_structure"/>
                <div class="container of_booking of_booking_main mb40">
                    <div class="page o_cc o_cc2 mt40 bg-transparent">
                        <h1 t-att-class="'col-10 border-bottom mt40 pb-2 ' + ((not logged) and 'mb-4' or 'mb-5')">
                            Make an appointment
                        </h1>
                        <div class="clearfix"/>
                        <div t-if="not logged" class="col-12 mb-4">
                            <p>
                                Are you already a customer? Do not hesitate to <a href="/web/login?redirect=/booking">log in</a> to retrieve your information.
                            </p>
                        </div>
                        <input type="hidden" id="logged_partner_id" name="logged_partner_id" t-att-value="logged_partner_id"/>
                        <div class="clearfix"/>
                        <div class="card mb-4" id="service_card">
                            <div class="card-header" role="tab">
                                <div class="card-title">
                                    <a class="collapsed text-decoration-none" role="button" data-bs-toggle="collapse" data-bs-target="#myCollapseTabBookingService" aria-expanded="false">
                                        <h2>Service</h2>
                                    </a>
                                </div>
                            </div>
                            <div class="collapse" id="myCollapseTabBookingService" aria-expanded="false" style="height: 0px;">
                                <div class="card-body row gx-0 pb40">
                                    <div class="form-group col-lg-7">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="service_id">
                                            <strong>Service</strong>
                                        </label>
                                        <select id="service_id" name="service_id" class="form-select">
                                            <option value="">Service selection...</option>
                                            <t t-foreach="service_list" t-as="s">
                                                <option t-att-value="s['id']"
                                                    t-att-data-fixed="s['fixed']"
                                                    t-att-data-survey-id="s['survey_id']">
                                                    <t t-esc="s['name']"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="clearfix"/>
                                    <div t-if="logged_partner_id > 0 and contract_list" class="mt40" name="buttons">
                                        <div class="float-end">
                                            <button class="btn btn-secondary" id="my_contracts">
                                                My contracts
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"/>
                        <div class="card mb-4" id="contract_card" style="display: none;">
                            <div class="card-header" role="tab">
                                <div class="card-title">
                                    <a class="collapsed text-decoration-none" role="button" data-bs-toggle="collapse" data-bs-target="#myCollapseTabBookingContract" aria-expanded="false">
                                        <h2>Contract</h2>
                                    </a>
                                </div>
                            </div>
                            <div class="collapse" id="myCollapseTabBookingContract" aria-expanded="false" style="height: 0px;">
                                <div class="card-body row gx-0 pb40">
                                    <div class="form-group col-lg-7">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="contract_id">
                                            <strong>Contract</strong>
                                        </label>
                                        <select id="contract_id" name="contract_id" class="form-select">
                                            <option value="">Contract selection...</option>
                                            <t t-foreach="contract_list" t-as="c">
                                                <option t-att-value="c['id']">
                                                    <t t-esc="c['name']"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="clearfix"/>
                                    <div class="mt40" name="buttons">
                                        <div class="float-end">
                                            <button class="btn btn-secondary" id="other_services">
                                                Other services
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"/>
                        <div class="card mb-4" id="address_card" style="display: none;">
                            <div class="card-header" role="tab">
                                <div class="card-title">
                                    <a class="collapsed text-decoration-none" role="button" data-bs-toggle="collapse" data-bs-target="#myCollapseTabBookingAddress" aria-expanded="false">
                                        <h2>Address and contact details</h2>
                                    </a>
                                </div>
                            </div>
                            <div class="collapse" id="myCollapseTabBookingAddress" aria-expanded="false" style="height: 0px;">
                                <div class="card-body row gx-0 pb40">
                                    <div id="address_select" class="col-12 pb-4 border-bottom">
                                        <div class="form-group col-md-8 col-xs-12 float-start" style="padding-left: 0; padding-right: 0;">
                                            <label class="col-form-label col-sm-auto s_website_form_label" for="adress_id">
                                                <strong>Address</strong>
                                            </label>
                                            <select id="address_id" name="address_id" class="form-select">
                                                <option value="">Address selection...</option>
                                                <t t-foreach="address_list" t-as="a">
                                                    <option t-att-value="a['id']">
                                                        <t t-esc="a['name']"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                        <div class="clearfix" />
                                        <div class="mt40 mb8" name="buttons">
                                            <div class="float-end">
                                                <button class="btn btn-secondary" id="new_address">
                                                    New address
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="clearfix"/>
                                    <div class="form-group col-lg-5" id="div_name">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="name">
                                            <strong>LASTNAME Firstname *</strong>
                                        </label>
                                        <input type="text" id="name" name="name" class="form-control"/>
                                    </div>
                                    <div class="clearfix"/>
                                    <div class="form-group col-lg-5" id="div_email">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="email">
                                            <strong>E-mail *</strong>
                                        </label>
                                        <input type="email" id="email" name="email" class="form-control"/>
                                    </div>
                                    <div class="form-group col-lg-5" id="div_phone">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="phone">
                                            <strong>Phone *</strong>
                                        </label>
                                        <input type="tel" id="phone" name="phone" class="form-control"/>
                                    </div>
                                    <div class="clearfix"/>
                                    <div class="form-group col-lg-10" id="div_street" name="div_street">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="street">
                                            <strong>Street (and number) *</strong>
                                        </label>
                                        <input type="text" id="street" name="street" class="form-control"/>
                                    </div>
                                    <div class="clearfix"/>
                                    <div class="form-group col-lg-10" id="div_street2" name="div_street2">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="street2">
                                            <strong>Additional</strong>
                                        </label>
                                        <input type="text" id="street2" name="street2" class="form-control"/>
                                    </div>
                                    <div class="clearfix"/>
                                    <div class="form-group col-lg-3" id="div_zip" name="div_zip">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="zip">
                                            <strong>Zip *</strong>
                                        </label>
                                        <input type="text" id="zip" name="zip" class="form-control"/>
                                    </div>
                                    <div class="form-group col-lg-7" id="div_city" name="div_city">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="city">
                                            <strong>City *</strong>
                                        </label>
                                        <input type="text" id="city" name="city" class="form-control"/>
                                    </div>
                                    <div class="clearfix" />
                                    <div class="mt40" name="buttons">
                                        <div class="float-end">
                                            <button class="btn btn-primary" id="address_submit">
                                                Validate
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"/>
                        <div class="card mb-4" id="slot_card" style="display: none;">
                            <div class="card-header" role="tab">
                                <div class="card-title">
                                    <a class="collapsed text-decoration-none" role="button" data-bs-toggle="collapse" data-bs-target="#myCollapseTabBookingSlot" aria-expanded="false">
                                        <h2>Date</h2>
                                    </a>
                                </div>
                            </div>
                            <div class="collapse" id="myCollapseTabBookingSlot" aria-expanded="false" style="height: 0px;">
                                <div class="card-body row gx-0 pb40">
                                    <div class="form-group col-lg-7">
                                        <label class="col-form-label col-sm-auto s_website_form_label" for="from_date">
                                            <strong>From</strong>
                                        </label>
                                        <input type="date" id="from_date" name="from_date" class="form-control"/>
                                    </div>
                                    <div class="clearfix" />
                                    <div class="col-lg-10" id="no_slot_div" style="margin-top: 40px; display: none;">
                                        <p style='text-align: center;'>
                                            <b>No free slot matches your search, please contact your store.</b>
                                        </p>
                                    </div>
                                    <div class="row gx-0 mt40" id="slots_div" style="display: none;">
                                        <div class="row gx-0 col-lg-10">
                                            <div class="col-6 text-center float-start" style="margin-bottom: 15px;">
                                                <h4 style="margin: 0;">Morning</h4>
                                                <span>
                                                    <i>
                                                        <t t-esc="morning_hours_label"/>
                                                    </i>
                                                </span>
                                            </div>
                                            <div class="col-6 text-center float-end" style="margin-bottom: 15px;">
                                                <h4 style="margin: 0;">Afternoon</h4>
                                                <span>
                                                    <i>
                                                        <t t-esc="afternoon_hours_label"/>
                                                    </i>
                                                </span>
                                            </div>
                                            <div class="clearfix" />
                                            <div class="row gx-0 col-lg-12" id="of_booking_slots"/>
                                        </div>
                                        <div class="clearfix"/>
                                        <div class="col-lg-10 text-danger" id="slot_error" name="slot_error" style="display: none;">
                                            <label class="help-block">You must select a slot before validating.</label>
                                        </div>
                                        <div class="clearfix"/>
                                        <div class="mt40" name="buttons">
                                            <span name="buttons_right" class="float-end">
                                                <button class="btn btn-secondary search-btn" id="search_more_submit">
                                                    More...
                                                </button>
                                                <button class="btn btn-primary slot-btn" id="slot_submit">
                                                    Validate
                                                    <span class="fa fa-long-arrow-right"/>
                                                </button>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="clearfix"/>
                        <div class="card mb-4" id="survey_card" style="display: none;">
                            <div class="card-header" role="tab">
                                <div class="card-title">
                                    <a class="collapsed text-decoration-none" role="button" data-bs-toggle="collapse" data-bs-target="#myCollapseTabBookingSurvey" aria-expanded="false">
                                        <h2>Additional information</h2>
                                    </a>
                                </div>
                            </div>
                            <div class="collapse" id="myCollapseTabBookingSurvey" aria-expanded="false" style="height: 0px;">
                                <div class="card-body row gx-0 pb40" id="of_booking_survey"/>
                            </div>
                        </div>
                    </div>
                    <div class="spinner-popup" id="spinner-popup">
                        <span class="popup-text" id="popup-text" name="popup-text"/>
                        <div class="spinner">
                            <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="booking_survey_layout" name="OF Booking Survey Layout" inherit_id="website.layout" primary="True">
        <xpath expr="//head/t[@t-call-assets][last()]" position="after">
            <t t-call-assets="of_survey.survey_assets" lazy_load="True"/>
            <t t-call-assets="of_website_planning_booking.survey_assets" lazy_load="True"/>
        </xpath>
        <xpath expr="//header" position="after">
            <div id="wrap" class="oe_structure oe_empty"/>
        </xpath>
    </template>

    <template id="booking_survey_fill_form_in_progress" name="Prise de RDV en ligne - Questionnaire - Formulaire">
        <div class="o_survey_form_content_data d-none"
            t-att-data-question-time-limit-reached="False"
            t-att-data-has-answered="bool(has_answered)"
            t-att-data-is-page-description="bool(question and question.is_page and not is_html_empty(question.description))"
            t-att-data-server-time="server_time"
            t-att-data-timer="timer_start"
            t-att-data-time-limit-minutes="time_limit_minutes"/>
        <t t-if="survey.questions_layout == 'one_page'">
            <t t-foreach='survey.question_and_page_ids.filtered(lambda r: (r.is_from_planning_booking if not r.is_page else any(question.is_from_planning_booking for question in r.question_ids)))' t-as='question'>
                <h2 t-if="question.is_page" t-field='question.title' class="o_survey_title pb16 text-break" />
                <div t-if="question.is_page" t-field='question.description' class="text-break"/>
                <t t-if="not question.is_page and question in answer.predefined_question_ids" t-call="of_survey.of_question_container"/>
            </t>

            <div class="text-center mt16">
                <button type="submit" value="finish" class="btn btn-primary disabled">Submit</button>
            </div>
        </t>

        <t t-if="survey.questions_layout == 'page_per_section'">
            <h2 t-field='page.title' class="o_survey_title pb16 text-break" />
            <div t-field='page.description' class="oe_no_empty text-break"/>

            <input type="hidden" name="page_id" t-att-value="page.id" />
            <t t-foreach='page.question_ids.filtered(lambda r: r.is_from_planning_booking)' t-as='question'>
                <t t-if="question in answer.predefined_question_ids" t-call="of_survey.of_question_container"/>
            </t>

            <div class="row">
                <div class="col-12 text-center mt16">
                    <button type="submit" t-att-value="'next' if not survey_last else 'finish'" class="btn btn-primary disabled">
                        <t t-if="not survey_last">Continue</t>
                        <t t-else="">Submit</t>
                    </button>
                </div>
            </div>
        </t>

        <!-- If we have a choice question and less than 6 options, we want minimized display.
            Minimized display means we display the choices vertically (instead of optimized based on screen space).
            An exception is made for options with images, where we always want to optimize screen space.
            Numeric, date and datetime questions are also displayed "minimized", with a smaller screen width.-->
        <t t-set="minimized_display" t-value="survey.questions_layout == 'page_per_question' and len(question.suggested_answer_ids) &lt;= 5 and not any(suggestion.value_image for suggestion in question.suggested_answer_ids)" />
        <div t-if="survey.questions_layout == 'page_per_question'" t-attf-class="o_survey_page_per_question o_survey_#{question.question_type} #{'o_survey_minimized_display' if minimized_display else ''}">
            <input type="hidden" name="question_id" t-att-value="question.id" />

            <div class="mt-5">
                <t t-call="of_survey.of_question_container"/>
            </div>

            <div class="row">
                <div class="col-12 text-center mt16">
                    <button type="submit" t-att-value="'next' if not survey_last else 'finish'" class="btn btn-primary disabled">
                        <t t-if="survey_last">Submit</t>
                        <t t-else="">Continue</t>
                    </button>
                </div>
            </div>
        </div>
    </template>

    <template id="booking_survey" name="Prise de RDV en ligne - Questionnaire">
        <div class="wrap o_survey_wrap d-flex">
            <div class="container o_survey_form d-flex flex-column mb-5" style="min-height: 0px;">
                <t t-set="background_image_url" t-value="question.background_image_url
                                if question else page.background_image_url
                                if page else survey.background_image_url
                                if survey.background_image_url else False"/>
                <form role="form" method="post" t-att-name="survey.id" class="d-flex flex-grow-1 align-items-center"
                    t-att-data-user-input-id="answer.id"
                    t-att-data-answer-token="answer.access_token"
                    t-att-data-survey-token="survey.access_token"
                    t-att-data-users-can-go-back="survey.users_can_go_back and not answer.is_session_answer"
                    t-att-data-session-in-progress="answer.is_session_answer"
                    t-att-data-is-start-screen="answer.state == 'new'"
                    t-att-data-readonly="survey_form_readonly"
                    t-att-data-has-answered="bool(has_answered)"
                    t-att-data-is-page-description="bool(question and question.is_page and not is_html_empty(question.description))"
                    t-att-data-questions-layout="survey.questions_layout"
                    t-att-data-refresh-background="any(page.background_image for page in survey.page_ids)">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="token" t-att-value="answer.access_token" />
                    <input type="hidden" name="from_planning_booking" value="1"/>
                    <input type="hidden" name="service_id" t-att-value="service_id" />
                    <input type="hidden" name="contract_id" t-att-value="contract_id" />
                    <input type="hidden" name="partner_id" t-att-value="partner_id" />
                    <input type="hidden" name="slot_id" t-att-value="slot_id" />
                    <div class="o_survey_error alert alert-danger d-none" role="alert">
                        <p>There was an error during the validation of the survey.</p>
                    </div>

                    <div class="o_survey_form_content w-100">
                        <t t-call="of_website_planning_booking.booking_survey_fill_form_in_progress" />
                    </div>
                </form>
            </div>
        </div>
        <div class="page o_cc o_cc2 bg-transparent">
            <div class="row gx-0">
                <div name="buttons">
                    <div class="m-0 p-0 float-end">
                        <div class="o_survey_progress_wrapper d-inline-block pe-1 text-start">
                            <t t-call="of_survey.survey_progression"
                                t-if="survey and survey.questions_layout != 'one_page' and answer and answer.state == 'in_progress' and (not question or not question.is_page) and not survey_form_readonly">
                                <t t-if="survey.questions_layout == 'page_per_section'">
                                    <t t-set="page_ids" t-value="survey.page_ids.ids"/>
                                    <t t-set="page_number" t-value="page_ids.index(page.id) + (1 if survey.progression_mode == 'number' else 0)"/>
                                </t>
                                <t t-else="">
                                    <t t-set="page_ids" t-value="answer.predefined_question_ids.ids"/>
                                    <t t-set="page_number" t-value="page_ids.index(question.id)"/>
                                </t>
                            </t>
                        </div>
                        <div class="o_survey_brand_message float-end rounded me-3 border">
                            <div class="o_survey_navigation_wrapper d-inline-block" t-call="of_survey.of_survey_navigation">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="booking_confirmation" name="Prise de RDV en ligne - Confirmation">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="oe_structure"/>
                <div class="container of_booking of_booking_confirm">
                    <div class="page o_cc o_cc2 mt40 bg-transparent">
                        <h1 class="col-10 border-bottom pb-2 mt40 mb-5">
                            Confirm your appointment
                        </h1>
                        <div class="clearfix"/>
                        <div class="row gx-0">
                            <div class="col-lg-6">
                                <h2 class="col-lg-10">Intervention</h2>
                                <div class="col-lg-10">
                                    <div class="card of-border-primary" style="min-height: 160px;">
                                        <div class="card-body row d-flex">
                                            <b>
                                                <span t-esc="service_name"/>
                                            </b>
                                            <br/>
                                            <p t-if="display_price" style="line-height: 70%; margin-top: 5px; margin-bottom: 5px;">
                                                <span t-esc="price" t-options="{'widget': 'monetary', 'display_currency': company.currency_id}"/>
    TTC
                                                <br/>
                                                <i style="font-size: 65%">This price is indicative and may change depending on the specificities of your installation</i>
                                            </p>
                                            <span t-esc="slot.name"/>
                                            <br/>
                                            <span t-esc="slot.description"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <t t-if="is_fixed_meeting">
                                    <h2 class="col-lg-10">Contact details</h2>
                                </t>
                                <t t-else="">
                                    <h2 class="col-lg-10">Address and contact details</h2>
                                </t>
                                <div class="col-lg-10">
                                    <div class="card of-border-primary" style="min-height: 160px;">
                                        <div class="card-body row d-flex" style="overflow: clip;">
                                            <t t-if="is_fixed_meeting" t-esc="partner" t-options="dict(widget='contact', fields=['name', 'email', 'mobile'], no_marker=True)"/>
                                            <t t-else="" t-esc="partner" t-options="dict(widget='contact', fields=['name', 'address', 'email', 'mobile'], no_marker=True)"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br/>
                        <div class="row gx-0">
                            <div class="col-lg-12">
                                <t t-out="custom_note"/>
                            </div>
                        </div>
                        <br/>
                        <div class="row gx-0 pb40">
                            <form action="/booking/confirm" method="post">
                                <div class="form-group col-lg-12">
                                    <label class="col-form-label col-sm-auto s_website_form_label label-optional" for="comment"><strong>Additional comments</strong></label>
                                    <textarea name="comment" class="form-control"/>
                                </div>
                                <div class="clearfix"/>
                                <br/>
                                <div t-attf-class="#{error_dict.get('terms') and 'text-danger' or ''} col-lg-12">
                                    <input t-attf-class="#{error_dict.get('terms') and 'is-invalid' or ''} form-check-input" type="checkbox" name="terms" t-att-checked="'checked' if terms else None"/>
                                    <label class="col-form-label col-sm-auto s_website_form_label label-optional" for="terms" style="display: inline;">
                                        I accept the <a t-attf-href="/web/content?model=website&amp;field=of_booking_terms_file&amp;id={{request.website.id}}&amp;filename={{request.website.of_booking_terms_filename}}&amp;download=true">General terms and conditions</a> of <t t-esc="company.name"/>
                                    </label>
                                </div>
                                <div t-attf-class="#{error_dict.get('opt_in') and 'text-danger' or ''} col-lg-12">
                                    <input t-attf-class="#{error_dict.get('opt_in') and 'is-invalid' or ''} form-check-input" type="checkbox" name="opt_in" t-att-checked="'checked' if opt_in else None"/>
                                    <label class="col-form-label col-sm-auto s_website_form_label label-optional" for="opt_in" style="display: inline;">
                                        I agree to be contacted by <span t-esc="company.name"/>
                                    </label>
                                </div>
                                <div class="clearfix"/>
                                <div class="mt40" name="buttons">
                                    <a class="btn btn-secondary" href="/booking?of_return=1">
                                        <span class="fa fa-long-arrow-left"/>
                                        Change your choices
                                    </a>
                                    <span name="buttons_right" class="float-end">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <input type="hidden" name="intervention_id" t-att-value="intervention_id"/>
                                        <input type="hidden" name="service_id" t-att-value="service_id"/>
                                        <input type="hidden" name="contract_id" t-att-value="contract_id"/>
                                        <input type="hidden" name="partner_id" t-att-value="partner_id"/>
                                        <input type="hidden" name="slot_id" t-att-value="slot_id"/>
                                        <input type="hidden" name="submitted" value="1"/>
                                        <button type="submit" class="btn btn-primary">
                                            Validate
                                            <span class="fa fa-long-arrow-right"/>
                                        </button>
                                    </span>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

