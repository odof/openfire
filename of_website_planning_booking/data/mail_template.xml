<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Modèle de mail -->
    <record id="booking_confirmation_mail_template" model="mail.template">
        <field name="name">Planning booking - Confirmation</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="subject">{{ object.of_company_id.name }} - Confirmation of your appointment</field>
        <field name="email_from">{{ (object.of_company_id.email) }}</field>
        <field name="partner_to">{{ object.of_partner_id.id }}</field>
        <field name="body_html" type="html">
<p>Hello <t t-out="object.of_partner_id.name or ''">partner</t>,</p>
<p>Your appointment request for <span style="font-weight:bold;" t-out="format_date(object.start_date) or ''">2024-02-06</span> has been recorded.</p>
<p>Wishing you good reception.</p>
        </field>
        <field name="lang">{{ object.of_partner_id.lang }}</field>
        <field name="auto_delete" eval="False"/>
    </record>

</odoo>
