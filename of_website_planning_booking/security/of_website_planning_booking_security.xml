<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="of_planning_intervention_template_published_rule" model="ir.rule">
        <field name="name">OF Planning Intervantion Template Published</field>
        <field name="model_id" ref="of_planning.model_of_planning_intervention_template"/>
        <field name="domain_force">[('website_published', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal')), Command.link(ref('base.group_public'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="perm_write" eval="False"/>
    </record>

    <record id="of_service_request_portal_rule" model="ir.rule">
        <field name="name">OF Service Request Portal</field>
        <field name="model_id" ref="of_service.model_of_service_request"/>
        <field name="domain_force">['|', ('partner_id', 'child_of', user.partner_id.id), ('address_id', 'child_of', user.partner_id.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="perm_write" eval="False"/>
    </record>

</odoo>
