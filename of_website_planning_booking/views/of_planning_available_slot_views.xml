<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_available_slot_view_form" model="ir.ui.view">
        <field name="name">of.planning.available.slot.view.form</field>
        <field name="model">of.planning.available.slot</field>
        <field name="inherit_id" ref="of_planning_tour.of_planning_available_slot_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='weekday']" position="before">
                <field name="type" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="of_planning_available_slot_view_tree" model="ir.ui.view">
        <field name="name">of.planning.available.slot.view.tree</field>
        <field name="model">of.planning.available.slot</field>
        <field name="inherit_id" ref="of_planning_tour.of_planning_available_slot_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="type"/>
            </xpath>
        </field>
    </record>

    <record id="of_planning_available_slot_view_kanban" model="ir.ui.view">
        <field name="name">of.planning.available.slot.view.kanban</field>
        <field name="model">of.planning.available.slot</field>
        <field name="inherit_id" ref="of_planning_tour.of_planning_available_slot_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='employee_id']" position="after">
                <field name="type"/>
            </xpath>
            <xpath expr="//templates//field[@name='employee_id']" position="after">
                <field name="type"/>
            </xpath>
        </field>
    </record>

    <record id="of_planning_available_slot_view_search" model="ir.ui.view">
        <field name="name">of.planning.available.slot.view.search</field>
        <field name="model">of.planning.available.slot</field>
        <field name="inherit_id" ref="of_planning_tour.of_planning_available_slot_view_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="type"/>
            </xpath>
            <xpath expr="//filter[@name='current_week']" position="before">
                <filter string="Regular" name="regular" domain="[('type', '=', 'regular')]"/>
                <filter string="Web" name="web" domain="[('type', '=', 'web')]"/>
                <separator/>
            </xpath>
        </field>
    </record>

</odoo>
