<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
    <record id="of_sale_discount_product_pricelist_item_form_view" model="ir.ui.view">
        <field name="name">of.sale.discount.product.pricelist.item.form</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='percent_price']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='pricelist_rule_base']//field[@name='percent_price']" position="after">
                <field name="of_percent_price_formula" class="oe_inline" attrs="{'invisible':[('compute_price', '!=', 'percentage')]}" />
            </xpath>
        </field>
    </record>

</odoo>