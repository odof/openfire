<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_discount_view_order_form" model="ir.ui.view">
        <field name="name">of.sale.discount.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Affichage de la formule dans la vue formulaire des lignes de commande -->
            <xpath expr="//field[@name='order_line']/form/group/group/label[@for='discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form/group/group/div[@name='discount']" position="replace">
                <label for="of_discount_formula" groups="product.group_discount_per_so_line"/>
                <div name="discount" groups="product.group_discount_per_so_line">
                    <field name="discount" class="oe_inline" invisible="1"/>
                    <field name="of_discount_formula" class="oe_inline"/> %
                </div>
            </xpath>
            <!-- Affichage de la formule dans la vue liste des lignes de commande -->
            <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/tree/field[@name='discount']" position="after">
                <field name="of_discount_formula" groups="product.group_discount_per_so_line" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="of_sale_order_line_discount_view" model="ir.ui.view">
        <field name="name">of.sale.order.line.discount.form</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="of_sale.of_sale_order_line_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='discount']" position="replace">
                <label for="of_discount_formula" groups="product.group_discount_per_so_line"/>
                <div name="discount" groups="product.group_discount_per_so_line">
                    <field name="discount" class="oe_inline" invisible="1"/>
                    <field name="of_discount_formula" class="oe_inline"/> %
                </div>
            </xpath>
        </field>
    </record>

</odoo>
