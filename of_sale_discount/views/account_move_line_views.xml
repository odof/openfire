<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_discount_view_move_form" model="ir.ui.view">
        <field name="name">of.sale.discount.account.view.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//field[@name='invoice_line_ids']/tree//field[@name='discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook//field[@name='invoice_line_ids']/tree//field[@name='discount']" position="after">
                <field name="of_discount_formula" groups="base.group_no_one,of_sale_discount.of_group_discount_on_invoice_line" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="of_sale_discount_view_move_line_form" model="ir.ui.view">
        <field name="name">of.sale.discount.view.move.line.form</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="of_account.of_account_move_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='discount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='discount']" position="after">
                <field name="of_discount_formula" groups="base.group_no_one,of_sale_discount.of_group_discount_on_invoice_line"/>
            </xpath>
        </field>
    </record>

</odoo>
