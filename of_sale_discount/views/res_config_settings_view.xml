<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_discount_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.sale.discount.res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//div[hasclass('app_settings_block')]//separator[@name='analytic_account']" position="before"> -->
            <xpath expr="//div[@id='invoicing_settings']//div[@id='use_invoice_terms']" position="after">
                <div class="col-xs-12 col-md-6 o_setting_box" id="of_use_sale_discounts">
                    <div class="o_setting_left_pane">
                        <field name="group_discount_on_invoice_line"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="group_discount_on_invoice_line"/>
                        <div class="text-muted">
                            Allow discounts on invoice lines
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
