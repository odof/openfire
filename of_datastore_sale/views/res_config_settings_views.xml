<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_configuration" model="ir.ui.view">
        <field name="name">view.res.configuration.settings</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase_stock.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@data-key='purchase']" position="inside">
                <div class="row mt16 o_settings_container" name="request_vendor_setting_container">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="group_of_group_datastore_brand_dropshipping"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="group_of_group_datastore_brand_dropshipping"/>
                        <div class="text-muted">
                            Allows the use of drop-shipment on brands </div>
                    </div>
                </div>
            </div>
            </xpath>
        </field>
    </record>

    <record id="of_datastore_sale_sale_config_settings_form_view" model="ir.ui.view">
        <field name="name">of.datastore.sale.sale.config.settings.form.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="of_sale.of_sale_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='of_deposit_product_categ_id']/.." position="after">
                <div class="text-muted">
                    (OF) Miscellaneous items for the sales connector
                </div>
                <div class="text-muted">
                    <field name="of_datastore_sale_misc_product_id"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
