<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_type_sale_order_template_view_form" model="ir.ui.view">
        <field name="name">of.sale.type.sale.order.template.form</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='number_of_days']" position="before">
                <field name="of_order_type_id"/>
            </xpath>
        </field>
    </record>

</odoo>
