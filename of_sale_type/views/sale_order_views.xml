<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_tree_quotation" model="ir.ui.view">
        <field name="name">of.sale.type.sale.order.view.tree.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="type_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_tree_order" model="ir.ui.view">
        <field name="name">of.sale.type.sale.order.view.tree.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="type_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
