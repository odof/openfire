<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_sale_summary">
        <div class="container">
            <h2>Sale Summary</h2>
            <t t-set="datas" t-value="sale_id.get_sale_layout_summary_report()"/>
            <table class="table mt-3">
                <thead>
                    <tr>
                        <th>Section</th>
                        <th class="text-end">Cost</th>
                        <th class="text-end">Sale Price</th>
                        <th class="text-end">% Sale Price</th>
                        <th class="text-end">Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="datas['sections']" t-as="section" t-key="section_index">
                        <tr t-att-class="section['highlight'] and 'highlight' or ''">
                            <td><t t-esc="section['name']"/></td>
                            <td class="text-end">
                                <span t-esc="section['cost']" t-options="{'widget': 'monetary', 'display_currency': sale_id.currency_id}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="section['price']" t-options="{'widget': 'monetary', 'display_currency': sale_id.currency_id}"/>
                            </td>
                            <td class="text-end">
                                <span t-esc="section['percent_price']" />
                            </td>
                            <td class="text-end">
                                <span t-esc="section['qty']" />
                            </td>
                        </tr>
                    </t>
                    <tr class="highlight">
                        <td>
                            <strong>Total</strong>
                        </td>
                        <td class="text-end">
                            <span t-esc="datas['total']['cost']" t-options="{'widget': 'monetary', 'display_currency': sale_id.currency_id}"/>
                        </td>
                        <td class="text-end">
                            <span t-esc="datas['total']['price']"  t-options="{'widget': 'monetary', 'display_currency': sale_id.currency_id}"/>
                        </td>
                        <td></td>
                        <td class="text-end">
                            <span t-esc="datas['total']['qty']" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

</odoo>
