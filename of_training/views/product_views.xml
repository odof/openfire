<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_training_product_template_form_view" model="ir.ui.view">
        <field name="name">of.training.product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']/group" position="inside">
                <group name="group_miscellaneous" string="Miscellaneous">
                    <field name="is_training"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
