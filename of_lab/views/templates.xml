<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Web Assets -->
    <template id="assent_front" name="OF Lab assets" inherit_id="website.assets_frontend">
        <xpath expr="." position="inside">
            <link rel="stylesheet" type="text/less" href="/of_lab/static/src/less/style.less"/>
            <script type="text/javascript" src="/of_lab/static/src/js/of_lab.js"/>

            <!-- Theme Laze style -->
            <link href="/of_lab/static/src/less/as_snippets.less" rel="stylesheet" type="text/less"/>
            <link href="/of_lab/static/src/less/as_variables.less" rel="stylesheet" type="text/less"/>
        </xpath>
    </template>

    <!-- Login layout -->
    <template id="login_layout" inherit_id="website.login_layout" name="OF Lab Website Login Layout">
        <xpath expr="t" position="replace">
            <t t-call="web.layout">
                <head>
                    <t t-call-assets="web.assets_common" t-js="false"/>
                    <t t-call-assets="web.assets_frontend" t-js="false"/>
                    <t t-call-assets="web.assets_common" t-css="false"/>
                    <t t-call-assets="web.assets_frontend" t-css="false"/>
                </head>
                <div class="oe_website_login_container" t-raw="0"/>
            </t>
        </xpath>
    </template>

    <template id="login" inherit_id="web.login" name="OF Lab Login">
        <xpath expr="//form" position="before">
            <div class="row">
                <div class="col-md-12">
                    <h1 class="text-center">
                        <img src="/of_lab/static/src/img/openfire.png" class="center-block" style="width: 15%;"/>
                    </h1>
                </div>
            </div>
            <div class="row mt32" of_style="LAB" style="text-align: center;">
                <p style="background-color: #FFD814; color: black; border-radius: 20px; display: inline-block; padding: 6px 12px;">
                    <span style="font-size: 36px;" data-original-title="" title="">Se connecter&amp;nbsp;<span class="fa fa-gamepad fa-1x" style=""/></span>
                </p>
            </div>
        </xpath>
    </template>

    <template id="signup" inherit_id="auth_signup.signup" name="OF Lab Sign Up">
        <xpath expr="//form" position="before">
            <div class="row">
                <div class="col-md-12">
                    <h1 class="text-center">
                        <img src="/of_lab/static/src/img/openfire.png" class="center-block" style="width: 15%;"/>
                    </h1>
                </div>
            </div>
            <div class="row mt32" of_style="LAB" style="text-align: center;">
                <p style="background-color: #FFD814; color: black; border-radius: 20px; display: inline-block; padding: 6px 12px;">
                    <span style="font-size: 36px;" data-original-title="" title="">Créer un compte&amp;nbsp;<span class="fa fa-gamepad fa-1x" style=""/></span>
                </p>
            </div>
        </xpath>
    </template>

    <!-- Lab Layout -->
    <template id="lab_layout" name="OF Lab Layout">
        <t t-set="of_connected_user" t-value="1 if env['ir.ui.view'].user_has_groups('base.group_user') else None"/>
        <t t-call="web.layout">
            <head>
                <t t-call-assets="web.assets_common" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_common" t-css="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
            </head>
            <body>
                <div id="wrap" of_style="LAB">
                    <div class="oe_structure"/>
                    <div class="of_lab">
                        <div class="row">
                            <div class="col-md-12">
                                <h1 class="text-center">
                                    <img src="/of_lab/static/src/img/openfire.png" class="center-block" style="width: 15%;"/>
                                </h1>
                                <a t-if="of_connected_user" class="of_lab_log" href="/web/session/logout?redirect=/">
                                    <img class="img img-responsive center-block" src="/of_lab/static/src/img/logout.png"/>
                                </a>
                                <a t-else="" class="of_lab_log" href="/web/login">
                                    <img class="img img-responsive center-block" src="/of_lab/static/src/img/login.png"/>
                                </a>
                            </div>
                        </div>
                    </div>
                    <t t-raw="0"/>
                </div>
            </body>
        </t>
    </template>

    <!-- Page Lab Homepage -->
    <template id="lab_homepage" name="Lab' Accueil">
        <t t-set="title" value="Lab' OpenFire - Accueil"/>
        <t t-set="of_connected_user" t-value="1 if env['ir.ui.view'].user_has_groups('base.group_user') else None"/>
        <t t-set="of_portal_user" t-value="1 if env['ir.ui.view'].user_has_groups('base.group_portal') else None"/>
        <t t-att-call="'web.layout' if of_portal_user else 'website.layout'">
            <head>
                <t t-call-assets="web.assets_common" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_common" t-css="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
