    <!-- Lab Yousign Modal -->
    <template id="lab_yousign_modal" name="OpenFire - Signature électronique">
        <div id="modal_yousign" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="OpenFire - Signature électronique">
            <div class="modal-dialog modal-md">
                <form class="form-horizontal" role="form" id="lab_yousign_modal_form">
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-dismiss="modal" aria-hidden="true">x</button>
                            <h4 class="modal-title" id="myModalLabel">OpenFire - Signature électronique</h4>
                        </div>
                        <div class="modal-body">
                            <p class="alert alert-danger o_hidden" id="modal_error"/>
                            <h5>Pour tester la signature électronique, merci de renseigner ces informations :</h5>
                            <i class="text-muted">Vos coordonnées sont utilisées pour vous envoyer l'email et le sms nécessaires au test de la signature électronique.</i>
                            <div class="form-group mb0">
                                <label for="email" class="col-sm-4 mt16">
                                    <p>Courriel</p>
                                </label>
                                <div class="col-sm-8 mt16">
                                    <input type="text" name="email" class="form-control" required="required" t-att-value='email'/>
                                </div>
                            </div>
                            <div class="form-group mb0">
                                <label for="mobile" class="col-sm-4 mt16">
                                    <p>Numéro de mobile</p>
                                </label>
                                <div class="col-sm-8 mt16">
                                    <input type="text" name="mobile" class="form-control" required="required" t-att-value='mobile'/>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <input class="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="submit" value="Confirmer" class="btn btn-primary"/>
                            <button type="button" class="btn" data-dismiss="modal" aria-hidden="true">Annuler</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </template>

