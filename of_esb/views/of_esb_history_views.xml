<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="form" model="ir.ui.view">
        <field name="name">of.esb.history.form</field>
        <field name="model">of.esb.history</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="ttype"/>
                    <field name="date"/>
                    <field name="uuid"/>
                    <field name="user"/>
                    <field name="history"/>
                    <field name="mermaid" widget="mermaid"/>
                </group>
            </form>
        </field>
    </record>

    <record id="tree" model="ir.ui.view">
        <field name="name">of.esb.history.tree</field>
        <field name="model">of.esb.history</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ttype"/>
                <field name="date"/>
                <field name="uuid"/>
                <field name="user"/>
            </tree>
        </field>
    </record>

    <record id="action_of_esb_history" model="ir.actions.act_window">
        <field name="name">History</field>
        <field name="res_model">of.esb.history</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
