<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="esb_trigger_form" model="ir.ui.view">
        <field name="name">esb.trigger.form</field>
        <field name="model">esb.trigger</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="ttype"/>
                            <field name="exec_active"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('ttype','!=','scheduler')]}" string="Scheduler">
                        <group >
                            <field name="date_exec"/>
                            <field name="interval_number"/>
                            <field name="interval_type"/>
                        </group>
                        <group>
                            <field name="data_channel"/>
                            <field name="data_type"/>
                            <field name="data"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('ttype','!=','webhook')]}" string="Webhook">
                        <field name="public"/>
                        <field name="slug_name"/>
                        <field name="security"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="esb_trigger_tree" model="ir.ui.view">
        <field name="name">esb.trigger.tree</field>
        <field name="model">esb.trigger</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="ttype"/>
                <field name="exec_active"/>
            </tree>
        </field>
    </record>

    <record id="action_esb_trigger" model="ir.actions.act_window">
        <field name="name">Triggers</field>
        <field name="res_model">esb.trigger</field>
        <field name="view_mode">tree,form</field>
    </record>



</odoo>
