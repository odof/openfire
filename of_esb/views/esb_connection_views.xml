<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="esb_connection_form" model="ir.ui.view">
        <field name="name">esb.connection.form</field>
        <field name="model">esb.connection</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="ttype"/>
                    </group>
                    <group string="Email" attrs="{'invisible': [('ttype','!=','email')]}">
                        <field name="email_server"/>
                        <field name="email_port"/>
                        <field name="email_type"/>
                        <field name="security"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="esb_connection_tree" model="ir.ui.view">
        <field name="name">esb.connection.tree</field>
        <field name="model">esb.connection</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_esb_connection" model="ir.actions.act_window">
        <field name="name">Connections</field>
        <field name="res_model">esb.connection</field>
        <field name="view_mode">tree,form</field>
    </record>




</odoo>
