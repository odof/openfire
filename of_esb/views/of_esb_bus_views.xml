<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_esb_bus_form" model="ir.ui.view">
        <field name="name">of.esb.bus.form</field>
        <field name="model">of.esb.bus</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                    <field name="channel"/>
                    <field name="ttype"/>
                    <field name="data"/>
                    <field name="uuid"/>
                </group>
            </form>
        </field>
    </record>

    <record id="of_esb_bus_tree" model="ir.ui.view">
        <field name="name">of.esb.bus.tree</field>
        <field name="model">of.esb.bus</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="channel"/>
                <field name="ttype"/>
                <field name="uuid"/>
            </tree>
        </field>
    </record>

    <record id="action_of_esb_bus" model="ir.actions.act_window">
        <field name="name">Bus</field>
        <field name="res_model">of.esb.bus</field>
        <field name="view_mode">tree,form</field>
    </record>



</odoo>
