<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="esb_service_form" model="ir.ui.view">
        <field name="name">esb.service.form</field>
        <field name="model">esb.service</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="exec_active"/>
                        <field name="ttype"/>
                    </group>

                    <field name="code" widget="ace" options="{'mode': 'python'}"/>
                </group>
                    <span>
                        Les arguments envoyés dans la fonction sont dans le dictionnaire args<br/>
                        La variable args est un dictionnaire contenant trois clefs :
                        - in_data : "contient les données qui sont envoyées dans le bus",
                        - out_data : "contient les données de retour du service",
                        - properties : "dictionnaire contenant des propriétés du message, comme l'UUID du trigger qui
                        a lancé l'exécution"
                    </span>
            </form>
        </field>
    </record>

    <record id="esb_service_tree" model="ir.ui.view">
        <field name="name">esb.service.tree</field>
        <field name="model">esb.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="exec_active"/>
                <field name="ttype"/>
            </tree>
        </field>
    </record>

    <record id="action_esb_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">esb.service</field>
        <field name="view_mode">tree,form</field>
    </record>



</odoo>
