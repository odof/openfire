<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="esb_security_form" model="ir.ui.view">
        <field name="name">esb.security.form</field>
        <field name="model">esb.security</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="ttype"/>
                    <field name="user_id"/>
                </group>
                <group attrs="{'invisible': [('ttype','!=','Password')]}">
                    <field name="user"/>
                    <field name="password" password="True"/>
                </group>
            </form>
        </field>
    </record>

    <record id="esb_security_tree" model="ir.ui.view">
        <field name="name">esb.security.tree</field>
        <field name="model">esb.security</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="ttype"/>
                <field name="user_id"/>
            </tree>
        </field>
    </record>

    <record id="action_esb_security" model="ir.actions.act_window">
        <field name="name">Security</field>
        <field name="res_model">esb.security</field>
        <field name="view_mode">tree,form</field>
    </record>


</odoo>
