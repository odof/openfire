<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_product_product_template_only_form_view" model="ir.ui.view">
        <field name="name">of.product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='list_price']" position="before">
                <field name="of_model" />
                <xpath expr="//field[@name='default_code']" position="move" />
                <xpath expr="//field[@name='categ_id']" position="move" />
            </xpath>
        </field>
    </record>

    <record id="of_product_template_form_view" model="ir.ui.view">
        <field name="name">of.product.template.common.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='group_general']" position="attributes">
                <attribute name="string">Distributor information</attribute>
            </xpath>

            <xpath expr="//group[@name='group_general']" position="inside">
                <label for="list_price" class="mt-1"/>
                <div name="pricing">
                    <field name="list_price" class="oe_inline" widget="monetary"
                    options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                </div>
                <label for="standard_price" groups="base.group_user" attrs="{'invisible': [('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}"/>
                <div name="standard_price_uom" groups="base.group_user" attrs="{'invisible': [('product_variant_count', '&gt;', 1), ('is_product_variant', '=', False)]}">
                    <field name="standard_price" class="oe_inline" widget="monetary" options="{'currency_field': 'cost_currency_id', 'field_digits': True}"/>
                    <span groups="uom.group_uom">/
                        <field name="uom_name" class="oe_inline"/>
                    </span>
                </div>
            </xpath>

            <xpath expr="//group[@name='upsell']" position="before">
                <group string="Customer Invoice" name="customer_invoice"/>
            </xpath>

            <xpath expr="//div[@name='options']" position="inside">
                <group name="tags_and_pack_group">
                    <group name="tags_group">
                        <field name="product_tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_edit_color': 1}" string="Tags"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//group[@name='group_standard_price']" position="replace">
                <group name="group_standard_price" string="Supplier information">
                    <field name="of_cost_date"/>
                    <div id="uom-display" col="3">
                        <span groups="uom.group_uom"> / <field name="of_uom_po_id_display" string="Purchase UoM" class="oe_inline"/></span>
                    </div>
                    <div id="uom-display-2" col="5">
                        <span groups="uom.group_uom"> / <field name="of_uom_po_id_display2" string="Purchase UoM" class="oe_inline"/></span>
                    </div>
                </group>
            </xpath>
            <xpath expr="//group[@name='group_standard_price']" position="inside">
                <separator name="advanced_information" string="Advanced information"/>
                <field name="currency_id" invisible="1"/>
                <field name="cost_currency_id" invisible="1"/>
                <field name="product_variant_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                <xpath expr="//group[@name='group_general']//field[@name='uom_id']" position="move"/>
                <xpath expr="//group[@name='group_general']//field[@name='uom_po_id']" position="move"/>
                <field name="categ_id" string="Product Category"/>
                <field name="of_obsolete"/>
                <field name="of_uom_category_id" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='sales']//group[@name='description']" position="after">
                <group string="Description of the manufacturer" name="manufacturer_description">
                    <field colspan="2" name="of_manufacturer_description" nolabel="1" placeholder="This note corresponds to the description of the product by its manufacturer."/>
                </group>
                <group string="URL" name="url">
                    <field colspan="2" name="of_url" nolabel="1" placeholder="This field provides access to the product's web page."/>
                </group>
            </xpath>
            <xpath expr="//page[@name='sales']//group[@name='sale']" position="after">
                <group name="price_struct" string="Pricing structure" colspan="2">
                    <field name="of_purchase_transport"/>
                    <field name="of_sale_transport"/>
                    <field name="of_sale_coeff"/>
                    <field name="of_other_logistic_costs"/>
                    <field name="of_misc_taxes"/>
                    <field name="of_misc_costs"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='purchase']" position="before">
                <page string="Technical" name="technical" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='general_information']//field[@name='description']/.." position="attributes">
                <attribute name="name">group_internal_note</attribute>
            </xpath>

            <xpath expr="//field[@name='sale_ok']/parent::span" position="replace"/>
            <xpath expr="//field[@name='purchase_ok']/parent::span" position="replace"/>

            <xpath expr="//group[@name='group_standard_price']" position="after">
                <group name="miscellaneous" string="Miscellaneous">
                    <field name="sale_ok"/>
                    <field name="purchase_ok"/>
                </group>
                <xpath expr="//group[@name='group_internal_note']" position="move"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_tree" model="ir.ui.view">
        <field name="name">of.product.template.view.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='standard_price']" position="after">
                <field name="of_seller_price" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="of_seller_pp_untaxed" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="weight" optional="hide"/>
            </xpath>
            <xpath expr="//tree" position="inside">
                <field name="description" optional="hide" string="Internal Notes"/>
            </xpath>
        </field>
    </record>

    <record id="of_product_account_product_template_form_view" model="ir.ui.view">
        <field name="name">of.product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='customer_invoice']" position="inside">
                <field name="taxes_id" position="move"/>
            </xpath>
        </field>
    </record>

    <!-- Ajout des étiquettes sur la vue kanban -->
    <record id="of_product_template_kanban_view" model="ir.ui.view">
        <field name="name">of.product.template.product.kanban</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="product_tag_ids"/>
            </xpath>
            <xpath expr="//div[hasclass('o_kanban_image')]" position="before">
                <div>
                    <field name="product_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Ajout de la recherche sur étiquettes -->
    <record id="of_product_template_search_view" model="ir.ui.view">
        <field name="name">of.product.template.search</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="before">
                <field name="product_tag_ids"/>
            </xpath>
        </field>
    </record>

    <record id="of_product_variant_easy_edit_lst_price_view" model="ir.ui.view">
        <field name="name">of.product.product.view.form.easy.lst.price</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lst_price']" position="attributes">
                <attribute name="groups">!of_product.group_product_variant_specific_price</attribute>
            </xpath>
            <xpath expr="//field[@name='lst_price']" position="after">
                <field name="lst_price" class="oe_inline" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" groups="of_product.group_product_variant_specific_price"/>
            </xpath>
        </field>
    </record>

    <record id="of_produt_product_template_attribute_value_view_form" model="ir.ui.view">
        <field name="name">of.product.product.template.attribute.value.view.form</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_extra']" position="attributes">
                <attribute name="groups">!of_product.group_product_variant_specific_price</attribute>
            </xpath>
        </field>
    </record>

    <record id="of_produt_product_template_attribute_value_view_tree" model="ir.ui.view">
        <field name="name">of.product.product.template.attribute.value.view.tree</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_extra']" position="attributes">
                <attribute name="groups">!of_product.group_product_variant_specific_price</attribute>
            </xpath>
        </field>
    </record>

</odoo>
