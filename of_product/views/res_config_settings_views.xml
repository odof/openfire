<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_product_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.product.res.config.settings.view.form.inherit.sale</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div//div[@name='catalog_setting_container']//div[@id='stock_packaging']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="stock_packaging" title="Manage price by variants">
                    <div class="o_setting_left_pane">
                        <field name="group_product_variant_specific_price"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="group_product_variant_specific_price"/>
                        <div class="text-muted">
                            If checked this allow to set different prices for each variant. If not checked, the price of the template will be used. (standard behavior)
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
