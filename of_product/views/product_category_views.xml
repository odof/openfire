<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_tree_view" model="ir.ui.view">
        <field name="name">product.category.tree.view</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="property_account_income_categ_id" optional="show"/>
                <field name="property_account_expense_categ_id" optional="show"/>
                <field name="route_ids" optional="hide"/>
                <field name="product_count" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
