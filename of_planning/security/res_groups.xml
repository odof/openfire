<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ################# Module category ################# -->

    <record id="module_category_of_intervention" model="ir.module.category">
        <field name="sequence">95</field>
        <field name="name">Intervention</field>
        <field name="parent_id" eval="False" />
    </record>

    <record id="of_planning_intervention_category" model="ir.module.category">
        <field name="name">OF Interventions</field>
        <field name="description">Defines access rights to the OpenFire intervention planning</field>
        <field name="sequence">95</field>
        <field name="parent_id" ref="module_category_of_intervention" />
    </record>

    <!-- ################# Planning access right groups ################# -->

    <record id="group_intervention_use_deliveries" model="res.groups">
        <field name="name">Intervention's pickings</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>

    <!-- Rights to modify intervention planning -->
    <!-- View and edit my interventions only -->
    <record id="group_planning_intervention_read_own_write_own" model="res.groups">
        <field name="name">Access my interventions</field>
        <field name="category_id" ref="of_planning_intervention_category" />
    </record>


    <!-- View all interventions, edit my interventions only -->
    <record id="group_planning_intervention_read_all_write_own" model="res.groups">
        <field name="name">Manage my interventions</field>
        <field name="category_id" ref="of_planning_intervention_category" />
        <field name="implied_ids"
            eval="[(4, ref('group_planning_intervention_read_own_write_own'))]" />
    </record>

    <!-- Responsible -->
    <record id="group_planning_intervention_responsible" model="res.groups">
        <field name="name">Responsible</field>
        <field name="category_id" ref="of_planning_intervention_category" />
        <field name="implied_ids"
            eval="[(4, ref('group_planning_intervention_read_all_write_own'))]" />
    </record>

    <!-- Manager -->
    <record id="group_planning_intervention_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="of_planning_intervention_category" />
        <field name="users"
            eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]" />
        <field name="implied_ids" eval="[(4, ref('group_planning_intervention_responsible'))]" />
    </record>

    <!-- Restrict the ability to configure interventions for sales representatives -->
    <record id="group_sales_representatives_responsible" model="res.groups">
        <field name="name">(OF) Block access to intervention configuration</field>
        <field name="category_id" ref="base.module_category_hidden" />
        <field name="comment">Restrict access to intervention settings</field>
    </record>

</odoo>
