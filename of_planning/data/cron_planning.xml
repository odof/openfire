<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="cron_planning_send_tomorrow_schedule_by_mail" model="ir.cron">
        <field name="name">Planning: Next-day schedules sent by email</field>
        <field name="active" eval="True" />
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="state">code</field>
        <field name="code">model.cron_planning_send_tomorrow_schedule_by_mail()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now()).strftime('%Y-%m-%d 18:00:00')"/>
        <field name="numbercall">-1</field>
        <field name="user_id" ref="base.user_root" />
    </record>

</odoo>
