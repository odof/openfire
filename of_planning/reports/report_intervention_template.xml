<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Internal layout -->
    <template id="of_planning.of_internal_layout">
        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="'of_company_id' in doc and doc.of_company_id.sudo()">
                <t t-set="company" t-value="doc.of_company_id.sudo()"/>
            </t>
            <t t-elif="'company_id' in doc and doc.company_id.sudo()">
                <t t-set="company" t-value="doc.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>
        <!-- Header -->
        <div class="header">
            <div class="row">
                <div class="col-3 mb4">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;" alt="Logo"/>
                </div>
                <div class="col-6 h4 text-center pt-1">
                    <div>
                        <span t-field="template.sheet_title" />
                        <span t-if="template.sheet_date and doc.start_date"> to </span>
                        <span t-if="template.sheet_date and doc.stop_date" t-field="doc.stop_date" />
                    </div>
                    <t t-if="template.sheet_partner_id and doc.of_address_id">
                        <strong>
                            <div t-field="doc.of_address_id" />
                        </strong>
                    </t>
                </div>
                <div class="col-3 h5 text-end">
                    <t t-if="order">
                        <span>Order&amp;nbsp;: </span>
                        <span t-field="order.name" />
                    </t>
                </div>
            </div>
        </div>

        <t t-if="company.external_report_layout_id" t-call="{{company.external_report_layout_id.sudo().key}}"><t t-out="0"/></t>
        <t t-else="else" t-call="web.external_layout_standard"><t t-out="0"/></t>
    </template>

</odoo>
