<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_image_view_tree" model="ir.ui.view">
        <field name="name">of.image.view.tree</field>
        <field name="model">of.image</field>
        <field name="inherit_id" ref="of_base.of_image_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='caption']" position="after">
                <field name="intervention_id" />
            </xpath>
        </field>
    </record>

    <record id="of_image_view_kanban" model="ir.ui.view">
        <field name="name">of.image.view.kanban</field>
        <field name="model">of.image</field>
        <field name="inherit_id" ref="of_base.of_image_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//small[@id='caption']" position="before">
                <small attrs="{'invisible': [('intervention_id','=',False)]}">Intervention : <field name="intervention_id"/></small><br/>
            </xpath>
        </field>
    </record>

    <record id="of_image_view_search" model="ir.ui.view">
        <field name="name">of.image.view.search</field>
        <field name="model">of.image</field>
        <field name="inherit_id" ref="of_base.of_image_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <group string="Group By" name="groupby">
                    <filter name="intervention_groupby" string="Intervention" context="{'group_by': 'intervention_id'}" />
                </group>
            </xpath>
        </field>
    </record>

</odoo>
