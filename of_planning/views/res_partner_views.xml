<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="calendar.view_partners_form" model="ir.ui.view">
        <field name="priority">100</field>
    </record>

    <!-- Positionning Intervenrtions smart button after Sales smart button -->
    <record id="view_partner_form_intervention_buttons" model="ir.ui.view">
        <field name="name">of.planning.res.partner.interventions.button.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sale.res_partner_view_buttons"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']//button[@name='action_view_sale_order']" position="after">
                <button class="oe_stat_button" name="action_button_view_intervention" type="object" icon="fa-calendar" groups="of_planning.group_planning_intervention_read_all_write_own">
                    <field string="Interventions" name="of_intervention_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="of_planning_view_partner_intervention_warn_form" model="ir.ui.view">
        <field name="name">of.planning.res.partner.intervention.warn.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="of_sale.of_view_res_partner_sale_warn_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']//div[@name='of_div_account_warn']" position="after">
                <div name="of_div_intervention_warn">
                    <field name="of_is_intervention_warn" nolabel="1" class="oe_inline"/> interventions
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="of_base.of_base_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='history']" position="inside">
                <field name="id" invisible="1"/>
                <group name="histo_interventions" string="Interventions">
                    <group>
                        <field name="of_intervention_partner_ids" colspan="4" nolabel="1" attrs="{'invisible': [('parent_id','!=', False)]}"
                                context="{'form_view_ref': 'of_planning.calendar_event_view_form_2', 'of_force_read': True}">
                            <tree string="Plannings">
                                <field name="of_task_id"/>
                                <field name="of_employee_ids" widget="many2many_tags"/>
                                <field name="start_date" string="Date"/>
                                <field name="duration" widget="float_time"/>
                                <field name="of_state"/>
                                <field name="name"/>
                                <field name="description"/>
                            </tree>
                        </field>
                        <field name="of_intervention_address_ids" colspan="4" nolabel="1" attrs="{'invisible': [('parent_id','=', False)]}"
                                context="{'form_view_ref': 'of_planning.calendar_event_view_form_2', 'default_of_address_id': id, 'of_force_read': True}">
                            <tree string="Plannings">
                                <field name="of_employee_ids" widget="many2many_tags"/>
                                <field name="of_task_id"/>
                                <field name="start_date" string="Date"/>
                                <field name="duration" widget="float_time"/>
                                <field name="of_state"/>
                                <field name="name"/>
                                <field name="description"/>
                                <field name="of_category_id"/>
                            </tree>
                        </field>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_res_partner" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{"search_default_customer_rank":1}</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
    </record>

</odoo>
