<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_picking_view_form" model="ir.ui.view">
        <field name="name">of.planning.stock.picking.view.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_button_view_interventions" type="object" icon="fa-calendar"
                        attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}">
                    <field string="# Interventions" name="of_intervention_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
