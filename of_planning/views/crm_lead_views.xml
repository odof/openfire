<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_schedule_meeting']" position="after">
                <button class="oe_stat_button" name="action_button_view_intervention" type="object" icon="fa-calendar">
                    <field string="Interventions" name="of_intervention_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//button[@name='action_schedule_meeting']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
