<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_intervention_template_view_form" model="ir.ui.view">
        <field name="name">of.planning.intervention.template.view.form</field>
        <field name="model">of.planning.intervention.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template name" />
                        </h1>
                    </div>
                    <group name="general">
                        <group name="general_one">
                            <field name="code" />
                            <field name="task_id" />
                            <field name="is_default_template" invisible="1" />
                        </group>
                        <group name="general_two" />
                    </group>
                    <notebook>
                        <page name="configuration" string="Configuration">
                            <group>
                                <field name="sequence_id" colspan="2" />
                                <field name="send_reports" colspan="2" />
                                <field name="attach_report" colspan="2" />
                            </group>
                        </page>
                        <page name="invoicing" string="Invoicing">
                            <group>
                                <group>
                                    <field name="fiscal_position_id" />
                                </group>
                            </group>
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" />
                                    <field name="name" />
                                    <field name="qty" />
                                    <field name="price_unit" />
                                </tree>
                            </field>
                        </page>
                        <page name="legal" string="Legal notice">
                            <field name="legal" nolabel="1" />
                        </page>
                        <page name="sheet" string="Intervention sheet">
                            <group col="4" class="mb-4">
                                <group>
                                    <field name="sheet_use_default" attrs="{'invisible':[('is_default_template','=',True)]}" />
                                    <separator string="Displayed fields" colspan="2" />
                                    <field name="sheet_title" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                                    <field name="sheet_partner_id" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                                    <field name="sheet_date" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                                </group>
                            </group>
                            <group col="8" class="mb-4">
                                <group name="sheet_first">
                                    <!-- Intervention sheet -->
                                    <field name="sheet_intervention" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                                    <field name="sheet_intervention_partner_id" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_partner_code" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_task_id" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_task_description" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_date" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_duration" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_team_id" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_employee_ids" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_company_id" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_label" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_address" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_contact" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_type" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_internal_description" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                    <field name="sheet_intervention_description" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_intervention', '=', False)]}" />
                                </group>
                                <group name="sheet_second">
                                    <!-- Sheet - Installed equipment -->
                                </group>
                                <group name="sheet_third">
                                    <!-- Sheet - History -->
                                    <field name="sheet_history" class="mb-4" attrs="{'readonly':[('sheet_use_default','=',True)]}" />

                                    <!-- Sheet - Order -->
                                    <field name="sheet_order" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                                    <field name="sheet_order_name" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                                    <field name="sheet_order_confirmation_date" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_order', '=', False)]}" />
                                    <field name="sheet_order_user_id" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_order', '=', False)]}" />
                                    <field name="sheet_order_inspection_visit_date" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_order', '=', False)]}" />
                                    <field name="sheet_order_totals" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_order', '=', False)]}" />
                                    <field name="sheet_order_intervention_notes" class="mb-4" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_order', '=', False)]}" />
                                </group>
                                <group name="sheet_fourth">
                                    <!-- Sheet - Products -->
                                    <field name="sheet_products" class="mb-4" attrs="{'readonly':[('sheet_use_default','=',True)]}" />

                                    <!-- Sheet - Pickings -->
                                    <field name="sheet_pickings" class="mb-4" attrs="{'readonly':[('sheet_use_default','=',True)]}" />

                                    <!-- Sheet - Invoicing -->
                                    <field name="sheet_invoicing" class="mb-4" attrs="{'readonly':[('sheet_use_default','=',True)]}" />

                                    <!-- Sheet - Survey -->

                                    <!-- Sheet - Debriefing -->

                                    <!-- Sheet - Legal notice -->
                                    <field name="sheet_legal" class="mb-4" attrs="{'readonly':[('sheet_use_default','=',True)]}" />

                                    <!-- Sheet - Minutes -->
                                    <field name="sheet_minutes" attrs="{'readonly':[('sheet_use_default','=',True)]}"/>
                                    <field name="sheet_minutes_real_dates" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_minutes', '=', False)]}"/>
                                    <field name="sheet_minutes_real_duration" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_minutes', '=', False)]}"/>
                                    <field name="sheet_minutes_description" class="mb-4" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_minutes', '=', False)]}"/>

                                    <!-- Report - Photos -->
                                    <field name="sheet_photos" class="mb-4" attrs="{'readonly':[('sheet_use_default','=',True)]}"/>

                                    <!-- Sheet - Signatures -->
                                    <field name="sheet_signature" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                                    <field name="sheet_signature_date" class="mb-4" attrs="{'readonly':['|', ('sheet_use_default','=',True), ('sheet_signature', '=', False)]}"/>
                                </group>
                            </group>
                        </page>
                        <page name="report" string="Intervention report">
                            <group col="4" class="mb-4">
                                <group>
                                    <field name="report_use_default" attrs="{'invisible':[('is_default_template','=',True)]}" />
                                    <separator string="Displayed fields" colspan="2" />
                                    <field name="report_title" attrs="{'readonly':[('report_use_default','=',True)]}" />
                                    <field name="report_partner_id" attrs="{'readonly':[('report_use_default','=',True)]}" />
                                    <field name="report_date" attrs="{'readonly':[('report_use_default','=',True)]}" />
                                </group>
                            </group>
                            <group col="8" class="mb-4">
                                <group name="report_first">
                                    <!-- Intervention report -->
                                    <field name="report_intervention" attrs="{'readonly':[('report_use_default','=',True)]}"/>
                                    <field name="report_intervention_partner_id" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_partner_code" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_task_id" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_task_description" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_date" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_duration" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_team_id" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_employee_ids" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_company_id" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_label" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_address" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_contact" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_type" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_internal_description" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                    <field name="report_intervention_description" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_intervention', '=', False)]}"/>
                                </group>
                                <group name="report_second">
                                    <!-- Report - Installed equipment -->
                                </group>
                                <group name="report_third">
                                    <!-- Report - History -->
                                    <field name="report_history" class="mb-4" attrs="{'readonly':[('report_use_default','=',True)]}"/>

                                    <!-- Report - Order -->
                                    <field name="report_order" attrs="{'readonly':[('report_use_default','=',True)]}"/>
                                    <field name="report_order_name" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_order', '=', False)]}"/>
                                    <field name="report_order_confirmation_date" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_order', '=', False)]}"/>
                                    <field name="report_order_user_id" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_order', '=', False)]}"/>
                                    <field name="report_order_inspection_visit_date" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_order', '=', False)]}"/>
                                    <field name="report_order_totals" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_order', '=', False)]}"/>
                                    <field name="report_order_intervention_notes" class="mb-4" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_order', '=', False)]}"/>
                                </group>
                                <group name="report_fourth">
                                    <!-- Report - Products -->
                                    <field name="report_products" class="mb-4" attrs="{'readonly':[('report_use_default','=',True)]}"/>

                                    <!-- Report - Pickings -->
                                    <field name="report_pickings" class="mb-4" attrs="{'readonly':[('report_use_default','=',True)]}"/>

                                    <!-- Report - Invoicing -->
                                    <field name="report_invoicing" class="mb-4" attrs="{'readonly':[('report_use_default','=',True)]}"/>

                                    <!-- Report - Survey -->

                                    <!-- Report - Debriefing -->

                                    <!-- Report - Legal notice -->
                                    <field name="report_legal" class="mb-4" attrs="{'readonly':[('report_use_default','=',True)]}"/>

                                    <!-- Report - Minutes -->
                                    <field name="report_minutes" attrs="{'readonly':[('report_use_default','=',True)]}"/>
                                    <field name="report_minutes_real_dates" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_minutes', '=', False)]}"/>
                                    <field name="report_minutes_real_duration" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_minutes', '=', False)]}"/>
                                    <field name="report_minutes_description" class="mb-4" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_minutes', '=', False)]}"/>

                                    <!-- Report - Photos -->
                                    <field name="report_photos" class="mb-4" attrs="{'readonly':[('report_use_default','=',True)]}"/>

                                    <!-- Report - Signatures -->
                                    <field name="report_signature" attrs="{'readonly':[('report_use_default','=',True)]}"/>
                                    <field name="report_signature_date" class="mb-4" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_signature', '=', False)]}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>

    <record id="of_planning_intervention_template_view_tree" model="ir.ui.view">
        <field name="name">of.planning.intervention.template.view.tree</field>
        <field name="model">of.planning.intervention.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="task_id" />
            </tree>
        </field>
    </record>

    <record id="of_planning_intervention_template_view_search" model="ir.ui.view">
        <field name="name">of.planning.intervention.template.view.search</field>
        <field name="model">of.planning.intervention.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <separator />
                <filter string="Active" name="active" domain="[('active','=',True)]" />
                <filter string="Archived" name="inactive" domain="[('active','=',False)]" />
            </search>
        </field>
    </record>

    <record id="action_of_planning_intervention_template" model="ir.actions.act_window">
        <field name="name">Intervention template</field>
        <field name="res_model">of.planning.intervention.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="of_planning_intervention_template_view_tree" />
        <field name="search_view_id" ref="of_planning_intervention_template_view_search" />
    </record>


</odoo>
