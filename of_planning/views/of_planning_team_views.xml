<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_team_view_tree" model="ir.ui.view">
        <field name="name">of.planning.team.view.tree</field>
        <field name="model">of.planning.team</field>
        <field name="arch" type="xml">
            <tree string="Teams list">
                <field name="name" />
                <field name="employee_ids" />
                <field name="note" />
                <field name="sequence" />
            </tree>
        </field>
    </record>

    <record id="of_planning_team_view_form" model="ir.ui.view">
        <field name="name">of.planning.team.view.form</field>
        <field name="model">of.planning.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}" />
                    <div class="oe_title">
                        <label for="name" string="Team" class="oe_edit_only" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_ids" widget="many2many_tags" />
                            <field name="sequence" />
                        </group>
                        <field name="note" nolabel="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_planning_team_view_search" model="ir.ui.view">
        <field name="name">of.planning.team.view.search</field>
        <field name="model">of.planning.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <separator />
                <filter string="Active" name="active" domain="[('active','=',True)]" />
                <filter string="Archived" name="inactive" domain="[('active','=',False)]" />
            </search>
        </field>
    </record>

    <record id="action_of_planning_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">of.planning.team</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="of_planning_team_view_tree" />
        <field name="search_view_id" ref="of_planning_team_view_search" />
    </record>

</odoo>
