<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_tag_view_tree" model="ir.ui.view">
        <field name="name">of.planning.tag.view.tree</field>
        <field name="model">of.planning.tag</field>
        <field name="arch" type="xml">
            <tree string="Tag list">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="active" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="of_planning_tag_view_form" model="ir.ui.view">
        <field name="name">of.planning.tag.view.form</field>
        <field name="model">of.planning.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}" />
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name" />
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_planning_tag_view_search" model="ir.ui.view">
        <field name="name">of.planning.tag.view.search</field>
        <field name="model">of.planning.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <separator />
                <filter string="Active" name="active" domain="[('active','=',True)]" />
                <filter string="Archived" name="inactive" domain="[('active','=',False)]" />
            </search>
        </field>
    </record>

    <record id="action_of_planning_tag" model="ir.actions.act_window">
        <field name="name">Intervention tags</field>
        <field name="res_model">of.planning.tag</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="of_planning_tag_view_tree" />
        <field name="search_view_id" ref="of_planning_tag_view_search" />
    </record>

</odoo>
