<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="procurement_group_view_form" model="ir.ui.view">
        <field name="name">procurement.group.view.form</field>
        <field name="model">procurement.group</field>
        <field name="inherit_id" ref="stock.procurement_group_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_type']" position="after">
                <field name="of_intervention_id" attrs="{'invisible':[('of_intervention_id', '=', False)]}" />
            </xpath>
        </field>
    </record>

</odoo>
