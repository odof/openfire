<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- After installation of the module, open the related menu -->

        <record id="of_sms_account_action_ovh" model="ir.actions.act_window">
            <field name="name">(OF) SMS Account OVH</field>
            <field name="res_model">of.sms.account</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="of_sms.of_sms_account_view_form"/>
            <field name="context" eval="{'default_name':'OVH Account','default_account_gateway_id':ref('of_sms_gateway_ovh')}"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Add SMS Gateway Accounts</p>
            </field>
        </record>

        <record id="base.open_menu" model="ir.actions.todo">
            <field name="action_id" ref="of_sms_account_action_ovh"/>
            <field name="state">open</field>
        </record>

    </data>

    <!-- Add possibility to select "send sms" as an action -->
    <record id="of_view_server_action_form_inherit_sms_frame" model="ir.ui.view">
        <field name="name">of.ir.actions.server.form.sms</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='code']" position="after">
                <page string="SMS" autofocus="autofocus" attrs="{'invisible': [('state', '!=', 'sms')]}">
                    <p attrs="{'invisible': [('model_id', '!=', False)]}">
                        Please set the Base Model before setting the action details.
                    </p>
                    <group attrs="{'invisible': [('model_id', '=', False)]}">
                        <field name="sms_template_id" attrs="{'required': [('state', '=', 'sms')]}"/>
                        <p colspan="2" attrs="{'invisible': [('sms_template_id', '!=', False)]}">
                            Choose a SMS template.
                        </p>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="of_sms_partner_more_menu_server_action" model="ir.actions.server">
        <field name="name">(OF) SMS Partner</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="condition">True</field>
        <field name="state">code</field>
        <field name="code">action = record.sms_action()</field>
    </record>

    <record id="of_sms_partner_more_menu_client_action" model="ir.values">
        <field name="key2" eval="'client_action_multi'" />
        <field name="model" eval="'res.partner'"/>
        <field name="name">SMS Partner</field>
        <field name="value" eval="'ir.actions.server,%d'%of_sms_partner_more_menu_server_action"/>
    </record>

    <record id="of_sms_lead_more_menu_server_action" model="ir.actions.server">
        <field name="name">(OF) SMS Partner</field>
        <field name="model_id" ref="model_crm_lead"/>
        <field name="condition">True</field>
        <field name="state">code</field>
        <field name="code">action = record.sms_action()</field>
    </record>

    <record id="of_sms_lead_more_menu_client_action" model="ir.values">
        <field name="key2" eval="'client_action_multi'" />
        <field name="model" eval="'crm.lead'"/>
        <field name="name">SMS Partner</field>
        <field name="value" eval="'ir.actions.server,%d'%of_sms_lead_more_menu_server_action"/>
    </record>

    <record id="of_sms_intervention_more_menu_server_action" model="ir.actions.server">
        <field name="name">(OF) SMS Partner</field>
        <field name="model_id" ref="model_of_planning_intervention"/>
        <field name="condition">True</field>
        <field name="state">code</field>
        <field name="code">action = record.sms_action()</field>
    </record>

    <record id="of_sms_intervention_more_menu_client_action" model="ir.values">
        <field name="key2" eval="'client_action_multi'" />
        <field name="model" eval="'of.planning.intervention'"/>
        <field name="name">SMS Partner</field>
        <field name="value" eval="'ir.actions.server,%d'%of_sms_intervention_more_menu_server_action"/>
    </record>

    <record id="of_view_partner_form_inherit_of_sms" model="ir.ui.view">
        <field name="name">E.164 mobile placeholder</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="mobile" position="replace">
                <field name="mobile" placeholder="E.164 format e.g. +61 427 671 760"/>
            </field>
        </field>
    </record>

</odoo>