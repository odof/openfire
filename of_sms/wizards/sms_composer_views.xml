<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sms_composer_view_form" model="ir.ui.view">
        <field name="name">sms.composer.view.form</field>
        <field name="model">sms.composer</field>
        <field name="inherit_id" ref="sms.sms_composer_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='body']" position="before">
                <div colspan="2">
                    <group>
                        <group>
                            <field name="of_sender_id" required="1"/>
                            <field name="of_is_commercial"/>
                        </group>
                        <group>
                            <field name="template_id"/>
                            <field name="of_send_date"/>
                        </group>
                    </group>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
