                    <separator colspan="2" string="Informations de Stock" name="stock_info_sep"
            groups="of_purchase.group_purchase_order_line_display_stock_info+purchase.group_purchase_manager"/>
                    <field name="of_total_stock_qty"
            groups="of_purchase.group_purchase_order_line_display_stock_info+purchase.group_purchase_manager"/>
