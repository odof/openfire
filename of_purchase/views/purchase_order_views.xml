    <record id="of_purchase_order_customer_tree" model="ir.ui.view">
        <field name="name">purchase.order.tree</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="before">
                <field name="of_customer_id" />
                <field name="of_customer_shipping_id" invisible="1" />
                <field name="of_customer_shipping_city" />
                <field name="of_customer_shipping_zip" />
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="before">
                <field name="of_delivery_expected" />
            </xpath>
        </field>
    </record>

    <record id="of_view_purchase_order_customer_filter" model="ir.ui.view">
            <field name="name">of.purchase.order.customer.filter</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <filter name="partner_ref" string="Supplier reference" domain="[]"
                    context="{'group_by':'partner_ref'}"/>
                    <field name="partner_ref" string="Supplier reference"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="of_customer_id" operator="child_of"/>
                </xpath>
                <!-- <xpath expr="//filter[@name='order_date']" position="before">
                    <separator/>
                    <filter string="Customer" domain="[]" context="{'group_by':'of_customer_id'}"/>
                    <separator/>
                </xpath> -->
                    <xpath expr="//filter[@name='order_date']" position="after">
                    <separator/>
                    <filter name="not_received" string="Not Received" domain="[('of_reception_state','=', 'not_received')]"/>
                    <filter name="received" string="Received" domain="[('of_reception_state','=', 'received')]"/>
                </xpath>

    </field>
        </record>



