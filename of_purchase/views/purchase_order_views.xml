<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_purchase_order_customer_form" model="ir.ui.view">
        <field name="name">purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_unlock']" position="after">
                <button name="button_update_purchase_price" string="Recalcul prix de revient"
                    type="object"
                    attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'to approve', 'sent', 'purchase']),
                        ('of_sale_order_id', '=', False)]}" />
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="of_sent" />
                <field name="of_sale_order_id" />
                <field name="of_customer_id" />
                <field name="of_customer_shipping_id" invisible="1" />
                <field name="of_customer_shipping_city" invisible="1" />
                <field name="of_customer_shipping_zip" invisible="1" />
            </xpath>
            <xpath expr="//label[@for='date_planned']" position="before">
                <field name="of_delivery_expected" />
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="of_user_id" />
            </xpath>
            <xpath expr="//field[@name='date_planned']" position="replace">
                <field name="of_delivery_force" class="oe_edit_only"
                    attrs="{'readonly': [('state', 'not in', ('draft', 'sent'))]}" />
            </xpath>
            <xpath expr="//label[@for='date_planned']" position="replace">
                <field name="date_planned" readonly="1" />
                <label for="of_delivery_force" class="oe_edit_only" />
            </xpath>
            <xpath expr="//field[@name='order_line']/tree" position="inside">
                <field name="of_total_stock_qty"
                    groups="of_purchase.group_purchase_order_line_display_stock_info+purchase.group_purchase_manager" />
                <field name="of_available_stock_qty"
                    groups="of_purchase.group_purchase_order_line_display_stock_info+purchase.group_purchase_manager" />
                <field name="of_theoretical_stock_qty"
                    groups="of_purchase.group_purchase_order_line_display_stock_info+purchase.group_purchase_manager" />
                <field name="of_reserved_qty"
                    groups="of_purchase.group_purchase_order_line_display_stock_info+purchase.group_purchase_manager" />
            </xpath>
             <!-- <xpath expr="//field[@name='order_line']/form/sheet/group/group[1]"
            position="inside"> -->
            <!-- Champs présents en vue liste mais pas en vue form  -->
            <!-- <field name="currency_id" invisible="1"/>
                    <field name="state" invisible="1"/>
                    <field name="sequence" invisible="1"/>
                    <field name="date_planned" invisible="1"/>
