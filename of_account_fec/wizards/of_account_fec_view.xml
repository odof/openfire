<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_account_fr_fec_view" model="ir.ui.view">
        <field name="name">of.account.fr.fec.form.view</field>
        <field name="model">account.fr.fec</field>
        <field name="inherit_id" ref="l10n_fr_fec.account_fr_fec_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']//group//field[@name='export_type']" position="after">
                <field name="of_file_extension"/>
                <field name="of_output_encoding" attrs="{'invisible': [('export_type','=','official')]}"/>
            </xpath>
            <xpath expr="//page[@name='options']//group" position="after">
                <group colspan="2" name="options_more" attrs="{'invisible': [('export_type','=','official')]}">
                    <group name="options2" colspan="2">
                        <field name="of_use_create_date" invisible="1"/>
                        <field name="of_order_by" widget="radio"/>
                        <field name="of_opening_journal_code"/>
                        <field name="of_opening_journal_label"/>
                        <field name="of_include_opening_journal"/>
                    </group>
                    <group name="journals" colspan="2">
                        <field name="of_journal_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
