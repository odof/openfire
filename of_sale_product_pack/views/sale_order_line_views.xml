<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="of_sale_order_line_view" model="ir.ui.view">
        <field name="name">of.sale.product.pack.sale.order.line.form</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="of_sale.of_sale_order_line_view" />
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="of_pack_ok" string="Pack"/>
            </field>
            <field name="of_main_product" position="after">
                <field name="of_pack_component_price" attrs="{'invisible': [('of_pack_ok', '=', False)], 'required': [('of_pack_ok', '=', True)]}"/>
            </field>
            <field name="name" position="after">
                <label for="of_pack_line_ids"/>
                <field name="of_pack_line_ids" mode="tree" attrs="{'invisible': [('of_pack_ok', '=', False)]}" required="1">
                    <tree editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                    </tree>
                </field>
            </field>
        </field>
    </record>

</odoo>
