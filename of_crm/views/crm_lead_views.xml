<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_crm_case_kanban_view_leads" model="ir.ui.view">
        <field name="name">of.crm.lead.kanban.lead</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
        <field name="arch" type="xml">

            <!-- header fields -->
            <field name="activity_date_deadline" position="after">
                <field name="of_date_action"/>
                <field name="of_title_action"/>
            </field>
            <xpath expr="//kanban//field[@name='company_currency']" position="after">
                <field name="user_id"/>
            </xpath>

            <!-- Kanban body -->
            <xpath expr="//kanban/templates//field[@name='name']/parent::node()" position="after">
                <span t-if="record.user_id"> - </span><field name="user_id"/>
            </xpath>
        </field>
    </record>

    <record id="of_crm_quick_create_opportunity_form" model="ir.ui.view">
        <field name="name">of.crm.lead.form.quick_create</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">Project description</attribute>
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//field[@name='recurring_plan']/.." position="after">
                <div class="o_row">
                    <span class="oe_grey">&amp;nbsp;at&amp;nbsp;</span>
                    <field name="probability" widget="integer"/>
                    <span>%%</span>
                </div>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <label for="contact_name"/>
                <div>
                    <div class="o_row">
                        <field name="contact_name"/>
                        <field name="title" domain="[]"
                            options="{'no_open': True}" can_create="true" can_write="true"
                            attrs="{'invisible': [('contact_name', '=', False)]}"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="of_crm_lead_view_form" model="ir.ui.view">
        <field name="name">of.crm.lead.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <!-- Add names to standard groups in 'Extra information page' -->
            <xpath expr="//page[@name='lead']//field[@name='partner_name']/.." position="attributes">
                <attribute name="name">lead_contact_information</attribute>
            </xpath>
            <xpath expr="//page[@name='lead']//field[@name='campaign_id']/.." position="attributes">
                <attribute name="name">lead_marketing</attribute>
            </xpath>

            <!-- "Header" part -->
            <xpath expr="//form//header//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="attrs">{'invisible': ['|','|', ('active','=',False), ('probability', 'in', (0,100)), ('type', '=', 'lead')]}</attribute>
            </xpath>
            <xpath expr="//form//header//button[@name='action_set_lost']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('type', '=', 'opportunity'), '&amp;', ('probability', 'in', (0,100)), ('active', '=', False)]}</attribute>
            </xpath>
            <!-- /"Header" part -->

            <!-- "Opportunity" visible group part -->
            <xpath expr="//field[@name='name']/ancestor::div" position="before">
                <!-- font-size: calc(1.3rem + 0.6vw); => h3 (odoo/addons/web/static/lib/bootstrap/dist/css/bootstrap.css) -->
                <separator
                    name="oppportunity_sep" string="Opportunity"
                    style="box-shadow: none !important; font-size: calc(1.3rem + 0.6vw);"
                    attrs="{'invisible': [('type', '=', 'lead')]}"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']" position="attributes">
                <attribute name="string">Prospect</attribute>
            </xpath>
            <xpath expr="//field[@name='date_deadline']" position="attributes">
                <attribute name="string">Closing date</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']//field[@name='partner_id']" position="after">
                <field name="is_company"/>
                <field name="of_website" widget="url"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_partner']//field[@name='partner_id']" position="before">
                <field name="of_title" string="Title" attrs="{'invisible': [('is_company','=',True)]}"/>
            </xpath>
            <xpath expr="//page[@name='lead']//field[@name='zip']" position="before">
                <field name="zip_id" placeholder="City completion" options="{'no_open': True, 'no_create': True}" class="oe_edit_only"/>
            </xpath>
            <xpath expr="//div[hasclass('o_lead_opportunity_form_inline_fields')]/.." position="attributes">
                <attribute name="name">opportunity_followup</attribute>
                <attribute name="string">Qualification and follow-up</attribute>
            </xpath>
            <xpath expr="//group[@name='opportunity_followup']//field[@name='user_id']" position="before">
                <xpath expr="//group[@name='opportunity_followup']//label[@for='date_deadline']" position="move"/>
                <xpath expr="//group[@name='opportunity_followup']//field[@name='date_deadline']/ancestor::div" position="move"/>
                <field name="company_id"/>
                <xpath expr="//group[@name='opportunity_followup']//field[@name='tag_ids']" position="move"/>
            </xpath>
            <xpath expr="//group[@name='opportunity_followup']//field[@name='user_id']" position="after">
                <field name="of_canvasser_id" widget="many2one_avatar_user"/>
                <xpath expr="//group[@name='opportunity_partner']//field[@name='lost_reason_id']" position="move"/>
            </xpath>
            <xpath expr="//group[@name='lead_marketing']" position="after">
                <group string="Dates" name="dates" attrs="{'invisible': [('type', '=', 'lead')]}">
                    <field name="of_prospecting_date" string="Creation date" />
                    <field name="write_date" string="Latest modifications" widget="date" readonly="1"/>
                </group>
                <group string="Miscellaneous" name="miscellaneous">
                    <field name="of_ref"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='lead_marketing']//field[@name='referred']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group[@name='lead_marketing']//field[@name='referred']" position="after">
                <field name="of_referred_id" />
            </xpath>
            <xpath expr="//group[@name='lead_marketing']//field[@name='medium_id']" position="attributes">
                <attribute name="string">Canal</attribute>
            </xpath>
            <xpath expr="//group[@name='Misc']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- /"Opportunity" visible group part -->

            <!-- "Lead" visible group part -->
            <xpath expr="//group[@name='lead_partner']//div[hasclass('o_address_format')]" position="after">
                <field name="of_website" widget="url"/>
            </xpath>
            <xpath expr="//group[@name='lead_partner']//field[@name='zip']" position="before">
                <field name="zip_id" placeholder="City completion" options="{'no_open': True, 'no_create': True}" class="oe_edit_only"/>
            </xpath>
            <xpath expr="//page[@name='extra']//group[@name='categorization']//field[@name='referred']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='extra']//group[@name='categorization']//field[@name='referred']" position="after">
                <field name="of_referred_id" />
            </xpath>
            <xpath expr="//page[@name='extra']//group[@name='categorization']//field[@name='medium_id']" position="attributes">
                <attribute name="string">Canal</attribute>
            </xpath>
            <!-- /"Lead" visible group part -->

            <!-- Always visible fields -->
            <xpath expr="//page[@name='internal_notes']//field[@name='description']" position="before">
                <separator string="Description" colspan="2"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']//field[@name='description']" position="after">
                <separator string="Additionnal infos" colspan="2"/>
                <field name="of_additionnal_infos" placeholder="Additionnal infos..." options="{'collaborative': true}"/>
            </xpath>
            <!-- /Always visible fields -->
        </field>
    </record>

    <record id="of_crm_case_tree_view_oppor" model="ir.ui.view">
        <field name="name">crm.lead.tree.opportunity</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="decoration-danger">of_date_action and (of_date_action &lt; current_date)</attribute>
            </tree>
            <!-- Simplification des titres -->
            <xpath expr="//tree//field[@name='create_date']" position="attributes">
                <attribute name="string">Date</attribute>
            </xpath>
            <xpath expr="//tree//field[@name='priority']" position="after">
                <field name="of_date_action"/>
                <field name="of_title_action"/>
            </xpath>
        </field>
    </record>

    <record id="of_view_crm_case_opportunities_filter" model="ir.ui.view">
        <field name="name">of.crm.crm.lead.search.opportunity</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="zip"/>
                <field name="contact_name"/>
                <field name="company_id"/>
            </field>
            <xpath expr="//filter[@name='message_needaction']" position="before">
                <filter name="create_this_week" string="Created this week"
                        domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter name="write_this_week" string="Modified this week"
                        domain="[('write_date', '>=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='overdue_opp']" position="before">
                <filter string="Today Activities" name="of_crm_activities_today"
                        domain="[('of_date_action_filter', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week Activities To Do" name="of_crm_activities_this_week"
                    domain="[('of_date_action_filter', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%Y-%m-%d')),
                            ('of_date_action_filter', '&lt;', (context_today() + datetime.timedelta(days=7-context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <filter string="Overdue Activities" name="of_crm_activities_overdue"
                    domain="[('of_date_action_filter', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                    help="Show all opportunities for which the next action date is before today"/>
                <separator/>
            </xpath>
        </field>
    </record>


    <!-- AS LEADS -->

    <record  id="of_crm_case_tree_view_leads" model="ir.ui.view">
        <field name="name">of.crm.case.tree.view.leads</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_tree_view_leads"/>
        <field name="arch" type="xml">
            <field name="city" position="before">
                <field name="zip"/>
            </field>
            <field name="country_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="email_from" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="phone" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="team_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <xpath expr="//field[@name='priority']" position="replace"/>
            <xpath expr="//field[@name='tag_ids']" position="replace"/>
            <field name="team_id" position="after">
                <field name="priority" optional="show"/>
                <field name="tag_ids" optional="show" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </field>
        </field>
    </record>

    <record id="of_crm_view_crm_case_leads_filter" model="ir.ui.view">
        <field name="name">of.crm.lead.search - Leads</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="zip"/>
                <field name="contact_name"/> <!-- Why ? 'name' already search into 'contact_name' -->
            </field>
        </field>
    </record>

    <record id="of_crm_case_calendar_view_leads" model="ir.ui.view">
        <field name="name">of.crm.lead.calendar.lead</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_calendar_view_leads"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='expected_revenue']" position="before">
                <field name="name"/>
                <field name="of_title_action"/>
            </xpath>
        </field>
    </record>


    <!-- Actions -->


</odoo>
