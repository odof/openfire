<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="of_crm_of_crm_activity_comp_rule" model="ir.rule">
        <field name="name">OF CRM Activities multi-company</field>
        <field name="model_id" ref="model_of_crm_activity"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', '|', ('opportunity_id', '=', False), ('opportunity_id.company_id', '=', False), ('opportunity_id.company_id', 'child_of', company_ids)]</field>
    </record>

    <record id="of_crm_of_crm_activity_user_rule" model="ir.rule">
        <field name="name">OF CRM Activities (user)</field>
        <field name="model_id" ref="model_of_crm_activity"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['&amp;', '|', ('user_id', '=', False), ('user_id.company_ids', 'in', company_ids),
                                             '|', ('vendor_id', '=', False), ('vendor_id.company_ids', 'child_of', company_ids)]</field>
    </record>

</odoo>
