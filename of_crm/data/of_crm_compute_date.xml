<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="compute_date_today" model="of.crm.compute.date">
        <field name="name">Date of the day</field>
        <field name="res_model"></field>
        <field name="sequence">10</field>
        <field name="res_field">today_date</field>
    </record>

    <record id="compute_date_opportunity_project" model="of.crm.compute.date">
        <field name="name">Project date</field>
        <field name="res_model">opportunity</field>
        <field name="sequence">20</field>
        <field name="res_field">of_date_project</field>
    </record>

    <record id="compute_date_opportunity_decision" model="of.crm.compute.date">
        <field name="name">Decision date</field>
        <field name="res_model">opportunity</field>
        <field name="sequence">30</field>
        <field name="res_field">date_deadline</field>
    </record>

</odoo>
