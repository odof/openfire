<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sale_order_portal_template" inherit_id="sale.sale_order_portal_template">
        <xpath expr="//t[@t-call='portal.signature_form']" position="inside">
            <t t-set="mode" t-value="'draw'"/>
        </xpath>
    </template>

    <template id="sale_order_portal_content" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//td[@id='product_name']/span" position="replace">
            <span t-field="line.of_display_name"/>
        </xpath>
    </template>

</odoo>
