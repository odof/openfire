<odoo>

    <template id="of_report_saleorder_list">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <table class="table table-sm o_main_table table-borderless mt-4">
                        <thead>
                            <tr>
                                <th name="th_date">Date</th>
                                <th name="th_number">Number</th>
                                <th name="th_customer">Customer</th>
                                <th name="th_city">City</th>
                                <th name="th_state">State</th>
                                <th name="th_tax_excl" class="text-end">Taxes excl.</th>
                                <th name="th_tax_incl" class="text-end">Taxes incl.</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td name="td_date"><span  t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                                    <td name="td_number"><span t-field="doc.name"/></td>
                                    <td name="td_customer"><span t-field="doc.partner_id"/> </td>
                                    <td name="td_city"><span t-field="doc.partner_id.city"/></td>
                                    <td name="td_state"><span t-field="doc.state"/> - <span t-field="doc.invoice_status"/></td>
                                    <td name="td_tax_excl" class="text-end">
                                        <span t-field="doc.amount_untaxed"
                                            t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                    </td>
                                    <td name ="td_tax_incl" class="text-end">
                                        <span t-field="doc.amount_total"
                                            t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <td><strong>Total</strong></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-end">
                                    <strong>
                                    <span t-esc="sum(docs.mapped('amount_untaxed'))"
                                        t-options='{"widget": "monetary", "display_currency": docs[0].pricelist_id.currency_id}'/>
                                    </strong>
                                </td>
                                <td class="text-end">
                                    <strong>
                                    <span t-esc="sum(docs.mapped('amount_total'))"
                                        t-options='{"widget": "monetary", "display_currency": docs[0].pricelist_id.currency_id}'/>
                                    </strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <report
        id="of_report_sale_order_list"
        string="Orders List"
        model="sale.order"
        report_type="qweb-pdf"
        file="of_sale.of_report_saleorder_list"
        name="of_sale.of_report_saleorder_list"
        multi="True"
        paperformat="of_base.paperformat_euro_internal"
    />

</odoo>
