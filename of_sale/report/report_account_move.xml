<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <template id="of_sale_report_invoice_document" inherit_id="account.report_invoice_document">

        <!-- Lines and totals block -->
        <xpath expr="//th[@name='th_priceunit']" position="attributes">
            <attribute name="t-if">o.of_price_printing == 'order_line'</attribute>
        </xpath>
        <xpath expr="//th[@name='th_price_unit']" position="attributes">
            <attribute name="t-if">o.of_price_printing == 'order_line' and display_discount</attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">o.of_price_printing == 'order_line'</attribute>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="t-if">o.of_price_printing == 'order_line'</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_unit']/.." position="attributes">
            <attribute name="name">td_priceunit</attribute>
            <attribute name="t-if">o.of_price_printing == 'order_line'</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.discount']/.." position="attributes">
            <attribute name="name">td_discount</attribute>
            <attribute name="t-if">o.of_price_printing == 'order_line' and display_discount</attribute>
        </xpath>
        <xpath expr="//span[@id='line_tax_ids']/.." position="attributes">
            <attribute name="t-if">o.of_price_printing == 'order_line'</attribute>
        </xpath>

        <xpath expr="//tbody[hasclass('invoice_tbody')]//td[hasclass('o_price_total')]" position="attributes">
            <attribute name="name">td_price_total</attribute>
            <attribute name="t-if">o.of_price_printing == 'order_line'</attribute>
        </xpath>
        <!-- /Lines and totals block -->
    </template>


</odoo>
