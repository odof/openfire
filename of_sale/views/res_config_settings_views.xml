<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Account -->
    <record id="of_sale_account_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.sale.res.config.settings.view.form.inherit.account</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="41"/>  <!-- parent view has priority 40 -->
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']" position="after">
                <h2>PDF Printing</h2>
                <div class="row mt16 o_settings_container" id="invoicing_printing_settings">
                    <div class="col-xs-12 col-md-6 o_setting_right_pane" id="of_sections_headings_config">
                        <span class="o_form_label">Section headings</span>
                        <div class="text-muted">
                            Customize the background color and the font of your sections headings
                        </div>
                        <div class="w-50 row">
                            <span class="d-block w-75 py-2">Background color</span>
                            <field name="of_color_bg_section" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                        <div class="w-50 row mt-1">
                            <span class="d-block w-75 py-2">Font Color</span>
                            <field name="of_color_font_section" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='get_invoice_warnings']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="delivery_note_move">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">(OF) Delivery notes management in Customer Invoice</span>
                        <div class="content-group">
                            <field name="of_validate_pickings_on_move"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Sale -->
    <record id="of_sale_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.sale.res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='deposit_default_product_id']/.." position="after">
                <div class="text-muted">
                    (OF) Category of items used for down payments
                </div>
                <div class="text-muted">
                    <field name="of_deposit_product_categ_id"/>
                </div>
            </xpath>
            <xpath expr="//div[@id='proforma_configuration']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="of_sale_mail_subtype_subscribtion">
                    <div class="o_setting_left_pane">
                        <field name="of_sale_mail_subtype_subscribtion"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_sale_mail_subtype_subscribtion"/>
                        <div class="text-muted">
                            <p>Adds a new subtype E-Mail for sale orders. Only the recipients and subscribers to this document subtype will receive emails.</p>
                            <p>The mail composer will automatically select this subtype when sending a message from a sale order.</p>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="order_line_configuration">
                    <div class="o_setting_left_pane">
                        <field name="module_of_order_line_option"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="module_of_order_line_option"/>
                        <div class="text-muted">
                            Enable order line options
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="of_fiscal_position_required">
                    <div class="o_setting_left_pane">
                        <field name="of_fiscal_position_required"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_fiscal_position_required"/>
                        <div class="text-muted">
                            Force the use of tax positions in quotes/orders
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="of_allow_quote_addition">
                    <div class="o_setting_left_pane">
                        <field name="of_allow_quote_addition"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_allow_quote_addition"/>
                        <div class="text-muted">
                            Allow additional quotes to be added to sale orders
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="of_grouped_invoicing">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_grouped_invoicing"/>
                        <div class="text-muted">
                            Group invoicing on sale orders
                        </div>
                        <div class="mt16">
                            <field name="of_grouped_invoicing" class="o_light_label" widget="radio" style="display: inline;" />
                        </div>
                    </div>
                </div>
                <div class="col-24 col-lg-6 o_setting_box" id="of_stop_payment_term_propagation">
                    <div class="o_setting_left_pane">
                        <field name="of_stop_payment_term_propagation"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_stop_payment_term_propagation"/>
                        <div class="text-muted">
                            If checked that will stop the propagation of the payment term from the sale order to the invoice
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="of_sale_confirmation_date_mode">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_sale_confirmation_date_mode"/>
                        <div class="text-muted">
                            <p>Choose the mode of the confirmation date of the sale order.</p>
                        </div>
                        <div class="mt16">
                            <field name="of_sale_confirmation_date_mode" class="o_light_label" widget="radio" style="display: inline;" />
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="group_of_display_tax_inclued_total_in_so_lines">
                    <div class="o_setting_left_pane">
                    </div>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">(OF) Manage the display of the total tax excl./incl. by command line in sales order forms</span>
                    </div>
                    <div class="content-group">
                        <div class="o_setting_right_pane">
                            <field name="group_of_display_tax_exclued_total_in_so_lines"/>
                            <div class="text-muted" style="display: inline;">
                                Displays subtotals tax excl. by command line in sales order forms.
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <field name="group_of_display_tax_inclued_total_in_so_lines"/>
                            <div class="text-muted" style="display: inline;">
                                Displays subtotals tax incl. by command line in sales order forms.
                            </div>
                        </div>
                        <div class="o_setting_right_pane">
                            <field name="show_warning_b2b_to_b2c" invisible="1"/>
                            <field name="show_warning_b2c_to_b2b" invisible="1"/>
                            <div style="color: orange" attrs="{'invisible': [('show_warning_b2b_to_b2c', '=', False)]}">
                                Warning: We have changed the "Line subtotals tax display" option in the accounting settings (from B2B to B2C)
                            </div>
                            <div style="color: orange" attrs="{'invisible': [('show_warning_b2c_to_b2b', '=', False)]}">
                                Warning: We have changed the "Line subtotals tax display" option in the accounting settings (from B2C to B2B)
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
