<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_sale_view_partner_form" model="ir.ui.view">
        <field name="name">of.sale.view.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='property_payment_term_id']" position="after">
                <field name="of_invoice_policy" groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <record id="of_view_res_partner_sale_warn_hide_form" model="ir.ui.view">
        <field name="name">of.view.res.partner.sale.warn.hide.form</field>
        <field name="model">res.partner</field>
        <field name="priority" eval="3"/> <!-- parent view priority is set to 3 -->
        <field name="inherit_id" ref="sale.res_partner_view_buttons"/>
        <field name="arch" type="xml">
            <!-- Hide the default warning features -->
            <xpath expr="//field[@name='sale_warn']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="of_view_res_partner_sale_warn_form" model="ir.ui.view">
        <field name="name">of.view.res.partner.sale.warn.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="of_account.of_res_partner_warnings_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']//div[@name='of_div_account_warn']" position="before">
                <div name="of_div_sale_warn">
                    <field name="of_is_sale_warn" nolabel="1" class="oe_inline"/> sales order
                </div>
            </xpath>
        </field>
    </record>

</odoo>
