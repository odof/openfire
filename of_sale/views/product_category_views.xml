<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_sale_product_category_main_product_form_view" model="ir.ui.view">
        <field name="name">of.sale.product.category.main.product.form</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="inside">
                <field name="of_main_product"/>
            </xpath>
        </field>
    </record>

    <menuitem id="of_product_category_config_menu" action="product.product_category_action_form" parent="sale.prod_config_main" sequence="10" />

</odoo>
