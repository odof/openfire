<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="product_template_view_tree" model="ir.ui.view">
        <field name="name">of.sale.product.template.view.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="invoice_policy" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="of_sale_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.view.inherit.sale</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_policy']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='expense_policy']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='invoicing']//group[@name='properties']//field[@name='property_account_income_id']/.." position="before">
                <group string="Invoicing" name="invoicing">
                    <field name="invoice_policy" required="1"/>
                    <field name="expense_policy" widget="radio" attrs="{'invisible': [('visible_expense_policy', '=', False)]}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
