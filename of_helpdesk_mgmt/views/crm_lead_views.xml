<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.view.form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="of_crm.of_crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='of_ref']" position="after">
                <field name="of_ticket_id"/>
            </xpath>
        </field>
    </record>

    <record id="crm_lead_view_search" model="ir.ui.view">
        <field name="name">crm.lead.view.search</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="of_crm.of_crm_view_crm_case_leads_filter"/>
        <field name="arch" type="xml">
            <field name="contact_name" position="after">
                <field name="of_ticket_id"/>
            </field>
        </field>
    </record>

</odoo>
