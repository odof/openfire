<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="of_industry.product_template_view_form"/>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='standard']" position="inside">
                <field name="of_standard_id" widget="selection"/>
                <field colspan="2" name="of_standard_description" nolabel="1" placeholder="This note describes the product standards and is added to sales orders and invoices."/>
            </xpath>
        </field>
    </record>

    <record id="product_template_view_form_2" model="ir.ui.view">
        <field name="name">product.template.view.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="of_industry.product_template_view_form"/>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='standard']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="attrs"></attribute>
            </xpath>
        </field>
    </record>

    <record id="of_sale_product_standard.product_template_view_form" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

</odoo>
