<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mail_mass_mailing_view_form" model="ir.ui.view">
        <field name="name">mail.mass.mailing.view.form</field>
        <field name="model">mail.mass_mailing</field>
        <field name="inherit_id" ref="mass_mailing.view_mail_mass_mailing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='put_in_queue']" position="attributes">
                <attribute name="confirm">Ceci va envoyer le courriel à tous les destinataires par lot. Êtes-vous sûr de le vouloir ?</attribute>
            </xpath>
        </field>
    </record>

</odoo>