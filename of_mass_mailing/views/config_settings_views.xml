<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mass_mailing_configuration" model="ir.ui.view">
        <field name="inherit_id" ref="mass_mailing.view_mass_mailing_configuration"/>
        <field name="name">mass.mailing.config.settings.inherit</field>
        <field name="model">mass.mailing.config.settings</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='mass_mailing_group']" position="after">
                <group>
                    <group>
                        <label for="of_mass_mailing_limit"/>
                        <div>
                            <field name="of_mass_mailing_limit" class="oe_inline"/>
                            <span>
                                emails / heure
                            </span>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
