<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="of_map_view.PopupMap" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@id='popup-content']" position="inside">
            <t t-if="model == 'crm.lead'">
                <t t-if="props.record.of_partner_name">
                    <i class="fa fa-user pe-1"/><strong t-esc="props.record.of_partner_name"/><br/>
                </t>
                <t t-if="props.record.name">
                    <span t-esc="props.record.name"/><br/>
                </t>
                <t t-if="props.record.of_zip or props.record.of_city">
                    <i class="fa fa-map-marker pe-1"/><span t-if="props.record.of_zip" t-esc="props.record.of_zip"/> <span t-if="props.record.of_city" t-esc="props.record.of_city"/><br/>
                </t>
                <t t-if="props.record.of_partner_phones">
                    <i class="fa fa-phone pe-1"/><span t-esc="props.record.of_partner_phones"/><br/>
                </t>
                <t t-if="props.record.of_lead_tags">
                    <i class="fa fa-tags pe-1"/><span t-esc="props.record.of_lead_tags"/><br/>
                </t>
            </t>
        </xpath>
    </t>

</templates>
