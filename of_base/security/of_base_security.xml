<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Restreindre l'accès au menu "Applications" à l'utilisateur root (admin) -->
    <!-- Ajout d'un groupe pour l'administrateur uniquement -->
    <record id="of_base.of_group_root_only" model="res.groups">
        <field name="name">Admin only</field>
        <field name="comment">Group only for admin (root) user</field>
        <field name="users" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Création groupe utilisateurs intranet -->
    <record id="of_base.of_group_intranet" model="res.groups">
        <field name="name">Intranet</field>
        <field name="category_id" ref="base.module_category_extra"/>
        <field name="comment">OpenFire rights: gives access rights to the intranet</field>
    </record>

    <record id="of_base.of_group_hidden" model="res.groups">
        <field name="name">Hidden Special Group</field>
        <field name="comment">OpenFire special group : allows to hide some menu items</field>
    </record>

    <record id="of_group_openfire_contract" model="res.groups">
        <field name="name">Modify OpenFire contract</field>
        <field name="comment">Users who can make changes affecting the OpenFire contract</field>
        <field name="users" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="of_group_block_password_modification" model="res.groups">
        <field name="name">(OF) Block password modification</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Restrict access to the password modification link in the "Preferences" menu</field>
    </record>

</odoo>
