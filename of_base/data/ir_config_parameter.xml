<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_master_database_url" model="ir.config_parameter">
        <field name="key">of.openfire.database.url</field>
        <field name="value">https://openfire16.openfire.fr</field>
    </record>

    <record id="of_documentation_url" model="ir.config_parameter">
        <field name="key">of.openfire.documentation.url</field>
        <field name="value">https://support.openfire.fr/docs</field>
    </record>

    <record id="of_support_url" model="ir.config_parameter">
        <field name="key">of.openfire.support.url</field>
        <field name="value">https://back.openfire.fr/support/ticket/submit</field>
    </record>

</odoo>
