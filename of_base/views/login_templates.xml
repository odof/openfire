<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Page de connexion : remplacer email par indentifiant (login) -->
    <template id="of_base_login" name="Login" inherit_id="web.login">
        <xpath expr="//div[@class='mb-3 field-login']/label[@for='login']" position="replace">
            <label for="login" class="form-label">Login</label>
        </xpath>
    </template>

</odoo>
