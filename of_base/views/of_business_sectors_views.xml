<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_business_sectors_view_form" model="ir.ui.view">
        <field name="name">of_business.sectors.view.form</field>
        <field name="model">of.business.sectors</field>
        <field name="arch" type="xml">
            <form string="Business sector">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_business_sectors_view_tree" model="ir.ui.view">
        <field name="name">of_business.sectors.view.tree</field>
        <field name="model">of.business.sectors</field>
        <field name="arch" type="xml">
            <tree string="Business sectors">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id="of_business_sectors_action" model="ir.actions.act_window">
        <field name="name">Business sectors</field>
        <field name="res_model">of.business.sectors</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="of_business_sectors_action_menu" name="Business sectors" action="of_business_sectors_action" parent="resource.menu_resource_config" sequence="10"/>

</odoo>
