<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vue form utilisateur :
        - Ajout du champ "Type d'utilisateur"
        - Ajout d'un onglet "Connexions" dans le formulaire utilisateur, invisible par défaut, pouvant être utilisé
        par d'autres modules
    -->
    <record id="view_users_form" model="ir.ui.view">
        <field name="name">view.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']/group//field[@name='partner_id']" position="after">
                <field name="of_user_type"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="connections" string="Connections" invisible="1">
                    <group/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>