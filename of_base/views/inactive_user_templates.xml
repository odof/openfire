<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- based on web.login_layout -->
    <template id="of_base.inactive_user_layout" name="Inactive User Layout">
        <t t-call="web.frontend_layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <t t-set="body_classname" t-value="'bg-100'"/>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>

            <div class="container py-5">
                <div t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list" style="max-width: 450px;">
                    <div class="card-body">
                        <div t-attf-class="text-center pb-3 border-bottom {{'mb-3' if form_small else 'mb-4'}}">
                            <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
                        </div>
                        <t t-out="0"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- based on web.login -->
    <template id="of_base.inactive_user" name="Inactive User">
        <t t-call="of_base.inactive_user_layout">
            <form class="oe_login_form" role="form" t-attf-action="/inactiveuser" method="post" onsubmit="this.action = /inactiveuser + location.hash">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <p class="alert alert-warning" role="alert">
                    <label>You cannot access the OpenFire WEB application from an "Inactive resource" account.</label>

                </p>

                <div t-attf-class="clearfix oe_login_buttons text-center gap-1 d-grid mb-1 {{'pt-2' if form_small else 'pt-3'}}">
                    <button type="submit" class="btn btn-primary">Log out</button>
                </div>

                <input type="hidden" name="redirect" value="1"/>
            </form>
        </t>
    </template>

</odoo>
