<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_base_partner_form" model="ir.ui.view">
        <field name="name">of.base.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Ajout header de vue form pour captain hook -->
            <xpath expr="//sheet" position="before">
                <header/>
            </xpath>


            <!-- Hide standard fields to manage their positions -->
            <xpath expr="//group//field[@name='title']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group//field[@name='function']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group//field[@name='email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group//field[@name='lang']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group//field[@name='phone']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group//field[@name='mobile']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='state_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='city']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Permet de voir les catégories du parent -->
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="of_parent_category_id" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}"
                        attrs="{'invisible': [('parent_id', '=', False)]}"/>
            </xpath>

            <!-- Default address -->
            <xpath expr="//kanban//field[@name='display_name']" position="after">
                <field name="of_default_address"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']/kanban/templates/t//div[hasclass('oe_kanban_details')]/field[@name='name']" position="after">
                <t t-if="record.type.raw_value"> (<field name="type"/>)</t>
                <t t-if="record.of_default_address.raw_value"> <span class="fa fa-star">&amp;nbsp;</span></t>
            </xpath>
            <xpath expr="//field[@name='child_ids']/form/sheet//div[@name='div_address']/parent::node()" position="after">
                <field name="of_default_address" attrs="{'invisible': [('type', 'not in', ('invoice', 'delivery'))]}"/>
            </xpath>

            <!-- Move City after Zip -->
            <xpath expr="//field[@name='zip']" position="after">
                <field name="city" placeholder="City" class="o_address_city"
                        attrs="{'readonly': [('type', '=', 'contact'),('parent_id', '!=', False)]}"/>
            </xpath>

            <!-- Move Contact's title after Form title part -->
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <group>
                        <field name="title" options='{"no_open": True}' placeholder="e.g. Mister" attrs="{'invisible': [('is_company', '=', True)]}"/>
                    </group>
                </group>
            </xpath>

            <!-- Ajout aide du champ comment (notes internes / notes client) -->
            <xpath expr="//page[@name='internal_notes']//field[@name='comment']" position="attributes">
                <attribute name='placeholder'>Customer note...</attribute>
                <attribute name='help'>These notes will be displayed under the heading 'Customer notes' in the quote and the intervention schedule.</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']//field[@name='comment']" position="after">
                <div class="oe_edit_only" colspan="4">
                    * The data entered in this field will be displayed under the heading 'Customer notes' in the quote and the intervention schedule.
                </div>
            </xpath>

            <!-- Gestion des numéros de téléphone -->
            <xpath expr="//group//field[@name='phone']" position="after">
                <field name="of_phone_number_ids" string="Phones" class="of_phone_table" widget="of_light_x2many">
                    <tree editable="bottom" decoration-danger="not is_valid">
                        <field name="type" string="Type"/>
                        <field name="title_id" string="Title" options="{'no_open': True, 'no_create_edit': True}"/>
                        <field name="number_display" string="Number" placeholder="Number" required="True"/>
                        <field name="number" invisible="1" readonly="1"/>
                        <field name="is_valid" invisible="1"/>
                    </tree>
                </field>
                <field name="function" placeholder="e.g. Sales Director" attrs="{'invisible': [('is_company','=', True)]}"/>
                <field name="lang"/>
            </xpath>

            <!--  Add new notebook pages  -->
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <page name="history" string="History"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="communication" string="Communication" invisible="1">
                    <group/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="of_base_partner_form_mail" model="ir.ui.view">
        <field name="name">of.base.partner.form.mail</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="of_base.of_base_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='email']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='email']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='of_phone_number_ids']" position="after">
                <field name="is_blacklisted" invisible="1"/>
                <label for="email" class="oe_inline"/>
                <div class="o_row o_row_readonly">
                    <button name="mail_action_blacklist_remove" class="fa fa-ban text-danger"
                        title="This email is blacklisted for mass mailings. Click to unblacklist."
                        type="object" context="{'default_email': email}" groups="base.group_user"
                        attrs="{'invisible': [('is_blacklisted', '=', False)]}"/>
                    <field name="email" widget="email" context="{'gravatar_image': True}" attrs="{'required': [('user_ids','!=', [])]}"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="of_res_partner_tree" model="ir.ui.view">
        <field name="name">of.res.partner.tree</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="street"/>
                <field name="zip" string="CP"/>
                <field name="city"/>
            </xpath>
            <xpath expr="//field[@name='phone']" position="after">
                <field name="mobile"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='email']" position="after">
                <field name="category_id" optional="hide" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="user_id" string="Salesperson" optional="show" widget="many2one_avatar_user" domain="[('share', '=', False)]"/>
                <field name="type"/>
            </xpath>
        </field>
    </record>

    <record id="of_res_partner_filter" model="ir.ui.view">
        <field name="name">of.res.partner.select</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="replace"/>
            <xpath expr="//field[@name='name']" position="after">
                <field name="street" string="Street or additional address"
                    filter_domain="['|', ('street', 'ilike', self), ('street2', 'ilike', self)]"/>
                <field name="zip"/>
                <field name="city"/>
                <field name="phone" filter_domain="[('of_phone_number_ids.number', 'ilike', self)]"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="string">Salesperson</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="email"/>
                <field name="company_id"/>
                <field name="ref"/>
                <field name="type"/>
            </xpath>
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Potential duplicates" name="duplications" domain="[('of_potential_duplication', '=', True)]"/>
                <separator/>
            </xpath>
            <xpath expr="//search//filter[@name='group_company']" position="replace">
                <filter string="Parent" name="group_parent" context="{'group_by': 'parent_id'}"/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Ajouter type adresse (livraison, facture, ...) dans vue kanban quand est un contact -->
    <record id="of_res_partner_kanban" model="ir.ui.view" >
        <field name="name">of.res.partner.kanban</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban//field[@name='display_name']" position="after">
                <t t-if="record.type.raw_value and record.parent_id.raw_value"> (<field name="type"/>)</t>
            </xpath>
        </field>
    </record>

</odoo>
