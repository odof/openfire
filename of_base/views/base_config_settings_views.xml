<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_base_view_general_configuration" model="ir.ui.view">
        <field name="name">of.res.config.settings.view.form.inherit.base.setup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']//div[@name='contacts_setting_container']/div[@id='partner_autocomplete']" position="after">
                <div class="col-xs-12 col-md-6 o_setting_box" id="openfire">
                    <div class="col-12 col-lg-6 o_setting_box" id="autocompletion_reference">
                        <div class="o_setting_right_pane">
                            <label for="of_ref_mode"/>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="of_ref_mode" class="o_light_label" widget="radio" options="{'horizontal': true}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box" id="display_city">
                        <div class="o_setting_left_pane">
                            <field name="of_display_city"/>
                        </div>
                        <div class="o_setting_right_pane" id="partner_autocomplete_settings">
                            <label for="of_display_city"/>
                            <div class="text-muted">
                                Displays the city in parentheses after the partner name when searching for a partner
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
