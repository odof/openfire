<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_base_view_general_configuration" model="ir.ui.view">
        <field name="name">of.res.config.settings.view.form.inherit.base.setup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='contacts_settings']//div[@name='contacts_setting_container']/div[@id='partner_autocomplete']" position="after">
                <div class="col-xs-12 col-md-6 o_setting_box" id="openfire">
                    <div class="col-12 col-lg-6 o_setting_box" id="autocompletion_reference">
                        <div class="o_setting_right_pane">
                            <label for="of_ref_mode" />
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="of_ref_mode" class="o_light_label" widget="radio" options="{'horizontal': true}" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box" id="display_city">
                        <div class="o_setting_left_pane">
                            <field name="of_display_city" />
                        </div>
                        <div class="o_setting_right_pane" id="partner_autocomplete_settings">
                            <label for="of_display_city" />
                            <div class="text-muted">
                                Displays the city in parentheses after the partner name when
                                searching for a partner
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='languages']" position="after">
                <div id="base_informations" groups="of_base.of_group_root_only">
                    <h2>Base</h2>
                    <div class="row mt16 o_settings_container" name="base_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="base_invoicing_plan">
                            <div class="o_setting_right_pane">
                                <label for="of_invoicing_plan" />
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="of_invoicing_plan" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" id="base_business_sectors_ids">
                            <div class="o_setting_right_pane">
                                <label for="of_business_sectors_ids" />
                                <div class="content-group">
                                    <div class="mt16">
                                        <field name="of_business_sectors_ids_str" invisible="1"/>
                                        <field name="of_business_sectors_ids" widget="many2many_tags" options="{'no_create_edit': True, 'no_create': True}" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" name="base_type_setting_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" id="base_type">
                                <div class="o_setting_right_pane">
                                    <label for="of_base_type" />
                                    <div class="content-group">
                                        <div class="mt16">
                                            <field name="of_base_type" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>


    </record>

</odoo>
