<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_create_migration_form" model="ir.ui.view">
        <field name="name">create.migration.wizard.form</field>
        <field name="model">create.migration.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="start_version"/>
                    <field name="end_version"/>
                    <field name="database_id"/>
                    <field name="server_id"/>
                    <field name="planning_date"/>
                </group>

                <footer>
                    <button name="action_create_migration" type="object" string="Create Migration" class="oe_highlight"/>
                    or
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
