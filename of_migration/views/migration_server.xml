<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="migration_server_view_form" model="ir.ui.view">
        <field name="name">migration.server.view.form</field>
        <field name="model">migration.server</field>
        <field name="arch" type="xml">
            <form string="Servers">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="host"/>
                        <field name="state"/>
                        <field name="authentication_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="migration_server_view_tree" model="ir.ui.view">
        <field name="name">migration.server.view.tree</field>
        <field name="model">migration.server</field>
        <field name="arch" type="xml">
            <tree string="Server">
                <field name="name"/>
                <field name="host"/>
                <field name="state"/>
                <field name="authentication_id"/>
            </tree>
        </field>
    </record>

    <record id="migration_server_action" model="ir.actions.act_window">
        <field name="name">Server</field>
        <field name="res_model">migration.server</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
