<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="migration_authentication_view_form" model="ir.ui.view">
        <field name="name">migration.authentication.view.form</field>
        <field name="model">migration.authentication</field>
        <field name="arch" type="xml">
            <form string="Authentication">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="password"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="migration_authentication_action" model="ir.actions.act_window">
        <field name="name">Authentication</field>
        <field name="res_model">migration.authentication</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>
