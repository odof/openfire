<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="migration_sql_view_form" model="ir.ui.view">
        <field name="name">migration.sql.view.form</field>
        <field name="model">migration.sql</field>
        <field name="arch" type="xml">
            <form string="SQL">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="version" />
                        <field name="subversion"/>
                        <field name="pre_script" widget="ace"/>
                        <field name="post_script" widget="ace"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="migration_sql_view_tree" model="ir.ui.view">
        <field name="name">migration.sql.view.tree</field>
        <field name="model">migration.sql</field>
        <field name="arch" type="xml">
            <tree string="SQL">
                <field name="sequence" widget="handle"/>
                <field name="name" />
                <field name="version" />
                <field name="subversion"/>
            </tree>
        </field>
    </record>

    <record id="migration_sql_action" model="ir.actions.act_window">
        <field name="name">SQL</field>
        <field name="res_model">migration.sql</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
