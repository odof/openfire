<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="migration_database_view_form" model="ir.ui.view">
        <field name="name">migration.database.view.form</field>
        <field name="model">migration.database</field>
        <field name="arch" type="xml">
            <form string="Databases">
                <header>
                    <button string="Create Migration" name="button_action_create_migration" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="version"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="date_database"/>
                        </group>
                        <group>
                            <field name="backup_file"/>
                        </group>
                        <group>
                            <field name="script_ids"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="migration_database_view_tree" model="ir.ui.view">
        <field name="name">migration.database.view.tree</field>
        <field name="model">migration.database</field>
        <field name="arch" type="xml">
            <tree string="Database">
                <field name="partner_id"/>
                <field name="version"/>
                <field name="status"/>
                <field name="date_database"/>
            </tree>
        </field>
    </record>

    <record id="migration_database_action" model="ir.actions.act_window">
        <field name="name">Database</field>
        <field name="res_model">migration.database</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
