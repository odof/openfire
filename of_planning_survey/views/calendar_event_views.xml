<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="calendar_event_view_form" model="ir.ui.view">
        <field name="name">of.planning.survey.calendar.event.view.form</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="of_planning.calendar_event_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="survey" string="Survey" attrs="{'invisible': [('of_type', '=', 'event')]}">
                    <field name="of_survey_user_input_line_ids" invisible="1" />
                    <div class="row mb-2">
                        <div class="col-6">
                            <label for="of_survey_id"/>
                            <field name="of_survey_id" context="{'default_survey_type': 'intervention_survey'}" />
                        </div>
                        <div class="col-6">
                            <button class="btn btn-primary oe_right ms-2" name="action_button_open_survey" type="object" string="Reply" attrs="{'invisible': [('of_survey_user_input_line_ids','!=',[])]}" />
                            <button class="btn btn-primary oe_right" name="action_button_edit_survey" type="object" string="Edit" attrs="{'invisible': [('of_survey_user_input_line_ids','=',[])]}"/>
                        </div>
                    </div>
                    <field name="of_answers_ids">
                        <tree create="false" edit="false" delete="false" decoration-info="is_page">
                            <field name="question_id" />
                            <field name="answers" />
                            <field name="is_page" invisible="1" />
                        </tree>
                        <form>
                            <group>
                                <field name="question_id" readonly="1" />
                                <field name="answers" readonly="1" />
                                <field name="question_type" invisible="1" />
                                <field name="image_ids" mode="kanban" attrs="{'invisible': [('image_ids','=',[])]}" />
                                <field name="form_filename" invisible="1" />
                                <field name="form" attrs="{'invisible': [('form','=',False)]}" filename="form_filename" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
