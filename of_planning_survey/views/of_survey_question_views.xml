<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_survey_question_form" model="ir.ui.view">
        <field name="name">of.planning.survey.question.form</field>
        <field name="model">of.survey.question</field>
        <field name="inherit_id" ref="of_survey.of_survey_question_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='constr_mandatory']" position="after">
                <field name="constr_no_report_display"/>
            </xpath>
        </field>
    </record>

</odoo>
