<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_intervention_report_document" inherit_id="of_planning.report_intervention_report_document">
        <xpath expr="//div[@name='report_invoicing']" position="after">
            <!-- Survey -->
            <div t-if="template.report_survey and doc.of_answers_ids"
                name="report_survey"
                class="row mb-4" style="page-break-inside: avoid;">
                <div class="col">
                    <h5 name="title_survey">
                        <strong>Survey</strong>
                    </h5>
                    <div class="border border-bottom-0">
                        <table class="table table-condensed mb-0">
                            <tbody>
                                <t t-foreach="doc.of_answers_ids" t-as="answer">
                                    <tr t-att-class="'bg-200' if answer.question_id.is_page else ''">
                                        <td>
                                            <strong t-field="answer.question_id.title" />
                                            <span t-if="not answer.question_id.is_page"> : <span t-field="answer.answers" /></span>
                                            <t t-if="answer.question_id.add_pictures">
                                            <br/>
                                                <t t-foreach="answer.images" t-as="image">
                                                    <div class="col-3">
                                                        <figure class="figure">
                                                            <img t-attf-src="data:image/*;base64,{{image.datas}}" class="figure-img img img-fluid"/>
                                                            <figcaption class="figure-caption"><span t-esc="image.description"/></figcaption>
                                                        </figure>
                                                    </div>
                                                </t>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
