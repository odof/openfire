<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_intervention_sheet_document" inherit_id="of_planning.report_intervention_sheet_document">
        <xpath expr="//div[@name='sheet_invoicing']" position="after">
            <!-- Survey -->
            <div t-if="template.sheet_survey and doc.of_answers_ids" name="sheet_survey" class="row mb-4" style="page-break-inside: avoid;">
                <div class="col">
                    <h5 name="title_survey">
                        <strong>Survey</strong>
                    </h5>
                    <div class="border">
                        <table class="table table-condensed mb-0" style="border-color: transparent;">
                            <tbody>
                                <t t-foreach="doc.of_answers_ids" t-as="answer">
                                    <t t-if="answer.question_id.is_page or answer.answers_images_ids or answer.image_ids">
                                        <tr t-att-class="'bg-200' if answer.question_id.is_page else ''">
                                            <td>
                                                <span><strong t-field="answer.question_id.title"/> :</span>
                                                <t t-if="not answer.question_id.is_page and (answer.answers_images_ids or answer.image_ids)">
                                                    <div t-if="answer.answers_images_ids" class="w-100">
                                                        <t t-foreach="answer.answers_images_ids" t-as="answer_image">
                                                            <span t-field="answer_image.answer" class="d-block"/>
                                                            <t t-if="answer_image.image">
                                                                <img t-attf-src="data:image/png;base64,#{answer_image.image}" class="mr8 img-fluid" alt="Image" style="max-width: 100%; max-height: 400px;"/>
                                                            </t>
                                                        </t>
                                                    </div>
                                                    <table class="d-grid border-0">
                                                        <t t-set="counter" t-value="0"/>
                                                        <tr>
                                                            <t t-foreach="answer.image_ids" t-as="image">
                                                                <t t-if="counter % 3 == 0 and counter > 0">
                                                                    <tr/>
                                                                </t>
                                                                <td style="width: 33.33%; padding: 10px; box-sizing: border-box;">
                                                                    <img t-attf-src="/web/image/of.image/#{image.id}/image_256" class="img-fluid d-flex mx-auto my-2" alt="Image" style="max-width: 100%; max-height: 200px;"/>
                                                                    <div class="text-muted text-center" t-esc="image.caption"/>
                                                                </td>
                                                                <t t-set="counter" t-value="counter + 1"/>
                                                            </t>
                                                        </tr>
                                                    </table>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
