<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_intervention_sheet_document" inherit_id="of_planning.report_intervention_sheet_document">
        <xpath expr="//div[@name='sheet_invoicing']" position="after">
            <!-- Survey -->
            <div t-if="template.sheet_survey and doc.of_answers_ids and doc.of_answers_ids.filtered(lambda a: a.answers)" name="sheet_survey" class="row mb-4" style="page-break-inside: avoid;">
                <div class="col">
                    <h5 name="title_survey">
                        <strong>Survey</strong>
                    </h5>
                    <div class="border">
                        <table class="table table-condensed mb-0" style="border-color: transparent;">
                            <tbody>
                                <t t-set="pages_to_display" t-value="doc._report_of_get_pages_to_display()"/>
                                <!-- Avec sections -->
                                <t t-foreach="pages_to_display" t-as="page">
                                    <tr class="bg-200">
                                        <td>
                                            <strong t-field="page.question_id.title"/> :
                                        </td>
                                    </tr>
                                    <t t-foreach="doc._report_of_get_answers_to_display(page)" t-as="answer">
                                        <t t-call="of_planning_survey.answer_template"/>
                                    </t>
                                </t>
                                <!-- Sans sections -->
                                <t t-if="not pages_to_display">
                                    <t t-foreach="doc._report_of_get_answers_to_display()" t-as="answer">
                                        <t t-call="of_planning_survey.answer_template"/>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
