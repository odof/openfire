#. module: of_custom_document_planning
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__report_picking_pdf
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__sheet_picking_pdf
msgid ""
"Adds PDFs of delivery notes associated with the intervention as an appendix "
"to the PDF document."
msgstr ""
"Ajoute les PDF des bons de livraison associés à l'intervention en annexe du "
"document PDF."

#. module: of_custom_document_planning
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__report_custom_document_ids
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__sheet_custom_document_ids
msgid ""
"Adds customized documents selected in the intervention as an appendix to the"
" PDF document."
msgstr ""
"Ajoute les documents personnalisés sélectionné dans l'intervention en annexe"
" du document PDF."

#. module: of_custom_document_planning
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__report_invoice_pdf
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__sheet_invoice_pdf
msgid ""
"Adds the PDF invoice for the intervention as an appendix to the PDF "
"document."
msgstr ""
"Ajoute le PDF de la facture de l'intervention en annexe du document PDF."

#. module: of_custom_document_planning
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__report_order_pdf
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__sheet_order_pdf
msgid ""
"Adds the PDF of the order associated with the intervention as an appendix to"
" the PDF document."
msgstr ""
"Ajoute le PDF de la commande associée à l'intervention en annexe du document"
" PDF."

#. module: of_custom_document_planning
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__report_purchase_pdf
#: model:ir.model.fields,help:of_custom_document_planning.field_of_planning_intervention_template__sheet_purchase_pdf
msgid ""
"Adds the PDF of the purchase order associated with the intervention as an "
"appendix to the PDF document."
msgstr ""
"Ajoute le PDF de la commande d'achat associée à l'intervention en annexe du "
"document PDF."

