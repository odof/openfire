<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_intervention_template_view_form" model="ir.ui.view">
        <field name="name">of.planning.intervention.template.view.form</field>
        <field name="model">of.planning.intervention.template</field>
        <field name="inherit_id" ref="of_planning.of_planning_intervention_template_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sheet']" position="inside">
                <separator string="Joined documents" name="sheet_joined_documents" />
                <group col="8">
                    <h5 colspan="8">Internal documents</h5>
                    <group colspan="2">
                        <field name="sheet_order_pdf" string="Order" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                        <field name="sheet_picking_pdf" string="Delivery notes" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                    </group>
                    <group colspan="2">
                        <field name="sheet_invoice_pdf" string="Invoices" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                        <field name="sheet_purchase_pdf" string="Purchases" attrs="{'readonly':[('sheet_use_default','=',True)]}" />
                    </group>
                </group>
                <group col="4">
                    <h5 colspan="8">Appendices <i>(Mail templates)</i></h5>
                    <group colspan="4">
                        <field name="sheet_custom_document_ids" string="Joined documents" widget="many2many_tags" attrs="{'readonly':[('sheet_use_default','=',True)]}"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//page[@name='report']//group[@name='report_joined_documents_fields']" position="after">
                <group col="4">
                    <h5 colspan="8">Appendices <i>(Mail templates)</i></h5>
                    <group colspan="4">
                        <field name="report_custom_document_ids" string="Joined documents" widget="many2many_tags" attrs="{'readonly':[('report_use_default','=',True)]}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
