            <menuitem id="menu_openfire_interventions_equipment" name="Equipments" action="of_equipment.action_view_of_equipment" sequence="3"/>
            <menuitem id="menu_openfire_interventions_tour_create" name="Tour optimization" action="of_planning_tour.action_of_planning_tour_manual_create" groups="of_planning_tour.group_of_planning_tour_manual_creation" sequence="4"/>
            <menuitem id="menu_openfire_interventions_print_wizard" name="Tour Printing" action="of_planning.action_of_planning_print_wizard" sequence="5"/>
        </menuitem>

        <menuitem id="menu_openfire_config" name="Configuration" sequence="100">

            <menuitem id="menu_openfire_config_general_settings" name="General Settings" action="account.action_open_settings" sequence='1'/>

            <menuitem id="menu_openfire_config_contact" name="Contact" sequence="2">
                <menuitem id="menu_openfire_config_contact_tags" name="Contact Tags" action="base.action_partner_category_form" sequence="1"/>
            </menuitem>

            <menuitem id="menu_openfire_config_sale" name="Sale" sequence="3">
                <menuitem id="menu_openfire_config_sale_brand" name="Brands" action="of_product_brand.of_product_brand_action" sequence="1"/>
                <menuitem id="menu_openfire_config_sale_product_category" name="Product Categories" action="product.product_category_action_form" sequence="2" />
                <menuitem id="menu_openfire_config_sale_template" name="Quotation Templates" action="sale_management.sale_order_template_action" groups="sale_management.group_sale_order_template" sequence="3"/>
            </menuitem>

            <menuitem id="menu_openfire_config_intervention" name="Intervention" sequence="4">
                <menuitem id="menu_openfire_config_intervention_template" name="Intervention template" action="of_planning.action_of_planning_intervention_template" sequence="1"/>
                <menuitem id="menu_openfire_config_intervention_survey" name="Surveys" action="of_survey.of_action_survey_form" sequence="2"/>
                <menuitem id="menu_openfire_config_intervention_task" name="Tasks" action="of_planning.action_of_planning_task" sequence="3"/>
                <menuitem id="menu_openfire_config_intervention_employee" name="Employees" action="hr.hr_employee_public_action" sequence="4"/>
            </menuitem>

            <menuitem id="menu_openfire_config_communication" name="Communication" sequence="5">
                <menuitem id="menu_openfire_config_communication_email_templates" name="Email Templates" action="mail.action_email_template_tree_all" sequence="1"/>
                <menuitem id="menu_openfire_config_communication_mail_mail" name="Email Sent" action="mail.action_view_mail_mail" sequence="2"/>
            </menuitem>
        </menuitem>
    </menuitem>

