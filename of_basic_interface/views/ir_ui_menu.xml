            <menuitem id="menu_openfire_sales_move_out_invoice_type" name="Invoices" action="account.action_move_out_invoice_type" sequence="4"/>
            <menuitem id="menu_openfire_sales_account_payments_receivable" name="Payments" action="account.action_account_payments" sequence="5"/>
            <menuitem id="menu_openfire_sales_move_out_refund_type" name="Refunds" action="account.action_move_out_refund_type" sequence="6"/>
        </menuitem>

        <menuitem id="menu_openfire_interventions" name="Interventions" sequence="20">
            <menuitem id="menu_openfire_interventions_planning" name="Planning" action="of_planning_view.action_calendar_event_planning" sequence="1"/>
