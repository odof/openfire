<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_incoterm_id']" position="attributes">
                <attribute name="groups">!of_basic_interface.of_group_basic_interface</attribute>
            </xpath>
            <xpath expr="//group[@name='accounting_info_group']/field[@name='auto_post']" position="attributes">
                <attribute name="groups">!of_basic_interface.of_group_basic_interface</attribute>
            </xpath>
        </field>
    </record>

</odoo>
