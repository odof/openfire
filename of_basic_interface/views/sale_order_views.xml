<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="attributes">
                <attribute name="groups">!of_basic_interface.of_group_basic_interface</attribute>
            </xpath>
            <xpath expr="//group[@name='sale_shipping']" position="after">
                <field name="effective_date" groups="of_basic_interface.of_group_basic_interface" invisible="1"/>
                <field name="commitment_date" groups="of_basic_interface.of_group_basic_interface" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
