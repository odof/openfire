<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_outlay_analysis_line_tree" model="ir.ui.view">
        <field name="name">of.outlay.analysis.line.tree</field>
        <field name="model">of.outlay.analysis.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" class="of_outlay_analysis_line" create="false" delete="false" decoration-success="type in ('income_expected', 'to_invoice', 'expense_remaining')">
                <field name="currency_id" invisible="1"/>
                <field name="analytic_section_id" readonly="1"/>
                <field name="type" readonly="1"/>
                <field name="amount_init" string="Initial" readonly="1"/>
                <field name="amount_init_pct" string="(%)"
                       attrs="{'readonly': [('type', '!=', 'margin_objective')]}"/>
                <field name="amount_compl" string="Complémentaire" readonly="1"/>
                <field name="amount_compl_pct" string="(%)"
                       attrs="{'readonly': [('type', '!=', 'margin_objective')]}"/>
                <field name="amount_studies" string="Études"
                       attrs="{'readonly': [('type', 'in', ('margin_theoretical', 'margin_objective', 'margin_real', 'income_expected', 'to_invoice', 'expense_remaining'))]}"/>
                <field name="amount_studies_pct" string="(%)"
                       attrs="{'readonly': [('type', '!=', 'margin_objective')]}"/>
                <field name="amount_engaged" string="Engagé" readonly="1"/>
                <field name="amount_engaged_pct" string="(%)"
                       attrs="{'readonly': [('type', '!=', 'margin_objective')]}"/>
                <field name="amount_current" string="Situation en cours"
                       attrs="{'readonly': [('type', 'in', ('margin_theoretical', 'margin_objective', 'margin_real', 'income_expected', 'to_invoice', 'expense_remaining'))]}"/>
                <field name="amount_current_pct" string="(%)"
                       attrs="{'readonly': [('type', '!=', 'margin_objective')]}"/>
                <field name="amount_invoiced" string="Facturé" readonly="1"/>
                <field name="amount_invoiced_pct" string="(%)"
                       attrs="{'readonly': [('type', '!=', 'margin_objective')]}"/>
                <field name="amount_final" string="Situation finale" readonly="1"/>
                <field name="amount_final_pct" string="(%)"
                       attrs="{'readonly': [('type', '!=', 'margin_objective')]}"/>
            </tree>
        </field>
    </record>

</odoo>
