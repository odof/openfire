<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_order_kanban_stage_view_form" model="ir.ui.view">
        <field name="name">of.sale.order.kanban.stage.view.form</field>
        <field name="model">of.sale.order.kanban.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_sale_order_kanban_stage_view_tree" model="ir.ui.view">
        <field name="name">of.sale.order.kanban.stage.view.tree</field>
        <field name="model">of.sale.order.kanban.stage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="of_sale_order_kanban_stage_action" model="ir.actions.act_window">
        <field name="name">Order tracking stages</field>
        <field name="res_model">of.sale.order.kanban.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="of_sale_order_kanban_stage_menu" name="Order tracking stages" parent="sale.menu_sales_config" sequence="5" action="of_sale_order_kanban_stage_action"/>

</odoo>
