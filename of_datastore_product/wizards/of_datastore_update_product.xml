<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_of_datastore_update_product_form" model="ir.ui.view">
        <field name="name">of.datastore.update.product.form</field>
        <field name="model">of.datastore.update.product</field>
        <field name="arch" type="xml">
            <form string="Products import/update">
                <field name="nb_local_products" invisible="1" />
                <field name="is_update" invisible="1" />
                <field name="type" invisible="1" />
                <p attrs="{'invisible': [('nb_local_products', '&lt;=', 1500)]}">
                    You try to update a price having more than 1500 references present locally in your database.<br />
In order to improve the quality and speed of this update, please first remove unused references.<br />
To make this, from the mark: Action &gt; Remove unused items.<br />
These references will always be accessible via the product datastore.<br /></p>
                <div attrs="{'invisible': [('nb_local_products', '&gt;', 1500)]}">
                    <p class="text-warning">If you continue, the selected products will be imported/updated.</p>
                    <h3>Options :</h3>
                    <div>
                        <label for="noup_name" />
                        <field name="noup_name" />
                    </div>
                </div>
                <footer>
                    <button name="action_button_update_products" type="object" string="Update" class="btn-primary" attrs="{'invisible': ['|',('nb_local_products', '&gt;', 1500),('is_update','=',False)]}" context="{'of_skip_default_code_lock': True}" />
                    <button name="action_button_update_products" type="object" string="Import" class="btn-primary" attrs="{'invisible': ['|',('nb_local_products', '&gt;', 1500),('is_update','=',True)]}" context="{'of_skip_default_code_lock': True}" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_of_datastore_update_product_template" model="ir.actions.act_window">
        <field name="name">Products import/update</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">of.datastore.update.product</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_of_datastore_update_product_product" model="ir.actions.act_window">
        <field name="name">Products import/update</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">of.datastore.update.product</field>
        <field name="binding_model_id" ref="product.model_product_product" />
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_of_datastore_update_product_brand" model="ir.actions.act_window">
        <field name="name">Update products</field>
        <field name="res_model">of.datastore.update.product</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Ajout de l'action d'import de tout les articles de la marque -->
    <record id="action_of_datastore_import_product_brand" model="ir.actions.act_window">
        <field name="name">Import all products</field>
        <field name="res_model">of.datastore.update.product</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_type': 'import'}</field>
        <field name="target">new</field>
    </record>

</odoo>
