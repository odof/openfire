<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_of_remove_unused_products_form" model="ir.ui.view">
        <field name="name">of.remove.unused.products.form</field>
        <field name="model">of.remove.unused.products</field>
        <field name="arch" type="xml">
            <form string="Products removal">
                <span>If you continue, all unused products from this brand will be removed.</span>
                <footer>
                    <button name="action_button_remove_unused_products" type="object" string="Remove"
                        class="btn-primary" />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_of_remove_unused_products" model="ir.actions.act_window">
        <field name="name">Remove unused products</field>
        <field name="res_model">of.remove.unused.products</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
