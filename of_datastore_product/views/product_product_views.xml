<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_of_datastore_product_tree" model="ir.ui.view">
        <field name="name">product.datastore.tree.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="stock.view_stock_product_tree" />
        <field name="arch" type="xml">
            <xpath  expr="//field[@name='virtual_available']" position="replace">
                <field name="virtual_available"
                        attrs="{'invisible':[('type', '!=', 'product')]}" string="Forecasted Quantity" optional="show"
                        decoration-danger="virtual_available &lt; 0 and not of_datastore_has_link" decoration-warning="virtual_available == 0"
                        groups="stock.group_stock_user"/>
            </xpath>
            <xpath expr="//tree" position="inside">
                <field name="of_datastore_has_link" invisible="1" />
            </xpath>
        </field>
    </record>

</odoo>
