#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid ""
"<b>(ppht + 20) * 1.15</b>: Sale of the item at the list price + 20€ of "
"additional costs, all increased by 15%."
msgstr ""
"<b>(ppht + 20) * 1.15</b>: Vente de l’article au prix de liste + 20€ de "
"coûts supplémentaires, le tout augmenté de 15%."

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid "<b>40.5</b>: Use a discount of 40.5%."
msgstr "<b>40.5</b>: Utiliser une remise de 40,5%."

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid ""
"<b>coef</b>: \"Selling coefficient\" specified in the item's price structure"
msgstr ""
"<b>coef</b>: \"Coefficient de vente\" renseigné dans la structure de prix de"
" l’article"

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid ""
"<b>cumul()</b> is a function used to accumulate multiple discounts. "
"cumul(40.5,5) accumulates a discount of 40.5% and a discount of 5% for a "
"total of 43.475% (Pay attention to the distinction between dot and comma)"
msgstr ""
"<b>cumul()</b> est une fonction utilisée pour accumuler plusieurs remises. "
"cumul(40.5,5) accumule une remise de 40,5 % et une remise de 5 % pour un "
"total de 43,475 % (Attention à la distinction entre point et virgule)"

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid "<b>cumul(40.5,5)</b>: Use two discounts, one of 40.5% plus one of 5%."
msgstr ""
"<b>cumul(40.5,5)</b>: Utiliser deux remises, une de 40,5 % plus une de 5 %."

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid "<b>fr_d</b>: \"Various fees\" specified in the item's price structure"
msgstr ""
"<b>fr_d</b>: \"Frais divers\" renseigné dans la structure de prix de "
"l’article"

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid ""
"<b>fr_l</b>: \"Other logistics fees\" specified in the item's price "
"structure"
msgstr ""
"<b>fr_l</b>: \"Autres frais logistiques\" spécifiés dans la structure de "
"prix de l’article"

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid ""
"<b>pa + 20</b>: Add 20€ of additional costs to the cost price of the item."
msgstr ""
"<b>pa + 20</b>: Ajoute 20€ de coûts supplémentaires au prix de revient de "
"l’article."

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid "<b>pa</b>: The purchase price"
msgstr ""

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid ""
"<b>ppht if ppht &lt; 1000 else round(ppht * 1.2)</b>: Sale of the item at "
"the list price if less than 1000€, otherwise at the list price increased by "
"20% and rounded to the nearest euro."
msgstr ""
"<b>ppht if ppht &lt; 1000 else round(ppht * 1.2)</b>: Vente de l’article au "
"prix public s’il est inférieur à 1000€, sinon au prix public rehaussé de 20%"
" et arrondi à l'euro plein."

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid "<b>ppht</b>: The list price excluding taxes provided by the supplier."
msgstr "<b>ppht</b>: Le prix public hors taxes fourni par le fournisseur."

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid "<b>taxe</b>: \"Various taxes\" specified in the item's price structure"
msgstr ""
"<b>taxe</b>: \"Taxes diverses\" renseigné dans la structure de prix de "
"l’article"

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid ""
"<b>tr_a</b>: \"Purchase transport\" specified in the item's price structure"
msgstr ""
"<b>tr_a</b>: \"Transport d’achat\" renseigné dans la structure de prix de "
"l’article"

#. module: of_import
#: model_terms:ir.ui.view,arch_db:of_import.of_product_brand_view_config_form
msgid "<b>tr_v</b>: \"Sales transport\" specified in the item's price structure"
msgstr ""
"<b>tr_v</b>: \"Transport de vente\" renseigné dans la structure de prix de "
"l’article"

