#. module: of_import
#: model:ir.model.fields,help:of_import.field_of_import_product_categ_config__of_import_cost_price
#: model:ir.model.fields,help:of_import.field_of_import_product_config_template__of_import_cost_price
#: model:ir.model.fields,help:of_import.field_of_product_brand__of_import_cost_price
#: model:ir.model.fields,help:of_import.field_product_product__of_import_cost_price
#: model:ir.model.fields,help:of_import.field_product_template__of_import_cost_price
msgid ""
"Allows the calculation of the cost price based on the purchase price.\n"
"\n"
"Examples :\n"
"    - pa : Retains the purchase price calculated from the formulas of the selling price and the discount.\n"
"    - pa * 1.05 + 20 : Purchase price increased by 5%, then increased by 20€.\n"
msgstr ""
"Permet le calcul du prix de revient en fonction du prix d’achat.\n"
"\n"
"Exemples :\n"
" pa : Retient le prix d’achat calculé à partir des formules du prix de vente et de la remise.\n"
" pa * 1.05 + 20 : Prix d’achat augmenté de 5 %, puis augmenté de 20€.\n"

