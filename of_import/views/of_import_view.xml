<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- Vue tree -->
        <record id="of_import_tree_view" model="ir.ui.view">
            <field name="name">of.import.tree</field>
            <field name="model">of.import</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="type_import"/>
                    <field name="name"/>
                    <field name="date"/>
                    <field name="file_name"/>
                    <field name="state"/>
                    <field name="total_count"/>
                    <field name="added_count"/>
                    <field name="updated_count"/>
                    <field name="failed_count"/>
                    <field name="user_id"/>
                </tree>
            </field>
        </record>

        <!-- Vue form -->
        <record id="of_import_form_view" model="ir.ui.view">
            <field name="name">of.import.form</field>
            <field name="model">of.import</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_button_simulate" string="Simulate import" type="object" class="btn btn-secondary" attrs="{'invisible': [('state','!=','draft')]}"/>
                        <button name="action_button_import" string="Import" type="object" class="btn btn-primary" attrs="{'invisible': [('state','!=','draft')]}" confirm="Do you confirm import (not cancellable) ?"/>
                        <button name="action_button_set_draft" string="Set Draft" type="object" class="btn btn-warning" attrs="{'invisible': [('state','=','draft')]}" confirm="Set to draft ?"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <group string="Configuration">
                        <group>
                            <field name="type_import"/>
                            <field name="date" widget="date"/>
                            <field name="file" filename="file_name"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="prefix"/>
                            <field name="show_lang" invisible="1"/>
                            <field name="lang_id" widget="selection" attrs="{'invisible': [('show_lang', '=', False)]}"/>
                            <field name="separator"/>
                        </group>
                    </group>
                    <group string="Informations">
                        <group>
                            <field name="file_name"/>
                            <field name="file_type"/>
                            <field name="file_size"/>
                        </group>
                        <group>
                            <field name="total_count"/>
                            <field name="added_count"/>
                            <field name="updated_count"/>
                            <field name="failed_count"/>
                            <field name="ignored_count"/>
                        </group>
                        <group>
                            <field name="date_start_import"/>
                            <field name="date_end_import"/>
                            <field name="time_lapse"/>
                        </group>
                    </group>
                    <group string="Journal">
                        <field name="import_error_ids"/>
                        <field name="import_warning_ids"/>
                        <field name="import_success_ids"/>
                    </group>
                    <separator string="Available fields"/>
                    <field name="output_note" style="max-height: 500px; overflow: auto;"/>
                </form>
            </field>
        </record>

        <!-- Menus -->

        <!-- Action vue import -->
        <record id="action_of_import" model="ir.actions.act_window">
            <field name="name">OpenImport</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">of.import</field>
            <field name="view_mode">tree,form</field>
            <field name="help">Import OpenFire</field>
        </record>

        <!-- Menu import (Configuration/OpenImport) -->
        <menuitem id="menu_of_import" action="action_of_import" name="OpenImport"
            parent="base.menu_administration" sequence="1"/>

</odoo>
