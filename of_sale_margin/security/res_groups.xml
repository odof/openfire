<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record model="ir.module.category" id="of_sale_margin">
        <field name="name">OF Margin</field>
        <field name="description">Defines access rights to margins.</field>
        <field name="sequence">92</field>
    </record>

    <record id="of_group_sale_margin_manager" model="res.groups">
        <field name="name">Responsible</field>
        <field name="category_id" ref="of_sale_margin" />
    </record>

    <record id="group_of_can_modify_sale_purchase_price" model="res.groups">
        <field name="name">(OF) Change the cost in the order lines</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>

    <record id="of_sale.of_group_sale_responsible" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('of_sale_margin.group_of_can_modify_sale_purchase_price'))]"/>
    </record>

    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('of_sale_margin.group_of_can_modify_sale_purchase_price'))]"/>
    </record>

</odoo>
