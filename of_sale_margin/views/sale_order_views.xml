<?xml version='1.0' encoding='utf-8'?>
<odoo>

        <record id="view_order_form" model="ir.ui.view">
            <field name="name">of.sale.margin.view.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree//field[@name='price_subtotal']" position="after">
                    <field name="of_amount_to_invoice" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="of_sale_view_order_margin_manager" model="ir.ui.view">
            <field name="name">of.sale.view.order.form.margin.manager</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="of_sale.of_sale_view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']//button[@name='action_button_toggle_view_mode']" position="attributes">
                    <attribute name="groups">of_account.of_group_sale_margin_manager</attribute>
                </xpath>

                <!-- Margin and margin percent -->
                <xpath expr="//group[@name='sale_total']//label[@for='margin']" position="attributes">
                    <attribute name="groups">of_account.of_group_sale_margin_manager</attribute>
                    <attribute name="attrs">{'invisible': [('of_customer_view', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@name='sale_total']//field[@name='margin']" position="attributes">
                    <attribute name="groups">of_account.of_group_sale_margin_manager</attribute>
                    <attribute name="attrs">{'invisible': [('of_customer_view', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//group[@name='sale_total']//field[@name='margin_percent']/.." position="attributes">
                    <attribute name="groups">of_account.of_group_sale_margin_manager</attribute>
                    <attribute name="attrs">{'invisible': [('of_customer_view', '=', True)]}</attribute>
                </xpath>
                <!-- /Margin and margin percent -->
            </field>
        </record>

        <record id="sale_margin_sale_order" model="ir.ui.view">
            <field name="name">sale.order.margin.view.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_margin.sale_margin_sale_order"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='margin']/.." position="after">
                    <div class="clearfix"/>
                    <label for="of_amount_to_invoice" groups="base.group_user"/>
                    <div>
                        <field name="of_amount_to_invoice"/>
                    </div>
                    <label for="of_amount_to_invoice_no_deposit" groups="base.group_user"/>
                    <div>
                        <field name="of_amount_to_invoice_no_deposit"/>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="of_crm_of_sale_order_line_tree" model="ir.ui.view">
            <field name="name">of.crm.of.sale.order.line.tree</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="of_sale.of_sale_order_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price_subtotal']" position="after">
                    <field name="of_amount_to_invoice" optional="hide"/>
                </xpath>
            </field>
        </record>

        <record id="view_order_line_tree" model="ir.ui.view">
            <field name="name">of.sale.margin.sale.order.line.tree.view</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_order_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='price_subtotal']" position="after">
                    <field name="of_amount_to_invoice" optional="hide"/>
                </xpath>
            </field>
        </record>

    <record id="sale_order_view_tree_quotation" model="ir.ui.view">
        <field name="name">sale.order.view.tree.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="margin" optional="hide"/>
                <field name="margin_percent" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="of_amount_to_invoice" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="of_amount_to_invoice_no_deposit" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_tree_order" model="ir.ui.view">
        <field name="name">sale.order.view.tree.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="margin" optional="hide"/>
                <field name="margin_percent" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='invoice_status']" position="before">
                <field name="of_amount_to_invoice" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="of_amount_to_invoice_no_deposit" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
