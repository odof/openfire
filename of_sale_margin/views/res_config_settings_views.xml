<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_sale_margin_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">of.sale.margin.res.config.settings.view.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="of_sale.of_sale_res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='order_line_configuration']" position="after">
                <div class="col-24 col-lg-6 o_setting_box" id="of_sale_order_margin_control">
                    <div class="o_setting_left_pane">
                        <field name="of_sale_order_margin_control"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="of_sale_order_margin_control"/>
                        <div class="text-muted">
                            Enable margin control on sale order validation
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
