        <record id="of_contract_custom_kanban_new" model="of.service.kanban">
            <field name="name">Nouveau</field>
            <field name="sequence">10</field>
            <field name="type_ids">[(4, ref(of_contract_custom.of_contract_custom_type_sav)),
                                    (4, ref(of_contract_custom.of_contract_custom_type_installation))]</field>
        </record>

        <record id="of_contract_custom_kanban_quote" model="of.service.kanban">
