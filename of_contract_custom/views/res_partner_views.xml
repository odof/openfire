<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ******************************************************************************************* -->
<!-- **************************************** PARTENAIRE *************************************** -->
<!-- ******************************************************************************************* -->

    <record id="of_contract_view_res_partner" model="ir.ui.view">
        <field name="name">of_contract_view_res_partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_contrat" icon="fa-book">
                    <field name="of_contrat_count" widget="statinfo" string="Contrats"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
