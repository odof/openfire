<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="of_map_view.PopupMap" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@id='popup-content']" position="inside">
            <t t-if="model == 'of.equipment'">
                <t t-if="props.record.site_address_id">
                    <i class="fa fa-user pe-1"/><strong t-esc="props.record.site_address_id[1]"/><br/>
                </t>
                <t t-if="props.record.site_phones">
                    <i class="fa fa-phone pe-1"/><span t-esc="props.record.site_phones"/><br/>
                </t>
                <t t-if="props.record.customer_mobile">
                    <i class="fa fa-phone pe-1"/><span t-esc="props.record.customer_mobile"/><br/>
                </t>
                <t t-if="props.record.site_zip or props.record.site_city">
                    <i class="fa fa-map-marker pe-1"/><span t-if="props.record.site_zip" t-esc="props.record.site_zip"/> <span t-if="props.record.site_city" t-esc="props.record.site_city"/><br/>
                </t>
                <t t-if="props.record.name">
                    <span t-esc="props.record.name"/><br/>
                </t>
                <t t-if="props.record.service_date">
                    Sale: <span t-esc="props.record.service_date"/><br/>
                </t>
                <t t-if="props.record.installation_date">
                    Install: <span t-esc="props.record.installation_date"/><br/>
                </t>
                <t t-if="props.record.end_warranty_date">
                    Warranty: <span t-esc="props.record.end_warranty_date"/><br/>
                </t>
            </t>
        </xpath>
    </t>

</templates>
