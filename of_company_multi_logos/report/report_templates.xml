                        </t>
                    </div>
                    <t t-foreach="company._get_footer_logos()" t-as="footer_logo">
                        <img t-att-src="image_data_uri(footer_logo.logo)" style="margin-left: auto; margin-right: auto; display: inline-block; max-height: 50px;"/>
