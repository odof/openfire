<?xml version="1.0"?>
<odoo>

    <record id="of_multi_logos_view_form" model="ir.ui.view">
        <field name="name">of.company.multi.logos.form.view</field>
        <field name="model">of.company.multi.logos</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label class="oe_edit_only" for="name"/>
                        <h1><field name="name" placeholder="Logo name"/></h1>
                        <div name="options" groups="base.group_user">
                            <div>
                                <field name="is_displayed_in_docs"/>
                                <label for="is_displayed_in_docs"/>
                            </div>
                        </div>
                    </div>
                    <group col="4">
                        <label for="company_ids"/>
                        <field name="company_ids" widget="many2many_tags" colspan="3" nolabel="1"/>
                        <label for="description"/>
                        <field name="description" colspan="3" nolabel="1"/>
                        <field name="logo_position"/>
                    </group>
                    <group name="logo">
                        <field name="logo" widget="image" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_multi_logos_view_kanban" model="ir.ui.view">
        <field name="name">of.company.multi.logos.kanban.view</field>
        <field name="model">of.company.multi.logos</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="logo"/>
                <field name="logo_position"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image me-1">
                                <img t-att-src="kanban_image('of.company.multi.logos', 'logo', record.id.raw_value)" alt="Logo" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong><field name="name"/></strong><br/>
                                <small>Position : <field name="logo_position"/></small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="of_multi_logos_view_tree" model="ir.ui.view">
        <field name="name">of.company.multi.logos.tree.view</field>
        <field name="model">of.company.multi.logos</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="description"/>
                <field name="is_displayed_in_docs"/>
                <field name="company_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="of_multi_logos_view_search" model="ir.ui.view">
        <field name="name">of.company.multi.logos.search.view</field>
        <field name="model">of.company.multi.logos</field>
        <field name="arch" type="xml">
            <search string="Logos">
                <field name="name"/>
                <separator/>
                <filter string="Displayed" name="displayed" domain="[('is_displayed_in_docs','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="of_multi_logos_action" model="ir.actions.act_window">
        <field name="name">Logos</field>
        <field name="res_model">of.company.multi.logos</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_displayed':1}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to add a logo.
            </p>
        </field>
    </record>
    <record id="of_multi_logos_action_view_tree" model="ir.actions.act_window.view">
        <field eval="0" name="sequence"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="of_multi_logos_view_kanban"/>
        <field name="act_window_id" ref="of_multi_logos_action"/>
    </record>
    <record id="of_multi_logos_action_view_kanban" model="ir.actions.act_window.view">
        <field eval="1" name="sequence"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="of_multi_logos_view_tree"/>
        <field name="act_window_id" ref="of_multi_logos_action"/>
    </record>
    <record id="of_multi_logos_action_view_form" model="ir.actions.act_window.view">
        <field eval="2" name="sequence"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="of_multi_logos_view_form"/>
        <field name="act_window_id" ref="of_multi_logos_action"/>
    </record>

</odoo>
