<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="of_map_view.ListPopupMap" owl="1">
        <div class="map--list-popup" t-attf-style="width: {{state.width}};">
            <t t-foreach="props.map.records" t-as="record" t-key="record.id">
                <PopupMap t-props="rendererProps" record="record"/>
            </t>
        </div>
    </t>

    <t t-name="of_map_view.PopupMap" owl="1">
        <t t-if="state.show">
            <div class="map-popup m-2 position-relative" t-on-mouseenter="onMouseOver" t-on-mouseleave="onMouseOut" t-attf-style="background-color: {{state.color}}; width: {{state.width}};">
                <div class="map-popup--header position-absolute pe-1" t-on-click="onClose" >
                    <i class="fa fa-close"/>
                </div>
                <div id="popup-content" class="map-popup--content m-2 me-3" t-on-click.stop.prevent="onClick" />
            </div>
        </t>
    </t>

</templates>
