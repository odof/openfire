<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="of_map_view.MapRenderer" owl="1">
        <div class="map-renderer row g-0">
            <div class="col-md-12 col-lg-10 map-renderer--container" t-ref="mapContainer"/>
            <ListPopupMap map="this"/>

        </div>
    </t>

    <t t-name="of_map_view.tooltipRenderer" owl="1">
        <div>
            <p><t t-esc="partner.name"/></p>
            <p><t t-esc="partner.of_precision"/></p>
        </div>
    </t>



</templates>
