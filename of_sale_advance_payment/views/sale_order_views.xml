<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">of.sale.advance.payment.sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_advance_payment.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='advance_payment_status']" position="replace"/>
        </field>
    </record>

    <record id="sale_order_view_form_advance_payment" model="ir.ui.view">
        <field name="name">of.sale.advance.payment.sale.order.view.form.advance.payment</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="of_sale.of_sale_view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info']" position="inside">
                <field name="advance_payment_status"/>
            </xpath>
        </field>
    </record>

</odoo>
