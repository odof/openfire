<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_view_sector_form" model="ir.ui.view">
        <field name="name">of.sector.form</field>
        <field name="model">of.sector</field>
        <field name="arch" type="xml">
            <form string="Sector">
                <header>
                    <button string="Update" type="object" name="action_button_update" class="oe_highlight"
                            confirm="This action will update all partners without sectors that match the zip codes, are you sure you want to continue ?"/>
                    <button string="Update and Delete" type="object" name="action_button_update_delete" class="oe_highlight"
                            confirm="This action will update all partners without sectors that match the zip codes and exclude those that do not, are you sure you want to continue ?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_button_toggle_active" class="oe_stat_button" type="object" icon="fa-archive">
                            <div class="o_stat_info o_field_widget" attrs="{'invisible': [('active', '=', True)]}">
                                <span class="text-danger">Unarchive</span>
                            </div>
                            <div class="o_stat_info o_field_widget" attrs="{'invisible': [('active', '=', False)]}">
                                <span class="text-success">Archive</span>
                            </div>
                        </button>
                        <button name="action_button_view_partner" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo" string="Partner(s)"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <separator string="Sector zip codes" colspan="2"/>
                            <field name="zip_range_ids" nolabel="1" colspan="2">
                                <tree editable="top">
                                    <field name="zip_code_min"/>
                                    <field name="zip_code_max"/>
                                </tree>
                            </field>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_view_sector_kanban" model="ir.ui.view">
        <field name="name">of.sector.kanban</field>
        <field name="model">of.sector</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="zip_range_ids"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                       <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong>
                                    <span>
                                         <t t-esc="record.name.value"/>
                                    </span>
                                </strong>
                                <field name="code"/>
                                <field name="type"/>
                                <field name="zip_range_ids" widget="many2many_tags"/>
                                <field name="active" invisible="1"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="of_view_sector_tree" model="ir.ui.view">
        <field name="name">of.sector.tree</field>
        <field name="model">of.sector</field>
        <field name="arch" type="xml">
            <tree string="Sectors" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="zip_range_ids"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="of_view_sector_search" model="ir.ui.view">
        <field name="name">of.sector.filter</field>
        <field name="model">of.sector</field>
        <field name="arch" type="xml">
            <search string="Sectors">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Commercial" name="commercial" domain="[('type', 'in', ('commercial', 'technical_commercial'))]"/>
                <filter string="Technical" name="technical" domain="[('type', 'in', ('technical', 'technical_commercial'))]"/>
                <separator/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_of_sector_act_widow" model="ir.actions.act_window">
        <field name="name">Sectors</field>
        <field name="res_model">of.sector</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="of_view_sector_tree"/>
        <field name="search_view_id" ref="of_view_sector_search"/>
    </record>

    <menuitem id="of_sector_menu" name="Sectors" parent="contacts.menu_localisation" action="action_of_sector_act_widow" sequence="20" />

</odoo>
