<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="of_account_move_template_tree" model="ir.ui.view">
        <field name="name">of.account.move.template.tree</field>
        <field name="model">account.move.template</field>
        <field name="inherit_id"  ref="account_move_template.account_move_template_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="of_moves_last_date"/>
            </xpath>
        </field>
    </record>

    <record id="of_account_move_template_form" model="ir.ui.view">
        <field name="name">of.account.move.template.form</field>
        <field name="model">account.move.template</field>
        <field name="inherit_id"  ref="account_move_template.account_move_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" name="of_action_view_moves" type="object" icon="fa-bars">
                        <field string="Vouchers" name="of_moves_count" widget="statinfo"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="of_recurring"/>
            </xpath>
            <xpath expr="//group[@name='lines']" position="before">
                <group name="recurring" attrs="{'invisible':[('of_recurring','!=',True)]}">
                    <group name="main">
                        <label for="of_rec_interval" string="Repeat every"/>
                        <div>
                            <field name="of_rec_interval" class="oe_inline" style="width: 50px !important; margin-right: 10px;"/>
                            <field name="of_rec_interval_type" class="oe_inline"/>
                        </div>
                        <field name="of_rec_number"/>
                        <field name="of_prorata" attrs="{'invisible':[('of_rec_interval_type','!=','months')]}"/>
                    </group>
                    <group name="main2">
                        <field name="of_reversal"/>
                        <field name="of_reversal_date" attrs="{'invisible':[('of_reversal', '!=', 'custom')]}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
