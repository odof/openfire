<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document" inherit_id="of_sale_report_setting.report_saleorder_document">
        <xpath expr="//t[@t-set='pdf_signature_text_label']" position="after">
            <t t-set="pdf_payment_schedule" t-value="doc.pdf_payment_schedule()"/>
        </xpath>
        <xpath expr="//div[@name='so_total_summary']" position="after">
            <div t-if="pdf_payment_schedule" class="mt-4 mb-4" name="payment_schedule">
                <div class="col-6" style="page-break-inside:avoid;">
                    <t t-set="show_payment_schedule_date" t-value="bool(doc.of_payment_schedule_ids.filtered('date'))"/>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th class="text-start">Payment Schedule</th>
                                <th class="text-start" t-if="show_payment_schedule_date">Date</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.of_payment_schedule_ids" t-as="p">
                                <td><span t-field="p.name"/></td>
                                <td t-if="show_payment_schedule_date"><span t-field="p.date"/></td>
                                <td class="text-end">
                                    <span t-field="p.amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
