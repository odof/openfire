<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_sale_report_setting_sale_document_layout" model="ir.ui.view">
        <field name="name">of.sale.payment.schedule.sale.document.layout</field>
        <field name="model">of.sale.document.layout</field>
        <field name="inherit_id" ref="of_sale_report_setting.of_sale_report_setting_sale_document_layout"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pdf_signatures_insert']/../.." position="before">
                <div class="mt32">
                    <div class="o_setting_left_pane">
                        <field name="pdf_payment_schedule"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pdf_payment_schedule" class="of-printing-parameter-title"/>
                        <div class="text-muted">
                            Displays the Payment schedule in the report
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
