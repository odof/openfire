<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_sale_printing_params_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.sale.printing.params.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="of_sale_report_setting.res_config_settings_sale_printing_params_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pdf_price_taxinc']/../.." position="after">
                <div class="mt32">
                    <div class="o_setting_left_pane">
                        <field name="pdf_payment_schedule"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="pdf_payment_schedule" class="of-printing-parameter-title"/>
                        <div class="text-muted">
                            Displays the Payment schedule in the report
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
