<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_utm_source_view_form" model="ir.ui.view">
        <field name="name">of.utm.source.view.form</field>
        <field name="model">utm.source</field>
        <field name="inherit_id" ref="utm.utm_source_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/sheet/group" position="before">
                <field name="active" invisible="1"/>
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="sequence"/>
                <field name="medium_id"/>
            </xpath>
        </field>
    </record>

    <record id="of_utm_source_view_tree" model="ir.ui.view">
        <field name="name">of.utm.source.view.tree</field>
        <field name="model">utm.source</field>
        <field name="inherit_id" ref="utm.utm_source_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-muted">(not active)</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="active" invisible="1"/>
                <field name="medium_id"/>
            </xpath>
        </field>
    </record>


    <record id="of_utm_source_view_search" model="ir.ui.view">
        <field name="name">utm.source.view.search</field>
        <field name="model">utm.source</field>
        <field name="arch" type="xml">
            <search string="Search UTM Source">
                <field name="name"/>
                <field name="medium_id"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Medium" name="group_by_medium" context="{'group_by': 'medium_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
