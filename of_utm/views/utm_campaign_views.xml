<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_utm_campaign_view_form" model="ir.ui.view">
        <field name="name">of.utm.campaign.view.form</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.utm_campaign_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='top-group']" position="before">
                <field name="active" invisible="1"/>
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
            </xpath>
        </field>
    </record>

    <record id="of_utm_campaign_view_tree" model="ir.ui.view">
        <field name="name">of.utm.campaign.view.tree</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.utm_campaign_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-muted">(not active)</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="before">
                <field name="active" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="of_view_utm_campaign_view_search" model="ir.ui.view">
        <field name="name">of.utm.campaign.view.search</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.view_utm_campaign_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_auto_campaign']" position="after">
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </xpath>
        </field>
    </record>

</odoo>
