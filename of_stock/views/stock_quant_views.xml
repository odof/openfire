<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_quant_view_form" model="ir.ui.view">
        <field name="name">stock.quant.view.form</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reservation_id']" position="after">
                <field name="of_contremarque_id" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="of_internal_serial_number" attrs="{'invisible': [('of_internal_serial_number', '=', False)]}"/>
            </xpath>
        </field>
    </record>

    <record id="of_action_quant_reconcile_negative" model="ir.actions.server">
        <field name="name">Fusionner avec quants négatifs</field>
        <field name="model_id" ref="of_stock.model_stock_quant"/>
        <field name="state">code</field>
        <field name="code">action = records.of_quant_reconcile_negative()</field>
    </record>

    <record id="of_value_action_quant_reconcile_negative" model="ir.values">
        <field name="name">Fusionner avec quants négatifs</field>
        <field name="key2">client_action_multi</field>
        <field name="model">stock.quant</field>
        <field name="value" eval="'ir.actions.server,%d'%of_action_quant_reconcile_negative"/>
    </record>

</odoo>
