<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template id="report_saleorder_document" inherit_id="of_sale_report_setting.report_saleorder_document">
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t t-set="pdf_requested_week" t-value="doc.pdf_requested_week()"/>
        </xpath>
        <xpath expr="//div[@name='technical_visit_information']" position="before">
            <div t-if="pdf_requested_week and doc.of_requested_week" name="requested_week"
                 style="float: left; padding-right: 10px;">
                <strong>Requested week:</strong>
                <p class="m-0" t-field="doc.of_requested_week"/>
            </div>
            <div t-if="pdf_requested_week and doc.of_requested_week" style="display: table-cell; width: 4px;"/>
        </xpath>
    </template>

</odoo>
