<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sale Order Form View -->
    <record id="of_sale_order_dates_form_view" model="ir.ui.view">
        <field name="name">of.sale.order.dates.sale.order.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='validity_date']" position="after">
                <field name="of_requested_week"/>
                <field name="of_technical_visit_date" string="Technical Visit"/>
            </xpath>
        </field>
    </record>

    <record id="of_sale_stock_order_dates_form_view" model="ir.ui.view">
        <field name="name">of.sale.stock.order.dates.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <!-- add div's name to xpath -->
            <xpath expr="//field[@name='commitment_date']/.." position="attributes">
                <attribute name="name">commitment_date_div</attribute>
            </xpath>

        </field>
    </record>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">of.sale.order.dates.sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="of_sale.of_sale_view_order_form"/>
        <field name="arch" type="xml">
            <!-- Informations de date déplacées dans la section date du formulaire -->
            <xpath expr="//group[@name='sale_shipping']//label[@for='commitment_date']" position="attributes">
                <attribute name="string">Delivery</attribute>
            </xpath>
            <xpath expr="//group[@name='date_details']" position="inside">
                <xpath expr="//group[@name='sale_shipping']//label[@for='commitment_date']" position="move"/>
                <xpath expr="//group[@name='sale_shipping']//div[hasclass('o_row')]" position="move"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_tree_quotation" model="ir.ui.view">
        <field name="name">sale.order.view.tree.quotation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="of_requested_week" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_tree_order" model="ir.ui.view">
        <field name="name">sale.order.view.tree.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="before">
                <field name="of_requested_week" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order Line Views -->

    <record id="view_order_line_tree" model="ir.ui.view">
        <field name="name">of.sale.order.dates.sale.order.line.tree.view</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_delivered']" position="before">
                <field name="of_order_requested_week"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_line_filter" model="ir.ui.view">
        <field name="name">of.sale.order.dates.sale.order.line.select</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='salesman_id']" position="after">
                <field name="of_order_requested_week"/>
            </xpath>
        </field>
    </record>

</odoo>
