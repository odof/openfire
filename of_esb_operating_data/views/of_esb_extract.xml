<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_esb_extract_form" model="ir.ui.view">
        <field name="name">of.esb.extract.form</field>
        <field name="model">of.esb.extract</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="uuid"/>
                    <field name="lines" context="{'create_auto_esb': True}">
                        <tree>
                            <field name="connection_id"/>
                            <field name="transform_id"/>
                        </tree>
                        <form>
                            <group>
                                <field name="connection_id" required="1"/>
                                <field name="type_data"/>
                                <field name="code" widget="ace" options="{'mode': 'python'}" attrs="{'invisible':[('type_data','!=','code')]}"/>
                                <field name="data" widget="ace" options="{'mode': 'python'}" attrs="{'invisible':[('type_data','!=','data')]}"/>
                                <field name="example" readonly="1" attrs="{'invisible':[('type_data','!=','data')]}"/>
                                <field name="transform_id"/>
                            </group>
                        </form>
                    </field>
                </group>
            </form>
        </field>
    </record>

    <record id="of_esb_extract_tree" model="ir.ui.view">
        <field name="name">of.esb.extract.tree</field>
        <field name="model">of.esb.extract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="uuid"/>
            </tree>
        </field>
    </record>

    <record id="action_of_esb_extract" model="ir.actions.act_window">
        <field name="name">Extract</field>
        <field name="res_model">of.esb.extract</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
