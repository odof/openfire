<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_of_esb_export_form" model="ir.ui.view">
        <field name="name">of.esb.export.wizard.form</field>
        <field name="model">of.esb.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="trigger_id"/>
                </group>
                <footer>
                    <button name="action_button_export_json" type="object" string="Export JSON" class="oe_highlight"/>
                    or
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="of_esb_export_wizard_action" model="ir.actions.act_window">
        <field name="name">Export JSON</field>
        <field name="res_model">of.esb.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="wizard_of_esb_export_form"/>
    </record>

</odoo>
