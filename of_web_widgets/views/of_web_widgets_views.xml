<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_view_users_form" model="ir.ui.view">
        <field name="name">of.res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form//notebook" position="inside">
                <page name="tests_web_widgets" string="Tests Web Widgets">
                    <group>
                        <group string="Widget color_index" name="widget_color_index">
                            <field name="int_test" widget="color_index"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>