<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="of_equipment_link_create_form_view" model="ir.ui.view">
        <field name="name">of.equipment.link.create.wizard.form.view</field>
        <field name="model">of.equipment.link.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Equipments">
                <field name="event_id" invisible="1"/>
                <field name="partner_id" invisible="1"/>
                <field name="address_id" invisible="1"/>
                <div class="alert alert-info" role="alert" name="alert_event" attrs="{'invisible':[('event_id', '=', False)]}">
                    Select the Equipments to add to the event.
                </div>
                <field name="equipment_ids_domain" invisible="1"/>
                <field name="equipment_ids" options="{'no_create': 1}"/>
                <footer>
                    <button name="action_button_select_equipments" string="Add Equipments" type="object" class="oe_highlight" attrs="{'invisible': [('equipment_ids', '=', [])]}" />
                    <button string="Close" class="oe_link" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_add_equipments_to_event" model="ir.actions.act_window">
        <field name="name">Add Equipments</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">of.equipment.link.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="of_equipment.of_equipment_link_create_form_view" />
        <field name="target">new</field>
    </record>

</odoo>
