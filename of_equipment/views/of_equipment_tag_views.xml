<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_equipment_tag_view_tree" model="ir.ui.view">
        <field name="name">of.equipment.tag.view.tree</field>
        <field name="model">of.equipment.tag</field>
        <field name="arch" type="xml">
            <tree editable="bottom" string="Tag list">
                <field name="sequence" widget="handle" />
                <field name="name" required="1"/>
                <field name="active" invisible="1" />
                <field name="color" widget="color_picker"/>

            </tree>
        </field>
    </record>

    <record id="of_equipment_tag_view_search" model="ir.ui.view">
        <field name="name">of.equipment.tag.view.search</field>
        <field name="model">of.equipment.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <separator />
                <filter string="Active" name="active" domain="[('active','=',True)]" />
                <filter string="Archived" name="inactive" domain="[('active','=',False)]" />
            </search>
        </field>
    </record>

    <record id="action_of_equipment_tag" model="ir.actions.act_window">
        <field name="name">Étiquettes d'équipement</field>
        <field name="res_model">of.equipment.tag</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="of_equipment_tag_view_tree" />
        <field name="search_view_id" ref="of_equipment_tag_view_search" />
    </record>

</odoo>
