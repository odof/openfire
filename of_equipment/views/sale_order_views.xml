<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.view.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_button_view_equipment" type="object" icon="fa-home" attrs="{'invisible': [('of_equipments_count', '=', 0)]}">
                    <field name="of_equipments_count" string="Equipments" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='sale_reporting']" position="inside">
                <separator string="Installed product" colspan="2"/>
                <field name="of_equipment_ids" widget="many2many_tags"/>
                <field name="of_equipment_id" attrs="{'invisible': [('of_equipments_count', '!=', 1)]}"/>
                <field name="of_equipment_address_id" attrs="{'invisible': [('of_equipments_count', '!=', 1)]}"/>
                <field name="of_equipment_date" attrs="{'invisible': [('of_equipments_count', '!=', 1)]}"/>
                <field name="of_equipment_note" attrs="{'invisible': [('of_equipments_count', '!=', 1)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
