<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="account_move_view_form" model="ir.ui.view">
        <field name="name">account.move.view.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_button_view_equipment" type="object" icon="fa-home" attrs="{'invisible': [('of_equipments_count', '=', 0)]}">
                    <field name="of_equipments_count" string="Equipments" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
