<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="of_planning_intervention_template_mixin_view_form" model="ir.ui.view">
        <field name="name">of.planning.intervention.template.mixin.view.form</field>
        <field name="model">of.planning.intervention.template.mixin</field>
        <field name="inherit_id" ref="of_planning.of_planning_intervention_template_mixin_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='report_second']" position="inside">
                <field name="report_equipment" string="EQUIPMENT" attrs="{'readonly':[('report_use_default','=',True)]}"/>
                <field name="report_equipment_name" string="Serial Number" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_product_id" string="Product" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_model" string="Model" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_brand_id" string="Brand" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_product_category_id" string="Category" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_installation_date" string="Installation Date" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_installation_type" string="Installation Type" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_is_compliant" string="Compliant" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_installer_id" string="Installer" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
                <field name="report_equipment_note" string="Note" attrs="{'readonly':['|', ('report_use_default','=',True), ('report_equipment', '=', False)]}"/>
            </xpath>
        </field>
    </record>

</odoo>
