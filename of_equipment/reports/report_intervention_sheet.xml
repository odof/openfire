<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_intervention_sheet_document" inherit_id="of_planning.report_intervention_sheet_document">

        <!-- Equipment History -->
        <xpath expr="//div[@name='sheet_history']" position="after">
            <div t-if="template.sheet_history and doc.of_history_equipment_ids" class="row mb-4" name="sheet_equipment_history" style="page-break-inside: avoid;">
                <div class="col">
                    <h5 name="title_equipment_history">
                        <strong>Equipment History</strong>
                    </h5>
                    <table class="table table-condensed border" name="equipment_history">
                        <thead>
                            <tr>
                                <th scope="col">Date</th>
                                <th class="text-center">Task</th>
                                <th class="text-center">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.of_history_equipment_ids" t-as="intervention">
                                <tr>
                                    <td>
                                        <span t-field="intervention.start" />
                                    </td>
                                    <td class="text-center">
                                        <span t-field="intervention.of_task_id.name" />
                                    </td>
                                    <td class="text-center">
                                        <span t-field="intervention.description" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>

        <!-- Equipment -->
        <xpath expr="//div[@name='sheet_intervention']" position="after">
            <div t-if="template.sheet_equipment" class="row mb-4" name="sheet_equipment" style="page-break-inside: avoid;">
                <div t-if="doc.of_use_equipment" class="col">
                    <t t-set="equipment_links_merged" t-value="doc._report_get_equipment_links_print_mode_merged()"/>
                    <t t-foreach="equipment_links_merged" t-as="equipment_lnk">
                        <!--
                            Equipment configuration will depend on the `template` var.
                            At this point `template` will be the `of.planning.intervention.template` linked Event/Service request.
                            So report configuration used when we are printing an "Intervention sheet" is that one on the Intervention Template.
                        -->
                        <t t-call="of_equipment.report_equipment_link_template">
                            <t t-set="link" t-value="equipment_lnk"/>
                        </t>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
