<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_intervention_report_document" inherit_id="of_planning.report_intervention_report_document">

        <!-- Equipment History -->
        <xpath expr="//div[@name='report_history']" position="after">
            <div t-if="template.report_history and doc.of_history_equipment_ids"
                class="row mb-4" name="report_equipment_history"
                style="page-break-inside: avoid;">
                <div class="col">
                    <h5 name="title_equipment_history">
                        <strong>Equipment History</strong>
                    </h5>
                    <table class="table table-condensed border" name="equipment_history">
                        <thead>
                            <tr>
                                <th scope="col">Date</th>
                                <th class="text-center">Task</th>
                                <th class="text-center">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="doc.of_history_equipment_ids" t-as="history">
                                <tr>
                                    <td>
                                        <span t-field="history.start" />
                                    </td>
                                    <td class="text-center">
                                        <span t-field="history.of_task_id.name" />
                                    </td>
                                    <td class="text-center">
                                        <span t-field="history.description" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>

        <!-- Equipment -->
        <xpath expr="//t[@t-call='of_planning.report_event_information_template']" position="after">
            <div t-if="template.report_equipment" class="row mb-4" name="report_equipment" style="page-break-inside: avoid;">
                <div t-if="doc.of_use_equipment" class="col">
                    <t t-set="equipment_links_merged" t-value="doc._report_get_equipment_links_print_mode_merged()"/>
                    <t t-foreach="equipment_links_merged" t-as="equipment_lnk">
                        <t t-call="of_equipment.report_equipment_link_template">
                            <t t-set="link" t-value="equipment_lnk"/>
                            <t t-set="template" t-value="equipment_lnk.equipment_report_tmpl_id or template"/>
                        </t>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
