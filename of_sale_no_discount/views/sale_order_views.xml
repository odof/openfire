<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="of_sale_no_discount_view_order_form" model="ir.ui.view">
        <field name="name">of.sale.order.no.discount.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="of_sale_discount.of_sale_discount_view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="after">
                <field name="of_product_forbidden_discount" invisible="1"/>
                <!-- Duplicate field because the visibility is driven by the group assignation and the same field is used for attrs -->
                <field name="of_product_forbidden_discount" optional="hide" groups="sales_team.group_sale_manager"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="after">
                <field name="of_is_price_unit_readonly" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='price_unit']" position="attributes">
                <attribute name="attrs">{'readonly': [('of_is_price_unit_readonly', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//tree//field[@name='of_discount_formula']" position="attributes">
                <attribute name="attrs">{'invisible': [('of_product_forbidden_discount', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/form//field[@name='price_unit']" position="replace">
                <label for="price_unit"/>
                <div name="price_unit">
                    <!-- Form view is in readonly mode, thats why we dont add the readonly attribute -->
                    <field name="price_unit" class="oe_inline" style="max-width: 150px;"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>