<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_map" model="ir.ui.view">
        <field name="name">res.partner</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <map form_view_id="%(base.view_partner_form)d" tooltip_view="of_map_view_partner.tooltipRenderer" latitude="partner_latitude" longitude="partner_longitude">
                <field name="name"/>
                <field name="city"/>
                <field name="zip"/>
                <field name="phone"/>
                <field name="mobile"/>
                <field name="of_precision"/>
                <field name="of_partner_phones"/>
            </map>
        </field>
    </record>

    <record id="contacts.action_contacts" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form,activity,map</field>
    </record>

</odoo>
