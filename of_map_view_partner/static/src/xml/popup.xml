<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="of_map_view.PopupMap" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[@id='popup-content']" position="inside">
            <t t-if="model == 'res.partner'">
                <t t-if="props.record.name">
                    <i class="fa fa-user pe-1"/><strong t-esc="props.record.name"/><br/>
                </t>
                <t t-if="props.record.zip or props.record.city">
                    <i class="fa fa-map-marker pe-1"/><span t-if="props.record.zip" t-esc="props.record.zip"/> <span t-if="props.record.city" t-esc="props.record.city"/><br/>
                </t>
                <t t-if="props.record.of_partner_phones">
                    <i class="fa fa-phone pe-1"/><span t-esc="props.record.of_partner_phones"/><br/>
                </t>
                <t t-if="props.record.mobile">
                    <i class="fa fa-phone pe-1"/><span t-esc="props.record.mobile"/><br/>
                </t>
            </t>
        </xpath>
    </t>

</templates>
