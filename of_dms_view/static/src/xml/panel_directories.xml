<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="of_dms_view.PanelDirectories" owl="1">
        <div class="panel-directories col-4" t-ref="panel-directories">
            <div class="panel-directories-header p-2">
                <form class="form-inline">

                    <div class="input-group">
                        <t t-if="state.isPartnerDirectory">
                            <button class="btn btn-link btn-upload-file" t-on-click.stop.prevent="click_upload_file"><i class="fa fa-download" title="Download"/></button>
                        </t>
                        <input type="text" class="form-control" id="search_directories"/>
                        <div class="input-group-append">
                            <button class="btn btn-primary" t-on-click.stop.prevent="search_directories">Search</button>
                        </div>
                    </div>

                </form>
            </div>
            <div class="panel-directories-content p-2 me-1">
                <t t-call="of_dms_view.directories">
                    <t t-set="records" t-value="props.records"/>
                    <t t-set="direct_files" t-value="props.direct_files"/>
                </t>
            </div>
        </div>
    </t>

    <t t-name="of_dms_view.directories" owl="1">
        <ul class="list-group d-block">
            <t t-foreach="records" t-as="record" t-key="record.id">
                <li t-on-click.stop="() => this.click_directory(record)" t-attf-class="caret {{this.currentDirectory.id == record.id and 'active' or ''}} py-1 o_cursor_pointer border-0 o_treeEntry ps-4 pe-0">
                    <header class="list-group-item-action d-flex align-items-center p-1 border-0" >
                        <i t-if="state.expanded[record.id]" t-attf-class="fa fa-minus-square-o me-2" title="Minus Square" onclick="event.stopPropagation()" t-on-click.stop="() => this.close_directory(record)"/>
                        <i t-else="" t-attf-class="fa fa-plus-square-o me-2" title="Plus Square" onclick="event.stopPropagation()" t-on-click.stop="() => this.open_directory(record)"/>
                        <i t-attf-class="fa {{state.expanded[record.id] and 'fa-folder-open-o' or 'fa-folder-o'}} me-2" title="Folder"/>
                        <span t-esc="record.name" t-attf-class="{{state.searchDirectories.includes(record.id) and 'searched' or ''}}"/>
                        <span class="badge text-bg-primary ms-2">
                            <t t-esc="record.count_total_files"/>
                        </span>
                    </header>

                    <t t-if="record.childs and state.expanded[record.id]">
                        <t t-call="of_dms_view.directories">
                            <t t-set="records" t-value="record.childs"/>
                        </t>
                    </t>
                </li>
            </t>
        </ul>
    </t>

</templates>
