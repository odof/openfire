<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action report pour permettre d'ajouter la page à tous les documents Yousign -->

    <record id="action_sale_order_electronic_signature_report" model="ir.actions.report">
        <field name="name">Sale Order page for electronic signature</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">of_yousign_connector.sale_order_electronic_signature_report</field>
        <field name="report_file">of_yousign_connector.sale_order_electronic_signature_report</field>
        <!-- <field name="print_report_name">(object._get_report_base_filename())</field> -->
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro" />
    </record>

    <!-- Template pour Yousign -->
    <template id="sale_order_electronic_signature_report">
        <!-- Créer une page vide avec l'en-tête externe-->
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="of_yousign_connector.sale_order_electronic_signature_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="sale_order_electronic_signature_document" inherit_id="sale.report_saleorder_document" primary="True" priority="100">
        <xpath expr="//div[@class='page']" position="inside">
            <p style="page-break-before:always; color: transparent;">no_blank_page</p>
            <div name="signatures" class="row">
                <div name="customer_signature" style="page-break-inside: avoid; max-width: 50%; padding: 0px 16px;">
                    <div class="encart_signature_titre h4 mb4">
                        <div>
                            <strong>Signature du client</strong>
                        </div>
                    </div>
                    <div class="encart_signature" style="border: 1px solid lightgray; border-top: 2px solid black; height: 130px; max-height: 130px; overflow: hidden;">
                        <!-- Signature client -->
                    </div>
                </div>
                <div name="vendor_signature" style="page-break-inside: avoid; max-width: 50%; padding: 0px 16px;">
                    <div class="encart_signature_titre h4 mb4">
                        <div>
                            <strong>Signature du vendeur</strong>
                        </div>
                    </div>
                    <div class="encart_signature" style="border: 1px solid lightgray; border-top: 2px solid black; height: 130px; max-height: 130px; overflow: hidden;">
                        <!-- Signature vendeur -->
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Retirer l'impression de la liste -->
    <!-- <function model="ir.actions.report.xml" name="unlink_action" eval="[[ref('yousign_sale.yousign_sale_layout_external_layout_report')]]"/> -->

</odoo>
