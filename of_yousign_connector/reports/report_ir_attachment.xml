<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action report -->
    <!-- <report id="yousign_attachment_blank_page_report"
            string="Attachment blank page for electronic signature"
            model="ir.attachment"
            report_type="qweb-pdf"
            file="yousign_connector.yousign_attachment_blank_page_template"
            name="yousign_connector.yousign_attachment_blank_page_template"
            paperformat="report.paperformat_euro">
    </report> -->

    <record id="action_attachment_blank_page_report" model="ir.actions.report">
        <field name="name">Attachment blank page for electronic signature</field>
        <field name="model">ir.attachment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">of_yousign_connector.yousign_attachment_blank_page_report</field>
        <field name="report_file">of_yousign_connector.yousign_attachment_blank_page_report</field>
        <!-- <field name="print_report_name">(object._get_report_base_filename())</field> -->
        <field name="binding_model_id" ref="base.model_ir_attachment" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro" />
    </record>

        <template id="yousign_attachment_blank_page_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="of_yousign_connector.yousign_attachment_blank_page_document" t-lang="env.user.partner_id.lang" />
            </t>
        </t>
    </template>

    <!-- Template pour Yousign -->
    <template id="yousign_attachment_blank_page_document">
        <div class="header">
            <div class="row">
                <div class="h3 col-xs-12 text-center">
                    Signature électronique
                </div>
            </div>
        </div>
        <div class="page">
            <div class="oe_structure"/>
            <div class="col-xs-12">
                <span t-raw="'Nom du document : ' + docs._context.get('of_doc_name')"/>
                <br/>
                <span t-raw="'Nombre de pages : ' + docs._context.get('of_doc_page_nb')"/>
            </div>
            <div class="oe_structure"/>
        </div>
    </template>

    <!-- Retirer l'impression de la liste -->
    <function model="ir.actions.report" name="unlink_action" eval="[[ref('of_yousign_connector.action_attachment_blank_page_report')]]"/>

</odoo>
