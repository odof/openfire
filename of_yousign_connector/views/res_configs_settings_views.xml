<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="of_connector_base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='connector_base_settings']" position="inside">
                <h2>YouSign</h2>
                <div class="row mt16 o_settings_container" id="of_yousign_settings">
                    <div class="col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label string="Configuration of your YouSign environment" for="of_yousign_environment"/>
                            <div class="content-group mt16">
                                <label for="of_yousign_environment"/>
                                <field name="of_yousign_environment" class="oe_inline" />
                            </div>
                            <div class="content-group">
                                <label for="of_yousign_sms_otp_content"/>
                                <field name="of_yousign_sms_otp_content" class="oe_inline" />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
