<odoo>

    <record id="of_yousign_request_template_form" model="ir.ui.view">
        <field name="model">of.yousign.request.template</field>
        <field name="arch" type="xml">
            <form string="Yousign Request Template">
                <sheet>
                    <div class="oe_right oe_button_box" name="buttons">
                    </div>
                    <group name="main">
                        <field name="name"/>
                        <field name="model_id"/>
                        <field name="model" invisible="1"/>
                        <field name="ordered"/>
                        <field name="lang"/>
                        <field name="report_ids" domain="[('model','=', model)]" widget="many2many_tags"/>
                        <field name="has_automatic_reminder"/>
                        <!-- <field name="of_experience_id" options="{'no_create': True}"/> -->
                        <field name="creator"/>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <!-- <group name="signatories" string="Signatories">
                        <field name="signatory_ids" nolabel="1"/>
                    </group> -->
                    <notebook>
                        <page name="init_mail" string="Init E-mail" invisible="1">
                            <group name="init_mail">
                                <field name="init_mail_subject" string="Subject"/>
                                <field name="init_mail_body" string="Body"/>
                            </group>
                        </page>
                        <page name="remind" string="Auto-Remind Setup" attrs="{'invisible': [('has_automatic_reminder', '=', False)]}">
                            <group name="remind">
                                <label for="remind_interval"/>
                                <div name="remind_interval">
                                    <field name="remind_interval" class="oe_inline"/> days
                                </div>
                                <field name="remind_limit"/>
                                <field name="remind_mail_subject" invisible="1"/>
                                <field name="remind_mail_body" invisible="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="of_yousign_request_template_tree" model="ir.ui.view">
        <field name="model">of.yousign.request.template</field>
        <field name="arch" type="xml">
            <tree string="Yousign Request Templates">
                <field name="name"/>
                <field name="model_id"/>
                <field name="init_mail_subject"/>
            </tree>
        </field>
    </record>

    <record id="of_yousign_request_template_search" model="ir.ui.view">
        <field name="model">of.yousign.request.template</field>
        <field name="arch" type="xml">
            <search string="Search Yousign Request Templates">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('init_mail_subject', 'ilike', self)]" string="Name or Mail Subject"/>
                <group string="Group By" name="groupby">
                    <filter name="object_groupby" string="Object" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>


